---
import ArrowUpRight from './ArrowUpRight.astro';
import { getTournament } from '../data/tournaments';
import TournamentBracket from './TournamentBracket.astro';
import LolRoster from './LolRoster.astro';

interface Props {
  activityId: string;
}
const { activityId } = Astro.props;
const tournament = getTournament(activityId);
---

{
  tournament && (
    <section
      id="emparejamientos"
      class="matchups"
      aria-labelledby="matchups-title"
      data-matchups
    >
      <header class="matchups-header">
        <div>
          <span class="design-eyebrow">El cuadro de la partida · 2026</span>
          <h2 id="matchups-title">
            {tournament.brackets.length ||
            tournament.groups.some((group) => group.matches.length)
              ? 'Emparejamientos.'
              : tournament.tables.length
                ? 'Resultados.'
                : 'El torneo.'}
          </h2>
        </div>
        <span class="matchups-format">{tournament.format}</span>
      </header>
      <ol class="tournament-stages" aria-label="Formato del torneo">
        {tournament.stages.map((stage, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {stage}
          </li>
        ))}
      </ol>
      <p class="matchups-notice">{tournament.notice}</p>
      {tournament.officialUrl && (
        <a
          class="design-button official-bracket"
          href={tournament.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver cuadro oficial{' '}
          <span aria-hidden="true">
            <ArrowUpRight />
          </span>
        </a>
      )}
      {tournament.brackets.map((bracket, index) => (
        <TournamentBracket bracket={bracket} expanded={index === 0} />
      ))}
      {tournament.groups.length > 0 && (
        <>
          <h3 class="matchups-subtitle">
            {activityId === 'minecraft' ? 'Equipos de UHC' : 'Fase de grupos'}
          </h3>
          <div class="matchups-groups">
            {tournament.groups.map((group, index) => (
              <article class="matchup-group" aria-labelledby={group.id}>
                <header>
                  <h4 id={group.id}>{group.name}</h4>
                  <span class="group-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </header>
                {group.time && (
                  <p class="group-time">
                    Inicio previsto · <time>{group.time}</time>
                  </p>
                )}
                {group.matches.length > 0 ? (
                  <ol
                    class="group-matches"
                    aria-label={`Cruces de ${group.name}`}
                  >
                    {group.matches.map((match) => (
                      <li class="match-card">
                        <span class="match-player">{match.players[0]}</span>
                        <span class="match-versus" aria-label="contra">
                          VS
                        </span>
                        <span class="match-player">{match.players[1]}</span>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <ul class="uhc-players">
                    {group.participants.map((alias) => (
                      <li>
                        <span aria-hidden="true">↳</span>
                        {alias}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </>
      )}
      {tournament.tables.length > 0 && (
        <div class="tournament-results">
          {tournament.tables.map((table) => (
            <details
              class="tournament-table"
              open={tournament.tables.length === 1}
            >
              <summary>
                {table.name}
                <span aria-hidden="true">+</span>
              </summary>
              <div
                class="tournament-table-scroll"
                tabindex="0"
                role="region"
                aria-label={table.name}
              >
                <table>
                  <caption class="sr-only">
                    {table.name} · ULP 2026. Guion: resultado sin registrar.
                  </caption>
                  <thead>
                    <tr>
                      {table.columns.map((label) => (
                        <th scope="col">{label}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map((row) => (
                      <tr>
                        {row.map((cell, index) =>
                          index === 0 ? (
                            <th scope="row">{cell}</th>
                          ) : (
                            <td>{cell ?? '—'}</td>
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))}
        </div>
      )}
      {tournament.participants.length > 0 && (
        <details class="tournament-roster">
          <summary>
            {tournament.participantLabel}
            <span aria-hidden="true">+</span>
          </summary>
          <p>
            Lista de inscripciones; no determina los cruces ni confirma la
            asistencia.
          </p>
          <ul>
            {tournament.participants.map((alias) => (
              <li>{alias}</li>
            ))}
          </ul>
          {activityId === 'league-of-legends' && <LolRoster />}
        </details>
      )}
    </section>
  )
}

<style>
  .matchups {
    padding-block: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--line);
    color: var(--ink);
    scroll-margin-top: 110px;
  }
  .matchups-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  h2 {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.1;
    margin-top: 13px;
  }
  .matchups-format {
    border: 1px solid var(--line);
    border-radius: 30px;
    padding: 10px 15px;
    font-size: 11px;
  }
  .tournament-stages {
    display: flex;
    gap: 26px;
    overflow-x: auto;
    padding-block: 28px 18px;
    scrollbar-width: thin;
  }
  .tournament-stages li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    font-size: 11px;
  }
  .tournament-stages li + li::before {
    content: '→';
    color: var(--muted);
    position: absolute;
    left: -20px;
  }
  .tournament-stages li > span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 50%;
    font:
      9px ui-monospace,
      monospace;
  }
  .matchups-notice {
    max-width: 80ch;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
    margin-top: 6px;
  }
  .matchups-subtitle {
    font-size: 19px;
    font-weight: 650;
    margin-block: 32px 18px;
  }
  .matchups-groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .matchup-group {
    position: relative;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px 14px 14px;
    background:
      radial-gradient(
        ellipse at top right,
        color-mix(in srgb, var(--ink) 6%, transparent),
        transparent 70%
      ),
      var(--surface);
    transition:
      transform 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .matchup-group:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--ink) 45%, transparent);
    box-shadow: 0 12px 30px color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .matchup-group header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  h4 {
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .group-index {
    font:
      italic 31px/1 Georgia,
      serif;
    opacity: 0.22;
  }
  .group-time {
    color: var(--muted);
    font:
      9px/1.6 ui-monospace,
      monospace;
    margin-bottom: 14px;
  }
  .group-matches {
    display: grid;
    gap: 9px;
  }
  .match-card {
    position: relative;
    display: grid;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    padding: 12px 14px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .match-card:hover {
    border-color: var(--ink);
    transform: translateX(3px);
  }
  .match-player {
    overflow-wrap: anywhere;
    font-size: 12px;
    font-weight: 550;
  }
  .match-versus {
    font:
      8px/1.2 ui-monospace,
      monospace;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .uhc-players {
    display: grid;
    gap: 12px;
    font-size: 12px;
    padding-block: 8px;
  }
  .uhc-players li {
    overflow-wrap: anywhere;
    display: flex;
    gap: 12px;
  }
  .uhc-players span {
    opacity: 0.4;
  }
  .official-bracket {
    margin-top: 20px;
  }
  .tournament-results {
    margin-top: 28px;
  }
  .tournament-table,
  .tournament-roster {
    border-top: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 20px;
    list-style: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary > span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 17px;
    font-weight: 400;
    transition: transform 0.2s;
  }
  details[open] > summary > span {
    transform: rotate(45deg);
  }
  .tournament-table-scroll {
    overflow-x: auto;
    margin-bottom: 24px;
  }
  table {
    width: 100%;
    min-width: 290px;
    text-align: left;
    border-collapse: collapse;
    font-size: 12px;
  }
  th,
  td {
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
  }
  thead th {
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
  }
  tbody th {
    font-weight: 550;
    overflow-wrap: anywhere;
  }
  td {
    font-variant-numeric: tabular-nums;
  }
  tbody tr:nth-child(odd) {
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  tbody tr:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .tournament-roster {
    margin-top: 28px;
  }
  .tournament-roster p {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 18px;
  }
  .tournament-roster ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 24px;
  }
  .tournament-roster li {
    max-width: 100%;
    overflow-wrap: anywhere;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 8px 11px;
    font-size: 11px;
  }
  summary:focus-visible,
  a:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  @media (max-width: 1100px) {
    .matchups-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 500px) {
    .matchups-groups {
      grid-template-columns: 1fr;
    }
    .match-card {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 12px;
    }
    .match-player:last-child {
      text-align: right;
    }
    th,
    td {
      padding: 12px 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
