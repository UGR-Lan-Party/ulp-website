---
import type { SponsorData } from '../data/sponsors';
import logoLayouts from '../data/partner-logo-layout.json';
import normalizedLogos from '../data/normalized-partner-logos.json';
interface Props {
  partner: SponsorData;
  surface?: 'theme' | 'light' | 'dark';
  width?: number;
  height?: number;
  decorative?: boolean;
}
const {
  partner,
  surface = 'theme',
  width = 130,
  height = 32,
  decorative = false,
} = Astro.props;
const normalized =
  normalizedLogos[partner.name.trim() as keyof typeof normalizedLogos];
const colorLogo = normalized?.color ?? partner.logo;
const whiteLogo = normalized?.white ?? partner.logoWhite;
const layout = normalized
  ? undefined
  : logoLayouts[partner.name.trim() as keyof typeof logoLayouts];
const layoutStyle = layout
  ? `--logo-aspect:${layout.aspect};--logo-image-width:${layout.imageWidth}%;--logo-image-height:${layout.imageHeight}%;--logo-left:${layout.left}%;--logo-top:${layout.top}%`
  : undefined;
---

<span
  class:list={[
    'partner-logo-frame',
    {
      'roomy-logo': partner.name.trim() === 'UGR',
      'mars-logo': partner.name.trim() === 'Mars Gaming',
    },
  ]}
  style={`--default-logo-width:${width}px;--default-logo-height:${height}px`}
>
  <span
    class:list={['partner-logo-content', { normalized: Boolean(layout) }]}
    style={layoutStyle}
  >
    <img
      src={colorLogo}
      alt={decorative ? '' : `Logotipo de ${partner.name.trim()}`}
      title={partner.name.trim() === 'DEFC'
        ? 'DEFC · Jesusjmma · CC BY-SA 4.0 · Wikimedia Commons'
        : undefined}
      width={width}
      height={height}
      loading="eager"
      data-partner-logo={partner.name.trim()}
      data-surface={surface}
      style={!normalized && partner.logoWhiteFilter
        ? `--logo-dark-filter:url(#${partner.logoWhiteFilter})`
        : undefined}
      class:list={[
        'partner-logo',
        {
          'needs-contrast': !normalized && partner.logoNeedsContrast,
          'white-details': !normalized && partner.logoWhiteDetails,
          'has-white-variant': Boolean(whiteLogo),
        },
      ]}
    />
    {
      whiteLogo && (
        <img
          src={whiteLogo}
          alt={decorative ? '' : `Logotipo de ${partner.name.trim()}`}
          width={width}
          height={height}
          loading="eager"
          data-partner-white-logo={partner.name.trim()}
          data-surface={surface}
          class="partner-logo white-variant"
        />
      )
    }
  </span>
</span>
<style>
  .partner-logo-frame {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: var(--default-logo-width);
    height: var(--partner-logo-height, var(--default-logo-height));
    max-width: 100%;
  }
  .partner-logo-content {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .partner-logo-content.normalized {
    width: min(
      100%,
      calc(
        var(--partner-logo-height, var(--default-logo-height)) *
          var(--logo-aspect)
      )
    );
    height: auto;
    aspect-ratio: var(--logo-aspect);
  }
  .normalized .partner-logo {
    position: absolute;
    left: var(--logo-left);
    top: var(--logo-top);
    width: var(--logo-image-width);
    height: var(--logo-image-height);
    max-width: none;
  }
  .partner-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .needs-contrast[data-surface='light'],
  .needs-contrast[data-surface='theme'] {
    filter: brightness(0);
  }
  .white-details[data-surface='light'],
  .white-details[data-surface='theme'] {
    filter: url(#partner-white-details);
  }
  .partner-logo[data-partner-logo='DEFC'][data-surface='light'],
  :global(:root:not(.dark))
    .partner-logo[data-partner-logo='DEFC'][data-surface='theme'] {
    filter: url(#partner-color-cutout);
  }
  .partner-logo:not(.has-white-variant)[data-surface='dark'],
  :global(.dark) .partner-logo:not(.has-white-variant)[data-surface='theme'] {
    filter: var(--logo-dark-filter, brightness(0) invert(1));
  }
  .white-variant,
  .has-white-variant[data-surface='dark'],
  :global(.dark) .has-white-variant[data-surface='theme'] {
    display: none;
  }
  .white-variant[data-surface='dark'],
  :global(.dark) .white-variant[data-surface='theme'] {
    display: block;
    filter: var(--logo-dark-filter, none);
  }
  .white-variant[data-partner-white-logo='Mars Gaming'][data-surface='dark'],
  :global(.dark)
    .white-variant[data-partner-white-logo='Mars Gaming'][data-surface='theme'] {
    filter: brightness(0) invert(1);
  }
</style>
