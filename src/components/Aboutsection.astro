---
import ArrowUpRight from './ArrowUpRight.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import GranadaAccent from './GranadaAccent.astro';
---

<section id="about" class="design-section about-section">
  <GranadaAccent id="about-stars" />
  <div class="design-container about-grid">
    <div class="about-visual" data-reveal>
      <ResponsiveImage
        src="/assets/about/ulp-2025-retro.jpg"
        alt="Participantes de ULP compartiendo partidas en la zona de juegos retro"
        sizes="(max-width: 700px) 100vw, 45vw"
      /><span class="about-caption">GRANADA / UNIVERSIDAD / COMUNIDAD</span
      ><span class="about-stamp" aria-hidden="true"
        ><span class="stamp-mark">✦</span><span
          >HECHO EN<strong>LA ETSIIT</strong></span
        ></span
      >
    </div>
    <div class="about-copy" data-reveal>
      <span class="design-eyebrow">02 / Mucho más que competir</span><h2
        class="design-heading"
      >
        Lo que nos une<br /><em>no está solo<br />en el temario.</em>
      </h2><p>
        Somos estudiantes, antiguos estudiantes y profesores de la ETSIIT y de
        otras facultades de la Universidad de Granada. Nos une disfrutar
        jugando, creando y compartiendo, y hacemos de la ULP un lugar para
        encontrarnos.
      </p><p>
        Competiciones, charlas, retos y juego libre. Una comunidad con la que
        siempre apetece echar otra partida.
      </p><a class="design-link" href="/info/about"
        >Conoce a la comunidad <span aria-hidden="true"><ArrowUpRight /></span
        ></a
      >
    </div>
  </div>
</section>
<style>
  .about-section {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--surface);
  }
  .about-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 8vw, 110px);
    align-items: center;
  }
  .about-visual {
    position: relative;
    padding: 0 28px 35px 0;
  }
  .about-visual :global(img) {
    width: 100%;
    height: 570px;
    object-fit: cover;
    border-radius: 20px;
  }
  .about-caption {
    display: block;
    margin-top: 16px;
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.1em;
  }
  .about-stamp {
    position: absolute;
    bottom: 100px;
    right: 0;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 15px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--paper);
    color: var(--ink);
    font:
      7px/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.12em;
    transform: rotate(-3deg);
    box-shadow: 0 6px 18px rgb(0 68 101 / 0.12);
  }
  .stamp-mark {
    font-size: 24px;
    color: var(--accent);
  }
  .about-stamp strong {
    display: block;
    font-size: 11px;
    letter-spacing: 0.09em;
    margin-top: 3px;
  }
  .about-copy .design-eyebrow {
    margin-bottom: 25px;
  }
  .about-copy .design-heading {
    font-size: clamp(38px, 5vw, 67px);
    margin-bottom: 28px;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .about-copy > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.85;
    margin-bottom: 16px;
    max-width: 400px;
    text-align: justify;
    hyphens: auto;
  }
  .about-copy .design-link {
    margin-top: 14px;
  }
  @media (max-width: 700px) {
    .about-grid {
      position: relative;
      grid-template-columns: 1fr;
    }
    .about-visual :global(img) {
      height: 380px;
    }
    .about-copy .design-heading br:nth-child(2) {
      display: none;
    }
  }
</style>
