---
import { darkStyles } from '../utils/all';
import { getFlickrPhotos } from '../utils/flickr.js';

interface Props {
  albumId: string;
  userId: string;
  withBackground?: boolean;
  height?: string;
  instanceId?: string;
  unlimitedHeight?: boolean;
  featuredPhotoId?: string;
  centeredSlides?: boolean;
  shufflePhotos?: boolean;
}

const {
  albumId,
  userId,
  withBackground = true,
  height = '600px',
  featuredPhotoId,
  centeredSlides = false,
  shufflePhotos = false,
  instanceId = `carousel-${albumId}`,
} = Astro.props;
const photos: string[] = await getFlickrPhotos(albumId, userId);
const photoPreviews: string[] = centeredSlides
  ? await getFlickrPhotos(albumId, userId, { preview: true })
  : [];
const featuredIndex = featuredPhotoId
  ? photos.findIndex((source) =>
      new URL(source).pathname
        .split('/')
        .at(-1)
        ?.startsWith(`${featuredPhotoId}_`),
    )
  : -1;
const images =
  featuredIndex > 0
    ? [
        photos[featuredIndex],
        ...photos.filter((_, index) => index !== featuredIndex),
      ]
    : photos;
const previews =
  featuredIndex > 0
    ? [
        photoPreviews[featuredIndex],
        ...photoPreviews.filter((_, index) => index !== featuredIndex),
      ]
    : photoPreviews;
const albumUrl = `https://www.flickr.com/photos/${encodeURIComponent(userId)}/albums/${encodeURIComponent(albumId)}`;
const firstImage = images[0] ?? '/assets/about/sobre-nosotros.png';
---

<section
  class={withBackground ? `bg-gray-1 ${darkStyles} py-10` : 'bg-transparent'}
  id={instanceId}
  data-photo-carousel
  data-shuffle-photos={shufflePhotos || undefined}
  data-photos={JSON.stringify(images)}
  data-centered-slides={centeredSlides || undefined}
  data-previews={centeredSlides ? JSON.stringify(previews) : undefined}
  aria-label="Fotos de UGR LAN Party"
  aria-roledescription="carrusel"
>
  <div class="container px-4">
    <div
      data-carousel-stage
      class:list={['carousel-stage', { 'centered-slides': centeredSlides }]}
      hidden={!images.length}
      style={`--carousel-height: ${height}`}
    >
      {
        centeredSlides &&
          [-1, 1].map((offset) => (
            <button
              type="button"
              class:list={[
                'carousel-neighbor',
                offset < 0 ? 'neighbor-previous' : 'neighbor-next',
              ]}
              data-carousel-neighbor={offset}
              aria-label={
                offset < 0 ? 'Ver foto anterior' : 'Ver foto siguiente'
              }
              hidden={images.length < 2}
            >
              <img
                src={
                  previews[(offset + images.length) % images.length] ??
                  firstImage
                }
                alt=""
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))
      }
      <a
        data-carousel-zoom
        href={images[0] ?? albumUrl}
        aria-label="Ampliar foto 1"
        class="carousel-photo"
      >
        <img
          data-carousel-image
          src={firstImage}
          alt="Foto 1 de UGR LAN Party"
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
        />
        <span class="zoom-hint" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M9 3H3v6m12-6h6v6m0 6v6h-6m-6 0H3v-6"></path></svg
          >
        </span>
      </a>
      <button
        type="button"
        data-carousel-previous
        class="photo-control previous"
        aria-label="Foto anterior"
        hidden
        ><svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg
        ></button
      >
      <button
        type="button"
        data-carousel-next
        class="photo-control next"
        aria-label="Foto siguiente"
        hidden
        ><svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg
        ></button
      >
      <p data-carousel-counter class="photo-counter" aria-live="polite">
        Foto 1 de {images.length}
      </p>
    </div>
    <p
      data-carousel-empty
      role="status"
      hidden={Boolean(images.length)}
      class="py-8 text-center dark:text-white"
    >
      No se han podido cargar las fotos. Puedes consultarlas en el álbum de
      Flickr.
    </p>
    <p data-carousel-status class="carousel-status" role="status" hidden></p>
    <div class="album-action">
      <a
        href={albumUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="album-link bg-primary text-white hover:bg-tertiary focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-primary"
        >Ver álbum completo</a
      >
    </div>
  </div>
  <dialog data-carousel-dialog aria-label="Foto ampliada de UGR LAN Party">
    <img
      data-carousel-expanded
      src={firstImage}
      alt="Foto ampliada de UGR LAN Party"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <button
      type="button"
      data-carousel-close
      class="photo-control close"
      aria-label="Cerrar foto ampliada"
      autofocus
      ><svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg
      ></button
    >
    <button
      type="button"
      data-expanded-previous
      class="photo-control previous"
      aria-label="Foto anterior ampliada"
      hidden
      ><svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg
      ></button
    >
    <button
      type="button"
      data-expanded-next
      class="photo-control next"
      aria-label="Foto siguiente ampliada"
      hidden
      ><svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg
      ></button
    >
  </dialog>
</section>

<script>
  import '../scripts/photo-carousel';
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .carousel-stage.centered-slides {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 16px;
    width: 100%;
    aspect-ratio: auto;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .centered-slides .carousel-photo {
    grid-column: 2;
    grid-row: 1;
    aspect-ratio: 16 / 9;
    height: auto;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgb(0 35 55 / 0.12);
  }
  .centered-slides .carousel-photo img {
    object-fit: cover;
    object-position: center;
  }
  .carousel-neighbor {
    display: block;
    grid-row: 1;
    min-width: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    opacity: 0.42;
    filter: blur(1px) saturate(0.65);
    transform: scale(0.94);
    transition:
      opacity 220ms ease,
      filter 220ms ease;
    cursor: pointer;
  }
  .carousel-neighbor:hover,
  .carousel-neighbor:focus-visible {
    opacity: 0.7;
    filter: blur(0) saturate(0.85);
  }
  .carousel-neighbor:focus-visible {
    outline: 2px solid var(--ink, #004465);
    outline-offset: -3px;
  }
  .neighbor-previous {
    grid-column: 1;
  }
  .neighbor-next {
    grid-column: 3;
  }
  .carousel-neighbor img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .centered-slides .photo-counter {
    left: calc(33.333% + 18px);
  }
  .centered-slides .zoom-hint {
    right: calc(33.333% + 18px);
  }
  @media (max-width: 700px) {
    .carousel-stage.centered-slides {
      grid-template-columns: repeat(3, 70%);
      justify-content: center;
      gap: 10px;
    }
    .centered-slides .photo-counter {
      left: calc(15% + 8px);
      bottom: 10px;
      font-size: 10px;
      padding: 6px 9px;
    }
    .centered-slides .zoom-hint {
      right: calc(15% + 8px);
      bottom: 10px;
      width: 32px;
      height: 32px;
    }
    .centered-slides .photo-control {
      width: 36px;
      height: 36px;
      top: calc(50% - 18px);
    }
    .centered-slides .previous {
      left: 2px;
    }
    .centered-slides .next {
      right: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-neighbor {
      transition: none;
    }
  }
  .carousel-status {
    text-align: center;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
    margin-top: 16px;
  }
  .album-action {
    display: flex;
    justify-content: center;
    padding-top: 18px;
  }
  .album-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
  }
  .album-link::before {
    content: '';
    position: absolute;
    inset: -5px 0;
  }
  .carousel-stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: min(
      100%,
      calc(min(var(--carousel-height), 75svh) * var(--photo-ratio, 1.5))
    );
    aspect-ratio: var(--photo-ratio, 1.5);
    margin-inline: auto;
    border: 0;
    border-radius: 1.5rem;
    background: #0d2438;
    box-shadow: 0 16px 40px #0044651a;
  }
  .carousel-photo {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .carousel-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .photo-control {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #ffffff44;
    border-radius: 50%;
    background: #071b2dde;
    color: white;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .photo-control:hover {
    background: #006471;
    transform: scale(1.05);
  }
  .photo-control:focus-visible,
  .carousel-photo:focus-visible {
    outline: 3px solid #96c1d6;
    outline-offset: -5px;
  }
  .previous {
    left: 0.75rem;
    top: calc(50% - 24px);
  }
  .next {
    right: 0.75rem;
    top: calc(50% - 24px);
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .photo-counter,
  .zoom-hint {
    position: absolute;
    bottom: 0.8rem;
    border-radius: 999px;
    background: #071b2dde;
    color: white;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    pointer-events: none;
  }
  .photo-counter {
    left: 0.8rem;
  }
  .zoom-hint {
    right: 0.8rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 0.65rem;
  }
  dialog {
    width: min(
      calc(100vw - 2rem),
      calc((100svh - 2rem) * var(--photo-ratio, 1.5))
    );
    max-width: 1440px;
    height: auto;
    aspect-ratio: var(--photo-ratio, 1.5);
    max-height: calc(100svh - 2rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 1.5rem;
    background: transparent;
  }
  dialog::backdrop {
    background: #020b16e8;
    backdrop-filter: blur(8px);
  }
  dialog img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
