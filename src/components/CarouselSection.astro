---
import { darkStyles } from '../utils/all';
import { getFlickrPhotos } from '../utils/flickr.js';

interface Props {
  albumId: string;
  userId: string;
  withBackground?: boolean;
  height?: string;
  instanceId?: string;
  unlimitedHeight?: boolean;
}

const {
  albumId,
  userId,
  withBackground = true,
  height = '600px',
  instanceId = `carousel-${albumId}`,
  unlimitedHeight = false,
} = Astro.props;
const images: string[] = await getFlickrPhotos(albumId, userId);
const albumUrl = `https://www.flickr.com/photos/${encodeURIComponent(userId)}/albums/${encodeURIComponent(albumId)}`;
---

<section
  class={withBackground ? `bg-gray-1 ${darkStyles} py-10` : 'bg-transparent'}
  id={instanceId}
>
  <div class="container px-4">
    {
      images.length ? (
        <ul
          class="grid grid-cols-1 gap-4 overflow-y-auto sm:grid-cols-2 lg:grid-cols-3"
          style={unlimitedHeight ? undefined : `max-height: ${height}`}
          aria-label="Fotos de la edición"
        >
          {images.slice(0, 12).map((source, index) => (
            <li>
              <a
                href={source}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ampliar foto ${index + 1}`}
                class="block rounded focus-visible:outline focus-visible:outline-primary"
              >
                <img
                  src={source}
                  alt={`Foto ${index + 1} de UGR LAN Party`}
                  width="1024"
                  height="683"
                  loading="lazy"
                  decoding="async"
                  class="aspect-video w-full rounded object-cover"
                />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p role="status" class="py-8 text-center dark:text-white">
          No se han podido cargar las fotos. Puedes consultarlas en el álbum de
          Flickr.
        </p>
      )
    }
    <a
      href={albumUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-block rounded bg-primary px-5 py-3 text-white"
      >Ver el álbum completo en Flickr</a
    >
  </div>
</section>
