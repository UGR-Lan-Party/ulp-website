---
import { darkStyles } from '../utils/all';
import { getFlickrPhotos } from '../utils/flickr.js';

interface Props {
  albumId: string;
  userId: string;
  withBackground?: boolean;
  height?: string;
  instanceId?: string;
  unlimitedHeight?: boolean;
  featuredPhotoId?: string;
  centeredSlides?: boolean;
  shufflePhotos?: boolean;
}

const {
  albumId,
  userId,
  withBackground = true,
  height = '600px',
  featuredPhotoId,
  centeredSlides = false,
  shufflePhotos = false,
  instanceId = `carousel-${albumId}`,
} = Astro.props;
const photos: string[] = await getFlickrPhotos(albumId, userId);
const photoPreviews: string[] = await getFlickrPhotos(albumId, userId, {
  preview: true,
});
const featuredIndex = featuredPhotoId
  ? photos.findIndex((source) =>
      new URL(source).pathname
        .split('/')
        .at(-1)
        ?.startsWith(`${featuredPhotoId}_`),
    )
  : -1;
const images =
  featuredIndex > 0
    ? [
        photos[featuredIndex],
        ...photos.filter((_, index) => index !== featuredIndex),
      ]
    : photos;
const previews =
  featuredIndex > 0
    ? [
        photoPreviews[featuredIndex],
        ...photoPreviews.filter((_, index) => index !== featuredIndex),
      ]
    : photoPreviews;
const albumUrl = `https://www.flickr.com/photos/${encodeURIComponent(userId)}/albums/${encodeURIComponent(albumId)}`;
const firstImage =
  previews[0] ?? images[0] ?? '/assets/about/sobre-nosotros.png';
---

<section
  class={withBackground ? `bg-gray-1 ${darkStyles} py-10` : 'bg-transparent'}
  id={instanceId}
  data-photo-carousel
  data-shuffle-photos={shufflePhotos || undefined}
  data-photos={JSON.stringify(images)}
  data-centered-slides={centeredSlides || undefined}
  data-previews={JSON.stringify(previews)}
  aria-label="Fotos de UGR LAN Party"
  aria-roledescription="carrusel"
>
  <div class="container px-4">
    <div
      data-carousel-stage
      tabindex="0"
      role="group"
      aria-label="Galería de fotos; usa las flechas o la rueda para navegar"
      class:list={['carousel-stage', { 'centered-slides': centeredSlides }]}
      hidden={!images.length}
      style={`--carousel-height: ${height}`}
    >
      {
        centeredSlides &&
          [-3, -2, -1, 1, 2, 3].map((offset) => (
            <button
              type="button"
              class:list={[
                'carousel-neighbor',
                {
                  'neighbor-previous': offset === -1,
                  'neighbor-next': offset === 1,
                },
              ]}
              data-carousel-neighbor={offset}
              data-ribbon-offset={offset}
              style={`--ribbon-offset:${offset};--ribbon-turn:${offset * -7}deg;--ribbon-rise:${Math.abs(offset) * -6}px`}
              aria-label={
                offset === -1
                  ? 'Ver foto anterior'
                  : offset === 1
                    ? 'Ver foto siguiente'
                    : `Ver foto ${Math.abs(offset)} posiciones ${offset < 0 ? 'antes' : 'después'}`
              }
              hidden={images.length < 2}
            >
              <img
                src={
                  previews[
                    ((offset % images.length) + images.length) % images.length
                  ] ?? firstImage
                }
                alt=""
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))
      }
      <a
        data-carousel-zoom
        href={images[0] ?? albumUrl}
        aria-label="Ampliar foto 1"
        class="carousel-photo"
        data-ribbon-offset={centeredSlides ? 0 : undefined}
        style={centeredSlides
          ? '--ribbon-offset:0;--ribbon-turn:0deg;--ribbon-rise:0px'
          : undefined}
      >
        <img
          data-carousel-image
          src={firstImage}
          alt="Foto 1 de UGR LAN Party"
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
        />
        <span class="zoom-hint" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M9 3H3v6m12-6h6v6m0 6v6h-6m-6 0H3v-6"></path></svg
          >
        </span>
      </a>
      {
        !centeredSlides && (
          <>
            <button
              type="button"
              data-carousel-previous
              class="photo-control previous"
              aria-label="Foto anterior"
              hidden
            >
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m15 6-6 6 6 6" />
              </svg>
            </button>
            <button
              type="button"
              data-carousel-next
              class="photo-control next"
              aria-label="Foto siguiente"
              hidden
            >
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m9 6 6 6-6 6" />
              </svg>
            </button>
          </>
        )
      }
      <p
        data-carousel-counter
        class:list={['photo-counter', { 'ribbon-counter': centeredSlides }]}
        aria-live="polite"
      >
        Foto 1 de {images.length}
      </p>
    </div>
    <p
      data-carousel-empty
      role="status"
      hidden={Boolean(images.length)}
      class="py-8 text-center dark:text-white"
    >
      No se han podido cargar las fotos. Puedes consultarlas en el álbum de
      Flickr.
    </p>
    <p data-carousel-status class="carousel-status" role="status" hidden></p>
    <button type="button" class="carousel-retry" data-carousel-retry hidden
      >Reintentar foto</button
    >
    <div class="album-action">
      <a
        href={albumUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="album-link bg-primary text-white hover:bg-tertiary focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-primary"
        >Ver álbum completo</a
      >
    </div>
  </div>
  <dialog data-carousel-dialog aria-label="Foto ampliada de UGR LAN Party">
    <div class="expanded-heading">
      <span class="expanded-brand">ULP <span>/ ARCHIVO ABIERTO</span></span><a
        data-carousel-original
        href={images[0] ?? albumUrl}
        target="_blank"
        rel="noopener noreferrer"
        >Ver original <span aria-hidden="true">↗</span></a
      >
    </div>
    <img
      data-carousel-expanded
      src={firstImage}
      alt="Foto ampliada de UGR LAN Party"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <button
      type="button"
      data-carousel-close
      class="photo-control close"
      aria-label="Cerrar foto ampliada"
      autofocus
      ><svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg
      ></button
    >
    <div class="expanded-navigation">
      <button
        type="button"
        data-expanded-previous
        class="photo-control previous"
        aria-label="Foto anterior ampliada"
        hidden
        ><svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg
        ><span class="expanded-button-label">Anterior</span></button
      >
      <span data-expanded-counter class="expanded-counter" aria-live="polite"
        >Foto 1 de {images.length}</span
      >
      <button
        type="button"
        data-expanded-next
        class="photo-control next"
        aria-label="Foto siguiente ampliada"
        hidden
        ><svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg
        ><span class="expanded-button-label">Siguiente</span></button
      >
    </div>
  </dialog>
</section>

<script>
  import '../scripts/photo-carousel';
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .carousel-stage.centered-slides {
    container-type: inline-size;
    --ribbon-width: clamp(140px, 16cqw, 202px);
    --ribbon-step: calc(var(--ribbon-width) + 16px);
    position: relative;
    width: 100%;
    height: clamp(226px, 24vw, 302px);
    aspect-ratio: auto;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    perspective: 1100px;
    overflow: hidden;
    isolation: isolate;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 3%,
      black 97%,
      transparent
    );
  }
  .centered-slides .carousel-photo,
  .carousel-neighbor {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--ribbon-width);
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
    transform: translate(
        calc(-50% + var(--ribbon-offset) * var(--ribbon-step)),
        calc(-50% + var(--ribbon-rise))
      )
      rotateY(var(--ribbon-turn));
    box-shadow: 0 8px 24px rgb(0 35 55 / 0.12);
    background: #004465;
    outline-offset: -4px;
    backface-visibility: hidden;
  }
  .centered-slides .carousel-photo {
    z-index: 2;
  }
  .centered-slides .carousel-photo img,
  .carousel-neighbor img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .carousel-neighbor {
    cursor: pointer;
    opacity: 0.92;
    transition:
      opacity 180ms ease,
      filter 180ms ease;
  }
  .carousel-neighbor:hover,
  .carousel-neighbor:focus-visible {
    opacity: 1;
    filter: brightness(1.06);
  }
  .centered-slides .ribbon-counter {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .centered-slides .zoom-hint {
    width: 30px;
    height: 30px;
    bottom: 9px;
    right: 9px;
    border-radius: 8px;
    background: #063349ad;
    backdrop-filter: blur(6px);
  }
  .centered-slides .zoom-hint svg {
    width: 17px;
    height: 17px;
  }
  .carousel-stage:focus-visible {
    outline: 2px solid var(--accent, #008b98);
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .carousel-stage.centered-slides {
      --ribbon-width: clamp(138px, 46cqw, 210px);
      --ribbon-step: calc(var(--ribbon-width) + 12px);
      height: 250px;
    }
    .centered-slides .carousel-photo,
    .carousel-neighbor {
      border-radius: 13px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-neighbor {
      transition: none;
    }
  }
  .carousel-status {
    text-align: center;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
    margin-top: 16px;
  }
  .album-action {
    display: flex;
    justify-content: center;
    padding-top: 18px;
  }
  .album-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
  }
  .album-link::before {
    content: '';
    position: absolute;
    inset: -5px 0;
  }
  .carousel-stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: min(100%, calc(min(var(--carousel-height), 75svh) * 4 / 3));
    aspect-ratio: 4 / 3;
    margin-inline: auto;
    border: 0;
    border-radius: 1.5rem;
    background: #0d2438;
    box-shadow: 0 16px 40px #0044651a;
  }
  .carousel-photo {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .carousel-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-control {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #ffffff44;
    border-radius: 50%;
    background: #071b2dde;
    color: white;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .photo-control:hover {
    background: #006471;
    transform: scale(1.05);
  }
  .photo-control:focus-visible,
  .carousel-photo:focus-visible {
    outline: 3px solid #96c1d6;
    outline-offset: -5px;
  }
  .previous {
    left: 0.75rem;
    top: calc(50% - 24px);
  }
  .next {
    right: 0.75rem;
    top: calc(50% - 24px);
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .photo-counter,
  .zoom-hint {
    position: absolute;
    bottom: 0.8rem;
    border-radius: 999px;
    background: #071b2dde;
    color: white;
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
    pointer-events: none;
  }
  .photo-counter {
    left: 0.8rem;
  }
  .zoom-hint {
    right: 0.8rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 0.65rem;
  }
  dialog {
    --viewer-width: min(
      calc(100vw - 24px),
      1200px,
      max(280px, calc((100svh - 128px) * var(--photo-ratio, 1.5)))
    );
    width: var(--viewer-width);
    height: min(
      calc(var(--viewer-width) / var(--photo-ratio, 1.5) + 104px),
      calc(100svh - 24px)
    );
    max-width: calc(100vw - 24px);
    max-height: calc(100svh - 24px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid #f5f0e625;
    border-radius: 18px;
    background: #072b3d;
    color: #f5f0e6;
    box-shadow: 0 28px 100px #0006;
  }
  dialog[open] {
    display: grid;
    grid-template-rows: 44px minmax(0, 1fr) 60px;
  }
  dialog::backdrop {
    background: #03151ce8;
    backdrop-filter: blur(14px);
  }
  dialog > img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    background: #031f2e;
  }
  .expanded-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    padding: 10px 52px 10px 16px;
    border-bottom: 1px solid #f5f0e615;
  }
  .expanded-brand {
    font-size: 13px;
    font-weight: 750;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .expanded-brand > span {
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    margin-left: 7px;
    opacity: 0.6;
  }
  .expanded-heading a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    white-space: nowrap;
    text-underline-offset: 3px;
  }
  .expanded-heading a:hover {
    text-decoration: underline;
  }
  .expanded-heading a::before {
    content: '';
    position: absolute;
    height: 44px;
    width: 82px;
  }
  dialog .close {
    top: 5px;
    right: 7px;
    width: 32px;
    height: 32px;
    background: #ffffff0d;
    border-color: #f5f0e630;
  }
  dialog .close svg {
    width: 16px;
    height: 16px;
  }
  dialog .close::before {
    content: '';
    position: absolute;
    inset: -6px;
  }
  .expanded-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 8px 12px;
  }
  .expanded-navigation .photo-control {
    position: static;
    display: inline-flex;
    justify-content: center;
    gap: 7px;
    width: auto;
    height: 44px;
    padding: 0 14px;
    border-radius: 9px;
    font-size: 11px;
    border-color: #f5f0e630;
    background: transparent;
  }
  .expanded-navigation .photo-control:hover {
    background: #ffffff0d;
    transform: none;
  }
  .expanded-navigation svg {
    width: 16px;
    height: 16px;
  }
  .expanded-counter {
    font:
      10px ui-monospace,
      monospace;
    color: #c1d0cd;
    white-space: nowrap;
  }
  .carousel-stage,
  dialog {
    touch-action: pan-y pinch-zoom;
  }
  @media (max-width: 700px) {
    dialog {
      border-radius: 13px;
    }
    .expanded-heading {
      padding-left: 12px;
      gap: 10px;
    }
    .expanded-brand > span {
      display: none;
    }
    .expanded-navigation {
      justify-content: space-between;
      gap: 6px;
      padding-inline: 8px;
    }
    .expanded-navigation .photo-control {
      padding: 0 10px;
      font-size: 10px;
    }
    [data-carousel-stage]:not(.centered-slides) > [data-carousel-previous],
    [data-carousel-stage]:not(.centered-slides) > [data-carousel-next] {
      display: none;
    }
  }
</style>
