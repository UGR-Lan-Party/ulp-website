---
interface Props {
  name: string;
}
const { name } = Astro.props;
const paths: Record<string, string> = {
  controller:
    'M16 23h32c6 0 9 5 10 11l3 14c1 6-5 9-9 5l-9-8H21l-9 8c-4 4-10 1-9-5l3-14c1-6 4-11 10-11ZM16 30v12m-6-6h12M44 31h.1M51 38h.1M25 23v-6h14v-6',
  arcade:
    'M16 8h31l6 35H11L16 8ZM20 16h24v18H20V16ZM11 43v13h42V43M20 48h.1m8 0h.1m13 0h.1',
  wheel:
    'M57 32a25 25 0 1 1-50 0 25 25 0 0 1 50 0ZM41 32a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM8 26h17m14 0h17M28 40l-3 16m11-16 3 16',
  vr: 'M15 21h34c7 0 10 5 10 12v10c0 7-7 10-12 6l-10-7H27l-10 7C12 53 5 50 5 43V33c0-7 3-12 10-12ZM19 30v7m26-7v7M14 21v-8h36v8',
  code: 'm22 20-13 12 13 12m20-24 13 12-13 12M37 12 27 52',
};
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'paddle' ? (
      <>
        <g transform="rotate(34 43 25)" opacity=".65">
          <>
            <circle
              cx="43"
              cy="24"
              r="12"
              fill="currentColor"
              fill-opacity=".12"
            />
            <path d="M40 36v14h6V36M34 30h18" />
          </>
        </g>
        <g transform="rotate(-34 21 25)">
          <>
            <circle
              cx="21"
              cy="24"
              r="12"
              fill="currentColor"
              fill-opacity=".12"
            />
            <path d="M18 36v14h6V36M12 30h18" />
          </>
        </g>
        <circle cx="46" cy="7" r="3" fill="currentColor" stroke="none" />
      </>
    ) : name === 'foosball' ? (
      <>
        <>
          <rect x="14" y="7" width="36" height="50" rx="4" />
          <rect
            x="18"
            y="11"
            width="28"
            height="42"
            rx="1"
            stroke-opacity=".4"
          />
        </>
        <>
          <path d="M27 7V4h10v3M27 57v3h10v-3M18 32h28" />
          <circle cx="32" cy="32" r="4" stroke-opacity=".4" />
        </>
        {[18, 27, 37, 46].map((y, index) => (
          <g>
            <path d={`M${index % 2 ? 14 : 5} ${y}h${index % 2 ? 45 : 45}`} />
            <path d={`M${index % 2 ? 53 : 3} ${y - 1}v2`} stroke-width="4" />
            {[25, 39].map((x) => (
              <g>
                <circle
                  cx={x}
                  cy={y - 3}
                  r="1.6"
                  fill="currentColor"
                  stroke="none"
                />
                <rect
                  x={x - 1.6}
                  y={y - 1}
                  width="3.2"
                  height="5"
                  rx="1"
                  fill="currentColor"
                  stroke="none"
                />
              </g>
            ))}
          </g>
        ))}
        <circle cx="35" cy="33" r="1.3" fill="currentColor" stroke="none" />
      </>
    ) : (
      <path d={paths[name] || paths.controller} />
    )
  }
</svg>
