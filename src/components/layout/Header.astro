---
import ArrowUpRight from '../ArrowUpRight.astro';
const menuitems = [
  {
    title: 'Inicio',
    path: '/',
  },
  {
    title: 'Información',
    children: [
      { title: 'Sobre nosotros', path: '/info/about' },
      { title: 'Redes sociales', path: '/info/rrss' },
      { title: 'Horarios', path: '/info/horarios' },
      { title: 'Localización', path: '/info/localizacion' },
      { title: 'Ediciones anteriores', path: '/info/ediciones_anteriores' },
      { title: 'FAQs', path: '/info/preguntas_frecuentes' },
      { title: 'Aviso legal', path: '/info/aviso_legal' },
    ],
  },
  {
    title: 'Actividades',
    path: '/actividades',
  },
  {
    title: 'Participan',
    path: '/participan',
  },
  {
    title: 'Noticias',
    path: '/blog',
  },
  {
    title: 'Contacto',
    path: '/contacto',
  },
];
---

<header class="ud-header">
  <div class="design-container header-inner">
    <a href="/" class="header-brand">
      <img
        src="/assets/logo/logo-black.png"
        id="img-modo-oscuro"
        alt=""
        width="46"
        height="46"
      />
      <img
        src="/assets/logo/logo-white.png"
        id="img-modo-claro"
        class="hidden"
        alt=""
        width="46"
        height="46"
      />
      <span><strong>UGR LAN PARTY</strong><small>GRANADA · 2027</small></span>
    </a>
    <nav id="navbarCollapse" class="hidden" aria-label="Principal">
      <ul class="navigation-list">
        {
          menuitems.map((item, index) => (
            <li>
              {item.children ? (
                <>
                  <button
                    class="navigation-link"
                    type="button"
                    id={`navigation-toggle-${index}`}
                    data-submenu-toggle
                    aria-expanded="false"
                    aria-controls={`navigation-submenu-${index}`}
                  >
                    {item.title}
                    <svg
                      class="navigation-chevron"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                  <ul id={`navigation-submenu-${index}`} class="submenu" hidden>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.path}>{child.title}</a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class="navigation-link"
                  href={item.path}
                  aria-current={
                    Astro.url.pathname.replace(/\/$/, '') ===
                    item.path.replace(/\/$/, '')
                      ? 'page'
                      : undefined
                  }
                >
                  {item.title}
                </a>
              )}
            </li>
          ))
        }
        <li>
          <a class="navigation-registration" href="/actividades#competiciones">
            Inscripciones <span aria-hidden="true"><ArrowUpRight /></span>
          </a>
        </li>
      </ul>
    </nav>
    <div class="header-actions">
      <button
        id="themeSwitcher"
        type="button"
        aria-label="Modo oscuro"
        aria-pressed="false"
      >
        <svg
          class="dark:hidden"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          ></path></svg
        >
        <svg
          class="hidden dark:block"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path d="M20.5 13A9 9 0 0 1 11 3.5 9 9 0 1 0 20.5 13Z"></path></svg
        >
      </button>
      <button
        id="navbarToggler"
        type="button"
        aria-label="Menú principal"
        aria-expanded="false"
        aria-controls="navbarCollapse"><span></span><span></span></button
      >
    </div>
  </div>
</header>
