---
const networks = [
  ['Instagram', 'https://www.instagram.com/ulpugr'],
  ['TikTok', 'https://tiktok.com/@ugrlanparty'],
  ['YouTube', 'https://www.youtube.com/@ugrlanparty'],
  ['Twitch', 'https://www.twitch.tv/ugr_lan_party'],
  ['X', 'https://twitter.com/ulpugr'],
  ['Facebook', 'https://www.facebook.com/UGRLanParty/'],
  ['Discord', 'https://discord.gg/FWW9wKZjav'],
];
---

<footer class="design-footer">
  <div class="design-container">
    <div class="footer-top">
      <div>
        <span class="design-eyebrow">UGR LAN PARTY</span><h2>
          La siguiente partida<br />la hacemos juntos.
        </h2>
      </div><div class="footer-contact">
        <a href="mailto:ulp@ugr.es" class="design-link"
          >ulp@ugr.es <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="footer-grid">
      <div>
        <h3>Explora</h3><nav>
          <a href="/actividades">Actividades</a><a href="/info/horarios"
            >Agenda</a
          ><a href="/participan">Participan</a><a
            href="/info/ediciones_anteriores">Ediciones anteriores</a>
        </nav>
      </div><div>
        <h3>Sigue conectado</h3><nav>
          {
            networks.map(([name, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer">
                {name} ↗
              </a>
            ))
          }
        </nav>
      </div><div>
        <h3>Nos vemos en Granada</h3><a
          href="https://maps.app.goo.gl/8c9WLkYAiw6cJRgu7"
          >ETSIIT · Universidad de Granada<br />Calle Periodista Daniel Saucedo
          Aranda, s/n<br />18014 Granada</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span
        >2016 — {new Date().getFullYear()} · UGR LAN Party · Universidad de Granada</span
      ><a href="/info/aviso_legal">Aviso legal ↗</a>
    </div>
  </div>
</footer>
