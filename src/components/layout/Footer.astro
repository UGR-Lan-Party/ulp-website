---
import ArrowUpRight from '../ArrowUpRight.astro';
import GranadaAccent from '../GranadaAccent.astro';
import XIcon from '../../../public/assets/icons/XIcon.astro';
import FacebookIcon from '../../../public/assets/icons/FacebookIcon.astro';
import InstagramIcon from '../../../public/assets/icons/InstagramIcon.astro';
import TikTokIcon from '../../../public/assets/icons/TikTokIcon.astro';
import YouTubeIcon from '../../../public/assets/icons/YouTubeIcon.astro';
import TwitchIcon from '../../../public/assets/icons/TwitchIcon.astro';
import DiscordIcon from '../../../public/assets/icons/DiscordIcon.astro';
const networks = [
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/UGRLanParty/',
    icon: FacebookIcon,
  },
  { name: 'X', href: 'https://twitter.com/ulpugr', icon: XIcon },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@ugrlanparty',
    icon: YouTubeIcon,
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/ulpugr',
    icon: InstagramIcon,
  },
  { name: 'TikTok', href: 'https://tiktok.com/@ugrlanparty', icon: TikTokIcon },
  {
    name: 'Twitch',
    href: 'https://www.twitch.tv/ugr_lan_party',
    icon: TwitchIcon,
  },
  { name: 'Discord', href: 'https://discord.gg/FWW9wKZjav', icon: DiscordIcon },
];
---

<footer class="ulp-footer">
  <GranadaAccent id="footer-stars" />
  <div class="design-container footer-inner">
    <div class="footer-original-grid">
      <div class="footer-brand">
        <a href="/" aria-label="ULP, inicio"
          ><img
            src="/assets/logo/logo-black.png"
            width="100"
            height="100"
            alt="UGR LAN Party"
          /></a
        ><a href="mailto:ulp@ugr.es">ulp@ugr.es</a>
      </div>
      <div>
        <span class="footer-label">Sigue a la ULP</span><nav
          aria-label="Redes sociales de ULP"
          class="footer-social-links"
        >
          {
            networks.map(({ name, href, icon: Icon }) => (
              <a
                href={href}
                aria-label={name}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon width="22" height="22" aria-hidden="true" />
              </a>
            ))
          }
        </nav>
      </div>
      <div class="footer-location">
        <h2>Ubicación</h2><a href="https://maps.app.goo.gl/8c9WLkYAiw6cJRgu7"
          >ETSIIT · Universidad de Granada<br />Calle Periodista Daniel Saucedo
          Aranda, s/n<br />18014 Granada</a
        >
      </div>
    </div>
    <div class="footer-copyright">
      <a class="footer-registration" href="/actividades#competiciones"
        >Inscripciones <span aria-hidden="true"><ArrowUpRight /></span></a
      >
      <span class="footer-credit"
        >2016 — {new Date().getFullYear()} @ UGR LAN Party | Universidad de Granada</span
      ><a href="/info/aviso_legal">Aviso legal</a>
    </div>
  </div>
</footer>
<style>
  .ulp-footer {
    background: #004465;
    color: #f5f0e6;
    padding: 24px 0 20px;
    position: relative;
    overflow: hidden;
  }
  .footer-original-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 36px;
    padding-block: 8px 24px;
    text-align: center;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-brand img {
    display: block;
    width: 100px;
    height: 82px;
    object-fit: contain;
  }
  .footer-brand > a:last-child {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding-inline: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .footer-label {
    display: block;
    font:
      9px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.65;
    margin-bottom: 18px;
  }
  .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .footer-social-links a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgb(245 240 230 / 0.18);
    border-radius: 12px;
    transition: transform 200ms ease;
  }
  .footer-social-links a:hover {
    transform: translateY(-3px);
    background: rgb(245 240 230 / 0.08);
  }
  .footer-social-links :global(svg) {
    width: 21px;
    height: 21px;
  }
  .footer-location h2 {
    font-size: 18px;
    font-weight: 650;
    margin-bottom: 14px;
  }
  .footer-location a {
    font-size: 11px;
    line-height: 1.9;
    opacity: 0.8;
  }
  .footer-brand > a:last-child:hover,
  .footer-location a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-copyright {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 20px;
    border-top: 1px solid rgb(245 240 230 / 0.2);
    padding-top: 20px;
    font-size: 10px;
    opacity: 0.65;
  }
  .footer-credit {
    text-align: center;
  }
  .footer-registration {
    justify-self: start;
  }
  .footer-copyright > a:last-child {
    justify-self: end;
  }
  .footer-copyright a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-inner {
    position: relative;
  }
  @media (max-width: 700px) {
    .footer-original-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-copyright {
      grid-template-columns: 1fr 1fr;
      font-size: 9px;
    }
    .footer-credit {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }
  @media (max-width: 700px) {
    .footer-copyright {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 14px;
    }
    .footer-copyright > a {
      display: none;
    }
    .footer-original-grid {
      gap: 20px;
      padding-bottom: 18px;
    }
  }
</style>
