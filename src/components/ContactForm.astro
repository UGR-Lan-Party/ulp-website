<section class="mail-section design-container" aria-labelledby="mail-title">
  <div class="mail-intro">
    <span class="design-eyebrow">UN MENSAJE Y EMPEZAMOS</span><h2
      id="mail-title"
    >
      Cuéntanos<br /><em>tu idea.</em>
    </h2><p>
      Prepara tu mensaje aquí y termínalo en tu aplicación de correo.
    </p><p class="mail-note">
      Estos campos se quedan en tu navegador. El correo se envía cuando tú lo
      confirmas en tu aplicación.
    </p>
  </div>
  <form data-contact-form aria-label="Preparar correo de contacto">
    <div class="mail-pair">
      <label
        >Nombre<input
          name="name"
          autocomplete="name"
          maxlength="80"
          required
        /></label
      ><label
        >Tu correo<input
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
        /></label
      >
    </div>
    <label
      >Asunto<input
        name="subject"
        maxlength="100"
        required
        placeholder="¿En qué podemos ayudarte?"
      /></label
    >
    <label
      >Mensaje<textarea
        name="message"
        rows="5"
        maxlength="2000"
        required
        placeholder="Te leemos…"></textarea></label
    >
    <div class="mail-actions">
      <button type="submit" disabled
        >Abrir correo <span aria-hidden="true">↗</span></button
      ><button type="button" data-contact-copy disabled>Copiar mensaje</button>
    </div>
    <p class="mail-status" role="status" data-contact-status aria-live="polite">
    </p>
    <a data-contact-draft hidden>Volver a abrir el borrador ↗</a>
    <label data-contact-fallback hidden
      >Mensaje preparado<textarea
        readonly
        rows="7"
        aria-label="Mensaje preparado para copiar"></textarea></label
    >
    <noscript
      ><p>
        Puedes escribirnos directamente a <a href="mailto:ulp@ugr.es"
          >ulp@ugr.es</a
        >.
      </p></noscript
    >
  </form>
</section>
<script>
  import '../scripts/contact-form';
</script>
