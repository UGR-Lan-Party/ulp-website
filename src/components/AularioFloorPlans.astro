---
import VenueAmenityMarker from './VenueAmenityMarker.astro';
import AularioCore from './AularioCore.astro';
import VenueDoor from './VenueDoor.astro';
import {
  aularioFloors,
  aularioGeometry,
  getAularioRooms,
  getAularioColumns,
} from '../data/aulario';
---

{
  aularioFloors.map((floor) => (
    <g
      data-venue-floor-plan={`aulario-${floor.level}`}
      data-hidden
      class="aulario-floor"
    >
      <title>Edificio Aulario, planta {floor.level}</title>
      <g
        transform={floor.level === 0 ? 'rotate(90 460 350)' : undefined}
        style={`--venue-label-offset: ${floor.level === 0 ? -90 : 0}deg`}
      >
        <g transform="translate(460 350) scale(.46) translate(-590 -90)">
          {getAularioRooms(floor.level).map((room, index) => (
            <g data-aulario-room={room.number}>
              <path class="aulario-room" d={room.outline} />
              <path
                class="aulario-wall"
                d={`M${index === 0 ? 108 : room.left} 55H${index === 7 ? 1072 : room.right}${index < 7 ? `M${room.right} 55V214` : ''}`}
              />
              <g data-aulario-door={room.number}>
                <VenueDoor x={room.doorX} y={55} width={23} angle={180} />
              </g>
              <g transform={`translate(${room.x} ${room.y})`}>
                <g class="aulario-label">
                  <text text-anchor="middle" dominant-baseline="middle">
                    {room.number}
                  </text>
                </g>
              </g>
            </g>
          ))}
          <path
            class="aulario-wall"
            d="M60 214H1120M60 185V240M1120 185V240M32 185H60M1120 185H1148"
          />
          {floor.level === 0 &&
            [200, 470, 740, 1010].map((x) => (
              <VenueDoor x={x + 24} y={240} width={24} angle={180} />
            ))}
          {aularioGeometry.stairs.map((x) => (
            <g class="aulario-stair" data-aulario-stair="straight">
              <rect
                class="aulario-stair-landing"
                x={x}
                y={-65}
                width="60"
                height="65"
                rx="2"
              />
              <path d={`M${x} -32H${x + 60}M${x + 28} -65V0M${x + 32} -65V0`} />
              {Array.from({ length: 8 }, (_, index) => (
                <path
                  class="aulario-step"
                  d={`M${x} ${-61 + index * 8}h28M${x + 32} ${-61 + index * 8}h28`}
                />
              ))}
              <path
                class="aulario-stair-direction"
                d={`M${x + 14} -8V-52m-5 6 5-6 5 6M${x + 46} -52V-8m-5-6 5 6 5-6`}
              />
            </g>
          ))}
          <VenueDoor x={889} y={0} width={27} />
          <g transform="translate(946 0) scale(-1 1)">
            <VenueDoor x={0} y={0} width={27} />
          </g>
          {getAularioColumns(floor.level).map((column) => (
            <circle
              class="aulario-column"
              data-aulario-column
              cx={column.x}
              cy={column.y}
              r="3.8"
            />
          ))}
          <AularioCore />
          <path class="aulario-perimeter" d={aularioGeometry.perimeter} />
          {floor.level === 0 && (
            <g data-aulario-entry>
              <VenueDoor x={444} y={0} width={28} />
              <g data-aulario-concierge>
                <title>Conserjería del Aulario</title>
                <rect
                  class="aulario-service-room"
                  x="484"
                  y="-34"
                  width="46"
                  height="34"
                />
                <VenueDoor x={499} y={0} width={15} angle={180} />
                <g transform="translate(507 -18)">
                  <g class="aulario-label">
                    <text
                      class="concierge-label"
                      text-anchor="middle"
                      dominant-baseline="middle"
                    >
                      Conserjería
                    </text>
                  </g>
                </g>
              </g>
            </g>
          )}
          {floor.services.map((service) => (
            <VenueAmenityMarker
              {...service}
              size={15}
              destination={
                ['stairs', 'lift'].includes(service.kind)
                  ? floor.level === 0
                    ? 'aulario-1'
                    : 'aulario-0'
                  : undefined
              }
              destinationLabel={floor.level === 0 ? 'planta 1' : 'planta 0'}
            />
          ))}
        </g>
      </g>
    </g>
  ))
}
<style>
  [data-hidden] {
    display: none !important;
  }
  .aulario-floor {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .aulario-perimeter {
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }
  .aulario-room {
    stroke: none;
    fill: currentColor;
    fill-opacity: 0.035;
  }
  .aulario-service-room {
    fill: var(--venue-plan-background, var(--paper));
    stroke-width: 0.85;
  }
  .aulario-label .concierge-label {
    font-size: 6.5px;
  }
  .aulario-wall {
    stroke-width: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .aulario-column {
    fill: currentColor;
    stroke: none;
    opacity: 0.85;
  }
  .aulario-stair {
    stroke-width: 0.65;
    vector-effect: non-scaling-stroke;
    opacity: 0.8;
  }
  .aulario-stair-landing {
    fill: currentColor;
    fill-opacity: 0.04;
  }
  .aulario-stair-direction {
    stroke-width: 0.8;
  }
  .aulario-label {
    transform: rotate(
      calc(var(--venue-label-turn, 0deg) + var(--venue-label-offset, 0deg))
    );
  }
  .aulario-label text {
    font:
      28px 'Inter Variable',
      sans-serif;
    fill: currentColor;
    stroke: none;
  }
</style>
