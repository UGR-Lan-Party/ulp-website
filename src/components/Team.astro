---
import PersonCard from './PersonCard.astro';

const teams = [
  {
    name: 'Antonio Miguel Mora',
    editions: 8,
    description:
      'Departamento de Teoría de la Señal, Telemática y Comunicaciones',
    image: '/assets/team/team01.jpeg',
    linkedinLink: 'https://www.linkedin.com/in/antoniomora',
  },
  {
    name: 'Marcelino José Cabrera',
    editions: 3,
    description: 'Departamento de Lenguajes y Sistemas Informáticos',
    image: '/assets/team/team03.jpeg',
    linkedinLink: 'https://www.linkedin.com/in/marcelinocabrera',
  },
  {
    name: 'Rafael Alejandro Rodríguez',
    editions: 2,
    description:
      'Departamento de Teoría de la Señal, Telemática y Comunicaciones',
    image: '/assets/team/team02.jpeg',
    linkedinLink: 'https://www.linkedin.com/in/rodgom',
  },
];
---

<section id="team" class="design-section design-container people-section">
  <header data-reveal>
    <div>
      <span class="design-eyebrow">Profesorado</span><h2 class="design-heading">
        Las personas detrás<br />de cada edición.
      </h2>
    </div><p>
      Docentes de la ETSIIT que también se apuntan a compartir partidas, ideas y
      comunidad.
    </p>
  </header>
  <div class="people-grid">
    {
      teams.map((person) => (
        <PersonCard
          name={person.name}
          description={person.description}
          image={person.image}
          href={person.linkedinLink}
          network="LinkedIn"
          badge={`${person.editions} ediciones`}
        />
      ))
    }
  </div>
</section>
<style>
  .people-section {
    padding-bottom: 28px;
  }
  header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: end;
    gap: 40px;
    margin-bottom: 38px;
  }
  .design-eyebrow {
    margin-bottom: 22px;
  }
  h2 {
    font-size: clamp(34px, 4.5vw, 60px);
  }
  header > p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.85;
    max-width: 320px;
    justify-self: end;
  }
  .people-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  @media (max-width: 1050px) {
    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    header {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    header > p {
      justify-self: start;
    }
    .people-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
