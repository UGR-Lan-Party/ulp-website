---
interface Props {
  x: number;
  y: number;
  angle?: number;
  width?: number;
}
const { x, y, angle = 0, width = 32 } = Astro.props;
---

<g
  class="plan-door"
  transform={`translate(${x} ${y}) rotate(${angle})`}
  aria-hidden="true"
>
  <path class="door-opening" d={`M0 0H${width}`}></path>
  <path class="door-leaf" d={`M0 0V${-width}`}></path>
  <path class="door-swing" d={`M0 ${-width}A${width} ${width} 0 0 1 ${width} 0`}
  ></path>
</g>
<style>
  path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .door-opening {
    stroke: var(--venue-plan-background, var(--paper));
    stroke-width: var(--venue-door-opening-width, 4);
  }
  .door-leaf {
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .door-swing {
    stroke: var(--ink);
    stroke-width: 0.8;
    opacity: 0.5;
  }
</style>
