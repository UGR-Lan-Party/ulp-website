---
import { faqs } from '../data/faqs';
const isHome = Astro.url.pathname === '/';
const questions = isHome ? faqs.slice(0, 5) : faqs;
---

<section class="design-section design-container faq-section">
  <div class="faq-intro" data-reveal>
    <span class="design-eyebrow">Antes de darle a start</span><h2
      class="design-heading"
    >
      ¿Alguna<br /><em>pregunta?</em>
    </h2><p>Lo que necesitas saber para disfrutar de la ULP.</p><a
      class="design-link"
      href={isHome ? '/info/preguntas_frecuentes' : '/contacto'}
      >{isHome ? 'Todas las preguntas' : 'Escríbenos'}
      <span aria-hidden="true">↗</span></a>
  </div>
  <div class="faq-list">
    {
      questions.map((faq, index) => (
        <details data-reveal>
          <>
            <summary>
              <>
                <span class="faq-index">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{faq.title}</span>
                <span class="faq-plus" aria-hidden="true">
                  +
                </span>
              </>
            </summary>
            <p>{faq.description}</p>
          </>
        </details>
      ))
    }
  </div>
</section>
<style>
  .faq-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
  }
  .faq-intro .design-eyebrow {
    margin-bottom: 24px;
  }
  .faq-intro .design-heading {
    font-size: clamp(36px, 5vw, 60px);
    margin-bottom: 24px;
  }
  .faq-intro p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 18px;
    max-width: 260px;
  }
  em {
    font:
      italic 400 1em Georgia,
      serif;
  }
  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: start;
    gap: 16px;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-index {
    flex-shrink: 0;
    font:
      10px ui-monospace,
      monospace;
    opacity: 0.5;
    margin-top: 4px;
  }
  .faq-plus {
    margin-left: auto;
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    transition: transform 200ms ease;
  }
  details[open] .faq-plus {
    transform: rotate(45deg);
  }
  details > p {
    margin: 0 24px 26px 32px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.85;
  }
  @media (max-width: 700px) {
    .faq-section {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
