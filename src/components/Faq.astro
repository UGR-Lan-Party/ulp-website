---
import ArrowUpRight from './ArrowUpRight.astro';
import { faqs } from '../data/faqs';
interface Props {
  page?: number;
}
const { page = 1 } = Astro.props;
const isHome = Astro.url.pathname === '/';
const pageSize = 6;
const pageCount = Math.ceil(faqs.length / pageSize);
const offset = isHome ? 0 : (page - 1) * pageSize;
const questions = isHome
  ? faqs.slice(0, 5)
  : faqs.slice(offset, offset + pageSize);
---

<section
  class:list={[
    'design-section design-container faq-section',
    { 'faq-section--home': isHome },
  ]}
>
  <div class="faq-intro" data-reveal>
    <span class="design-eyebrow">Antes de darle a start</span><h2
      class="design-heading"
    >
      ¿Alguna<br /><em>pregunta?</em>
    </h2><p>Lo que necesitas saber para disfrutar de la ULP.</p><a
      class="design-link"
      href={isHome ? '/info/preguntas_frecuentes' : '/contacto'}
      >{isHome ? 'Todas las preguntas' : 'Escríbenos'}
      <span aria-hidden="true"><ArrowUpRight /></span></a
    >
  </div>
  <div id="preguntas" class="faq-list">
    {
      questions.map((faq, index) => (
        <details id={`pregunta-${faq.id}`} data-reveal>
          <summary>
            <span class="faq-index">
              {String(offset + index + 1).padStart(2, '0')}
            </span>
            <span>{faq.title}</span>
            <span class="faq-plus" aria-hidden="true">
              +
            </span>
          </summary>
          <p>{faq.description}</p>
        </details>
      ))
    }
    {
      !isHome && (
        <nav
          class="faq-pagination"
          aria-label="Páginas de preguntas frecuentes"
        >
          <>
            <span>
              Página {page} de {pageCount}
            </span>
            <div>
              {Array.from({ length: pageCount }, (_, index) => (
                <a
                  href={
                    index === 0
                      ? '/info/preguntas_frecuentes#preguntas'
                      : `/info/preguntas_frecuentes/${index + 1}#preguntas`
                  }
                  aria-label={`Página ${index + 1}`}
                  aria-current={page === index + 1 ? 'page' : undefined}
                >
                  {index + 1}
                </a>
              ))}
            </div>
          </>
        </nav>
      )
    }
  </div>
</section>
<style>
  .faq-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
  }
  .faq-section--home {
    padding-top: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(32px, 4vw, 56px);
  }
  .faq-intro .design-eyebrow {
    margin-bottom: 24px;
  }
  .faq-intro .design-heading {
    font-size: clamp(36px, 5vw, 60px);
    margin-bottom: 24px;
  }
  .faq-intro p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 18px;
    max-width: 260px;
  }
  em {
    font:
      italic 400 1em Georgia,
      serif;
  }
  details {
    border-top: 1px solid var(--line);
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: start;
    gap: 16px;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-index {
    flex-shrink: 0;
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted);
    margin-top: 4px;
  }
  .faq-plus {
    margin-left: auto;
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    transition: transform 200ms ease;
  }
  details[open] .faq-plus {
    transform: rotate(45deg);
  }
  details > p {
    margin: 0 24px 26px 32px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.85;
  }
  .faq-list {
    scroll-margin-top: 110px;
  }
  .faq-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .faq-pagination > span {
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted);
  }
  .faq-pagination > div {
    display: flex;
    gap: 8px;
  }
  .faq-pagination a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 12px;
    transition:
      background 200ms ease,
      color 200ms ease;
  }
  .faq-pagination a[aria-current='page'],
  .faq-pagination a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 700px) {
    .faq-section {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<script>
  const target = document.getElementById(location.hash.slice(1));
  if (target instanceof HTMLDetailsElement && /^pregunta-\d+$/.test(target.id))
    target.open = true;
</script>
