---
import ArrowUpRight from './ArrowUpRight.astro';
import LocationMapPreview from './LocationMapPreview.astro';
import LinktreeIcon from '../../public/assets/icons/LinktreeIcon.astro';
---

<section id="contact" class="design-section design-container contact-design">
  <div class="contact-copy" data-reveal>
    <span class="design-eyebrow">Al otro lado de la pantalla</span><h2>
      ¿Hablamos?
    </h2><p>
      Participación, colaboración o cualquier duda sobre la ULP. Estamos aquí
      para ayudarte.
    </p>
    <div class="contact-detail">
      <span>01 / Escríbenos</span><a href="mailto:ulp@ugr.es"
        >ulp@ugr.es <span aria-hidden="true"><ArrowUpRight /></span></a
      >
    </div>
    <div class="contact-detail">
      <span>02 / Encuéntranos</span><a
        href="https://maps.app.goo.gl/8c9WLkYAiw6cJRgu7"
        >ETSIIT · Universidad de Granada<br /><small
          >Calle Periodista Daniel Saucedo Aranda, s/n, 18014 Granada</small
        ><span aria-hidden="true"> <ArrowUpRight /></span></a
      >
    </div>
    <a class="design-link" href="https://linktr.ee/ulpugr">
      <LinktreeIcon width="19" height="19" aria-hidden="true" />
      <span>También puedes encontrarnos en RRSS</span>
      <span aria-hidden="true"><ArrowUpRight /></span>
    </a>
  </div>
  <div class="contact-map" data-reveal><LocationMapPreview /></div>
</section>
<style>
  .contact-design {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 0.85fr 1.3fr;
    gap: 64px;
    align-items: start;
  }
  .contact-copy .design-eyebrow {
    margin-bottom: 24px;
  }
  h2 {
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 24px;
  }
  .contact-copy > p {
    max-width: 330px;
    color: var(--muted);
    line-height: 1.8;
    font-size: 14px;
    margin-bottom: 32px;
  }
  .contact-detail {
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .contact-detail > span {
    display: block;
    font:
      9px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.65;
    margin-bottom: 14px;
  }
  .contact-detail > a {
    font-size: 21px;
    line-height: 1.4;
    letter-spacing: -0.03em;
  }
  .contact-detail > a small {
    font-size: 12px;
    letter-spacing: 0;
    color: var(--muted);
  }
  .contact-detail > a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .contact-copy > .design-link {
    margin-top: 16px;
    font-size: 12px;
    gap: 10px;
  }
  .contact-copy > .design-link :global(svg) {
    flex-shrink: 0;
  }
  .contact-map {
    min-width: 0;
  }
  @media (max-width: 800px) {
    .contact-design {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
