---
import PartnerLogo from './PartnerLogo.astro';
import ArrowUpRight from './ArrowUpRight.astro';
import { partners } from '../data/sponsors';
import { partnerTiers } from '../data/partner-tiers';
const groups = partnerTiers
  .map((tier, rank) => ({
    ...tier,
    rank,
    items: partners.filter((partner) => partner.tier === tier.id),
  }))
  .filter((group) => group.items.length);
const sizes = [76, 66, 58, 52, 46, 40];
---

<section
  class="about-partners design-container design-section"
  aria-labelledby="about-partners-title"
>
  <header class="design-section-header" data-reveal>
    <div>
      <span class="design-eyebrow"
        >La comunidad que lo hace posible · ULP 2026</span
      ><h2 id="about-partners-title" class="design-heading">
        Sumamos <em>partida a partida</em>
      </h2>
    </div>
    <a class="design-link" href="/participan/"
      >Conoce a las entidades que participaron en la última edición <ArrowUpRight
      /></a
    >
  </header>
  {
    groups.map((group) => (
      <section
        class="about-partner-tier"
        data-about-tier={group.id}
        style={`--tier-accent:${group.accent};--tier-logo-height:${sizes[group.rank]}px`}
        aria-labelledby={`about-tier-${group.id}`}
      >
        <h3 id={`about-tier-${group.id}`}>
          <span />
          {group.name}
        </h3>
        <ul class="about-partner-logos">
          {group.items.map((partner, index) => (
            <li data-partner-rise data-rise-delay={(index % 5) * 65}>
              <a
                href={
                  partner.links.find((link) => link.rrss === 'Web')?.link ??
                  '/participan/'
                }
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${partner.name}, abrir web en otra pestaña`}
              >
                <PartnerLogo
                  partner={partner}
                  width={240}
                  height={sizes[group.rank]}
                />
                <span>{partner.name.trim()}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>
<script>
  import { siteMotion, scrollEntryMotion } from '../utils/site-motion.js';
  const reduced = siteMotion();
  const scrollEntries = scrollEntryMotion();
  const revealed = new WeakSet<Element>();
  const logos = document.querySelectorAll<HTMLElement>('[data-partner-rise]');
  function revealLogo(logo: HTMLElement) {
    if (revealed.has(logo)) return;
    revealed.add(logo);
    if (reduced.matches) return;
    logo.animate(
      [
        {
          opacity: scrollEntries.matches ? 0 : 1,
          transform: 'translateY(24px)',
        },
        { opacity: 1, transform: 'translateY(0)' },
      ],
      {
        duration: 750,
        delay: Number(logo.dataset.riseDelay ?? 0),
        easing: 'cubic-bezier(.16, 1, .3, 1)',
        fill: 'backwards',
      },
    );
  }
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        revealLogo(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.12 },
  );
  logos.forEach((logo) => {
    observer.observe(logo);
  });
  scrollEntries.addEventListener('change', () => {
    if (!scrollEntries.matches) {
      logos.forEach((logo) =>
        logo.getAnimations().forEach((animation) => animation.cancel()),
      );
    }
  });
</script>
<style>
  .about-partners {
    padding-block: clamp(28px, 4vw, 48px);
  }
  .about-partners header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  h2 {
    max-width: 680px;
  }
  h2 em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  header > a {
    max-width: 100%;
    white-space: normal;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .about-partner-tier {
    padding-block: 12px 16px;
    border-top: 1px solid var(--line);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    font:
      11px/1.6 ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    margin-bottom: 10px;
  }
  h3 > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tier-accent);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
    list-style: none;
  }
  [data-about-tier='diamond'] li {
    flex-basis: 220px;
  }
  [data-about-tier='regular'] li {
    flex-basis: 150px;
  }
  li {
    flex: 0 1 180px;
    min-width: 0;
  }
  li a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 100%;
    padding: 10px 8px;
    border: 1px solid transparent;
    border-radius: 12px;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  li a:hover,
  li a:focus-visible {
    border-color: var(--line);
    background: var(--surface);
  }
  li :global(.partner-logo-frame) {
    width: 100%;
    --partner-logo-height: var(--tier-logo-height);
  }
  li a > span {
    font-size: 10px;
    text-align: center;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    ul {
      gap: 8px 12px;
    }
    li,
    [data-about-tier='diamond'] li,
    [data-about-tier='regular'] li {
      flex-basis: 160px;
    }
  }
  @media (max-width: 500px) {
    li,
    [data-about-tier='diamond'] li,
    [data-about-tier='regular'] li {
      flex-basis: calc(50% - 6px);
    }
    li a {
      padding: 8px 4px;
    }
    [data-about-tier='diamond'] {
      --tier-logo-height: 62px !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li a {
      transition: none;
    }
  }
</style>
