---
import PartnerLogo from './PartnerLogo.astro';
import ArrowUpRight from './ArrowUpRight.astro';
import { partners } from '../data/sponsors';
import { partnerTiers } from '../data/partner-tiers';
const groups = partnerTiers
  .map((tier, rank) => ({
    ...tier,
    rank,
    items: partners.filter((partner) => partner.tier === tier.id),
  }))
  .filter((group) => group.items.length);
const sizes = [100, 86, 76, 66, 58, 48];
---

<section
  class="about-partners design-container design-section"
  aria-labelledby="about-partners-title"
>
  <header class="design-section-header" data-reveal>
    <div>
      <span class="design-eyebrow"
        >La comunidad que lo hace posible · ULP 2026</span
      ><h2 id="about-partners-title" class="design-heading">
        Sumamos <em>partida a partida</em>
      </h2>
    </div>
    <a class="design-link" href="/participan/"
      >Conoce a las entidades <ArrowUpRight /></a
    >
  </header>
  {
    groups.map((group) => (
      <section
        class="about-partner-tier"
        data-about-tier={group.id}
        style={`--tier-accent:${group.accent};--tier-logo-height:${sizes[group.rank]}px`}
        aria-labelledby={`about-tier-${group.id}`}
      >
        <h3 id={`about-tier-${group.id}`}>
          <span />
          {group.name}
        </h3>
        <ul class="about-partner-logos">
          {group.items.map((partner, index) => (
            <li data-partner-rise data-rise-delay={(index % 5) * 65}>
              <a
                href={
                  partner.links.find((link) => link.rrss === 'Web')?.link ??
                  '/participan/'
                }
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${partner.name}, abrir web en otra pestaña`}
              >
                <PartnerLogo
                  partner={partner}
                  width={240}
                  height={sizes[group.rank]}
                />
                <span>{partner.name.trim()}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        if (!reduced.matches)
          entry.target.animate(
            [
              { opacity: 0, transform: 'translateY(24px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            {
              duration: 750,
              delay: Number(
                (entry.target as HTMLElement).dataset.riseDelay ?? 0,
              ),
              easing: 'cubic-bezier(.16, 1, .3, 1)',
              fill: 'backwards',
            },
          );
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.12 },
  );
  document
    .querySelectorAll('[data-partner-rise]')
    .forEach((logo) => observer.observe(logo));
</script>
<style>
  .about-partners header {
    margin-bottom: 36px;
  }
  h2 {
    max-width: 680px;
  }
  h2 em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  header > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .about-partner-tier {
    padding-block: 25px 32px;
    border-top: 1px solid var(--line);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font:
      11px/1.6 ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
    margin-bottom: 24px;
  }
  h3 > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tier-accent);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px 28px;
    list-style: none;
  }
  [data-about-tier='diamond'] ul {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  [data-about-tier='regular'] ul {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  li {
    min-width: 0;
  }
  li a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    height: 100%;
    padding: 18px 10px;
    border: 1px solid transparent;
    border-radius: 12px;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  li a:hover,
  li a:focus-visible {
    border-color: var(--line);
    background: var(--surface);
  }
  li :global(.partner-logo-frame) {
    width: 100%;
    --partner-logo-height: var(--tier-logo-height);
  }
  li a > span {
    font-size: 10px;
    text-align: center;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    ul,
    [data-about-tier='regular'] ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
  }
  @media (max-width: 500px) {
    ul,
    [data-about-tier='regular'] ul,
    [data-about-tier='diamond'] ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li a {
      padding: 14px 6px;
    }
    [data-about-tier='diamond'] {
      --tier-logo-height: 76px !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    li a {
      transition: none;
    }
  }
</style>
