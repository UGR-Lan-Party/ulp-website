---
import AgendaData from './AgendaData.astro';
import { programEdition } from '../data/program';
---

<section
  id="mi-agenda"
  class="personal-agenda"
  data-personal-agenda
  aria-labelledby="personal-agenda-title"
  hidden
>
  <header>
    <div>
      <span class="design-eyebrow">Tu selección · {programEdition.year}</span
      ><h3 id="personal-agenda-title" tabindex="-1">Mi <em>agenda.</em></h3>
    </div>
    <span class="agenda-total" data-agenda-total>0 guardadas</span>
  </header>
  <p class="agenda-explanation">
    Guarda las franjas que te interesan. Se guardan en este dispositivo y puedes
    compartir tu selección; no te inscriben en las actividades.
  </p>
  <p class="agenda-storage-notice" data-agenda-storage hidden></p>
  <p class="agenda-storage-notice" data-agenda-link-error hidden></p>
  <p class="agenda-empty" data-agenda-empty>
    Todavía no has guardado ninguna. Usa «Guardar» en la tabla o en la ficha de
    una actividad.
  </p>
  <ol class="agenda-saved-list" data-agenda-list></ol>
  <div class="agenda-conflicts" data-agenda-conflicts hidden>
    <h4>Revisa estos solapamientos</h4><ul data-agenda-conflict-list></ul>
  </div>
  <div class="agenda-tools">
    <button type="button" class="design-button" data-agenda-export disabled
      >Descargar calendario (.ics)</button
    ><button
      type="button"
      class="design-button secondary"
      data-agenda-share
      disabled>Compartir agenda</button
    ><button type="button" class="agenda-clear" data-agenda-clear disabled
      >Vaciar agenda</button
    >
  </div>
  <p class="agenda-footnote">
    Se muestra el archivo de {programEdition.year}. Sin hora de fin confirmada
    no se calcula el solapamiento ni se inventa una duración para el calendario.
  </p>
</section>
<dialog
  class="agenda-share-dialog"
  data-agenda-share-dialog
  aria-labelledby="agenda-share-title"
>
  <div class="share-heading">
    <span class="design-eyebrow">EL PLAN SE COMPARTE</span><button
      type="button"
      data-agenda-share-close
      aria-label="Cerrar agenda compartida">✕</button
    >
  </div>
  <h3 id="agenda-share-title">Nos vemos <em>allí</em></h3>
  <div data-agenda-incoming hidden>
    <p>
      Acepta o rechaza cada actividad y guarda tu selección, o acepta todo de
      una vez. Lo que ya tenías en tu agenda se conserva.
    </p>
    <ul data-agenda-incoming-list></ul>
    <div class="incoming-actions">
      <button
        type="button"
        class="design-button"
        data-agenda-import-selected
        disabled>Guardar selección (0)</button
      >
      <button type="button" class="incoming-accept-all" data-agenda-import
        >Aceptar todo</button
      >
    </div>
  </div>
  <div data-agenda-outgoing>
    <p>
      Envía tu plan o deja que escaneen el QR. Solo se comparten las actividades
      elegidas.
    </p>
    <canvas
      data-agenda-qr
      role="img"
      aria-label="Código QR de la agenda compartida"
      hidden></canvas>
    <label class="share-url"
      >Enlace de tu agenda<input
        data-agenda-share-url
        type="url"
        readonly
      /></label
    >
    <div class="share-buttons">
      <button type="button" class="design-button" data-agenda-copy
        >Copiar enlace</button
      ><button
        type="button"
        class="design-button secondary"
        data-agenda-native
        hidden>Compartir…</button
      >
    </div>
    <p class="share-note">
      La selección no equivale a una inscripción. Quien abra el enlace decidirá
      si la añade a su agenda.
    </p>
  </div>
  <p data-agenda-share-status role="status" aria-live="polite"></p>
</dialog>
<p class="sr-only" data-agenda-status role="status" aria-live="polite"></p>
<noscript
  ><p>
    Activa JavaScript para guardar tu agenda en este dispositivo. El programa
    completo sigue disponible debajo.
  </p></noscript
>
<AgendaData />
<style>
  [hidden] {
    display: none !important;
  }
  .personal-agenda {
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: clamp(22px, 3vw, 32px);
    background: var(--surface);
    margin-block: 24px 32px;
    scroll-margin-top: 110px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .design-eyebrow {
    font-size: 9px;
    margin-bottom: 12px;
  }
  h3 {
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 750;
    line-height: 1.15;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .agenda-total {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .agenda-explanation,
  .agenda-empty,
  .agenda-footnote,
  .agenda-storage-notice {
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
    margin-top: 16px;
  }
  .agenda-empty {
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 16px;
  }
  .agenda-saved-list {
    display: grid;
    margin-top: 20px;
  }
  .agenda-saved-list :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  .agenda-saved-list :global(strong),
  .agenda-saved-list :global(a) {
    display: block;
    font-size: 14px;
    font-weight: 650;
  }
  .agenda-saved-list :global(a:hover) {
    text-decoration: underline;
  }
  .agenda-saved-list :global(p) {
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    margin-top: 5px;
  }
  .agenda-saved-list :global(button),
  .agenda-clear {
    flex-shrink: 0;
    min-height: 40px;
    padding: 8px 12px;
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
  }
  .agenda-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .agenda-tools .design-button {
    min-height: 44px;
    font-size: 12px;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .agenda-conflicts {
    border-left: 3px solid var(--ink);
    padding: 14px 18px;
    margin-top: 22px;
    background: var(--paper);
    border-radius: 0 10px 10px 0;
  }
  h4 {
    font-size: 13px;
    font-weight: 650;
  }
  .agenda-conflicts :global(li) {
    font-size: 12px;
    line-height: 1.7;
    margin-top: 8px;
  }
  .agenda-footnote {
    font-size: 11px;
  }
  @media (max-width: 500px) {
    .agenda-saved-list :global(li) {
      align-items: start;
      gap: 10px;
    }
  }
</style>

<style>
  .agenda-share-dialog {
    width: min(500px, calc(100vw - 28px));
    max-height: calc(100dvh - 36px);
    padding: 28px;
    margin: auto;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 100px #001b3660;
    overflow: auto;
  }
  .agenda-share-dialog::backdrop {
    background: #001c30a6;
    backdrop-filter: blur(7px);
  }
  .share-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .share-heading button {
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
  }
  .agenda-share-dialog h3 {
    margin: 18px 0;
    font-size: 34px;
  }
  .agenda-share-dialog p,
  .agenda-share-dialog li {
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .agenda-share-dialog ul {
    margin: 16px 0;
    display: grid;
    gap: 8px;
  }
  .agenda-share-dialog :global(.incoming-activity) {
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .agenda-share-dialog :global(.incoming-activity strong) {
    display: block;
    color: var(--ink);
    font-size: 14px;
  }
  .agenda-share-dialog :global(.incoming-time) {
    display: block;
    font-size: 11px;
    overflow-wrap: anywhere;
  }
  .agenda-share-dialog :global(.incoming-decisions),
  .incoming-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .agenda-share-dialog :global(.incoming-decisions button),
  .incoming-accept-all {
    padding: 8px 12px;
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
  }
  .agenda-share-dialog
    :global(.incoming-decisions button[aria-pressed='true']) {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .agenda-share-dialog :global(.incoming-activity[data-decision='accepted']) {
    border-color: var(--accent);
  }
  .incoming-actions {
    margin-top: 18px;
    align-items: center;
  }
  .incoming-actions button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .agenda-share-dialog :global(.incoming-decisions button:focus-visible),
  .incoming-actions button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .agenda-share-dialog :global(.incoming-hint) {
    display: block;
    font-size: 11px;
    color: var(--muted);
  }
  .agenda-share-dialog canvas {
    display: block;
    margin: 22px auto;
    max-width: 100%;
    border-radius: 12px;
  }
  .agenda-share-dialog [hidden] {
    display: none;
  }
  .share-url {
    display: grid;
    gap: 8px;
    font-size: 11px;
    color: var(--muted);
    margin: 18px 0;
  }
  .share-url input {
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font-size: 12px;
  }
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .share-note {
    margin-top: 18px;
  }
  .agenda-share-dialog [data-agenda-share-status] {
    margin-top: 14px;
  }
</style>
