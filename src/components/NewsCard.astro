---
import ArrowUpRight from './ArrowUpRight.astro';
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import { formatNewsDate, getReadingMinutes } from '../utils/news';
interface Props {
  entry: CollectionEntry<'blog'>;
  featured?: boolean;
  compact?: boolean;
}
const { entry, featured = false, compact = false } = Astro.props;
const poster = /cartel|ulp2025/i.test(entry.data.image.src);
const Heading = featured ? 'h2' : 'h3';
---

<article
  class:list={[
    'news-card',
    {
      'news-featured': featured,
      'news-compact': compact,
      'news-poster': poster,
    },
  ]}
  data-reveal
>
  <a href={`/blog/${entry.id}`}>
    <div class="news-media">
      <ResponsiveImage
        src={entry.data.image.src}
        alt={entry.data.image.alt}
        loading={featured ? 'eager' : 'lazy'}
        sizes={featured
          ? '(max-width: 700px) 100vw, 55vw'
          : '(max-width: 700px) 100vw, 33vw'}
      /><span class="news-image-label"
        >{featured ? 'En portada' : (entry.data.tags[0] ?? 'ULP')}</span
      >
    </div>
    <div class="news-card-copy">
      <div class="news-meta">
        <time datetime={entry.data.publishDate.toISOString()}
          >{formatNewsDate(entry.data.publishDate)}</time
        ><span class="news-reading-time">{getReadingMinutes(entry)} min</span>
      </div><Heading class="news-card-title">{entry.data.title}</Heading><p>
        {entry.data.snippet}
      </p><span class="news-read"
        >Leer historia <span aria-hidden="true"><ArrowUpRight /></span></span
      >
    </div>
  </a>
</article>
<style>
  .news-card {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }
  .news-card > a {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .news-card > a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
    border-radius: inherit;
  }
  .news-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e8e3d9;
  }
  .news-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .news-poster:not(.news-compact) .news-media :global(img) {
    object-fit: contain;
  }
  @media (hover: hover) {
    .news-card:hover .news-media :global(img) {
      transform: scale(1.025);
    }
    .news-card:hover .news-read > span {
      transform: translate(2px, -2px);
    }
  }
  .news-image-label {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 6px 9px;
    background: #f5f0e6;
    color: #004465;
    border-radius: 99px;
    font-size: 9px;
    line-height: 1.3;
  }
  .news-image-label::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    margin-right: 5px;
    background: #007b85;
    vertical-align: 1px;
  }
  .news-card-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: 20px;
    flex: 1;
  }
  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    color: var(--muted);
    font-size: 9px;
    margin-bottom: 12px;
  }
  .news-reading-time::before {
    content: '·';
    margin-right: 12px;
  }
  .news-card-title {
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.18;
    margin-bottom: 10px;
    text-wrap: pretty;
  }
  .news-card-copy > p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.65;
  }
  .news-read {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    margin-top: auto;
    padding-top: 18px;
  }
  .news-read > span {
    display: inline-flex;
    transition: transform 200ms ease;
  }
  .news-read :global(svg) {
    width: 14px;
    height: 14px;
  }
  .news-featured .news-media {
    aspect-ratio: 16 / 10;
  }
  .news-featured .news-card-copy {
    padding: 24px;
  }
  .news-featured .news-card-title {
    font-size: clamp(26px, 2.7vw, 38px);
  }
  .news-featured .news-card-copy > p {
    font-size: 13px;
    max-width: 52ch;
  }
  .news-compact {
    border: 0;
    border-radius: 0;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
    background: transparent;
  }
  .news-compact:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .news-compact > a {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .news-compact .news-media {
    aspect-ratio: 1;
    border-radius: 10px;
  }
  .news-compact .news-card-copy {
    padding: 0;
  }
  .news-compact .news-card-title {
    font-size: 18px;
    margin-bottom: 6px;
  }
  .news-compact .news-meta {
    margin-bottom: 8px;
    font-size: 8px;
    gap: 4px 8px;
  }
  .news-compact .news-image-label {
    display: none;
  }
  .news-compact .news-card-copy > p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 11px;
    line-height: 1.6;
  }
  .news-compact .news-read {
    padding-top: 10px;
    font-size: 10px;
  }
  @media (max-width: 700px) {
    .news-card {
      border-radius: 12px;
    }
    .news-card:not(.news-featured) > a {
      display: grid;
      grid-template-columns: 84px minmax(0, 1fr);
      align-items: start;
      gap: 12px;
    }
    .news-card:not(.news-featured) .news-media {
      aspect-ratio: 1;
      border-radius: 8px;
    }
    .news-card:not(.news-featured) .news-card-copy {
      padding: 12px 12px 12px 0;
    }
    .news-card:not(.news-featured) .news-image-label {
      display: none;
    }
    .news-card-title {
      font-size: 18px;
      line-height: 1.2;
      margin-bottom: 7px;
    }
    .news-card-copy > p {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      font-size: 11px;
    }
    .news-meta {
      font-size: 8px;
      margin-bottom: 8px;
    }
    .news-read {
      font-size: 10px;
      padding-top: 10px;
    }
    .news-featured .news-media {
      aspect-ratio: 16 / 9;
    }
    .news-featured .news-card-copy {
      padding: 17px;
    }
    .news-featured .news-card-title {
      font-size: 25px;
      margin-bottom: 9px;
    }
    .news-featured .news-card-copy > p {
      font-size: 12px;
    }
    .news-compact {
      border-radius: 0;
      padding-bottom: 12px;
    }
    .news-compact:not(.news-featured) .news-card-copy {
      padding: 0;
    }
    .news-compact .news-read {
      padding-top: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .news-media :global(img),
    .news-read > span {
      transition: none;
    }
  }
</style>
