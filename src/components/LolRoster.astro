---
import ArrowUpRight from './ArrowUpRight.astro';
import teams from '../data/lol-rosters-2026.json';
import { getLolStatsUrl } from '../utils/lol-stats.js';
---

<div class="lol-roster" data-lol-roster>
  <p class="roster-help">
    Riot ID de 2026 · Estadísticas en OP.GG (EUW), en otra pestaña
  </p>
  <div class="roster-grid">
    {
      teams.map((team) => (
        <article class="roster-team">
          <h4>{team.name}</h4>
          <ul>
            {[...team.players, ...team.substitutes].map((riotId, index) => (
              <li>
                <a
                  href={getLolStatsUrl(riotId)}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={`Ver estadísticas de ${riotId} en OP.GG (se abre en otra pestaña)`}
                >
                  <span class="roster-player">{riotId}</span>
                  {index >= team.players.length && (
                    <span class="roster-substitute">Suplente</span>
                  )}
                  <span class="roster-arrow" aria-hidden="true">
                    <ArrowUpRight />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</div>
<style>
  .lol-roster {
    margin-bottom: 24px;
  }
  .roster-help {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
    margin-bottom: 16px;
  }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .roster-team {
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  h4 {
    font-size: 15px;
    font-weight: 650;
    margin-bottom: 12px;
    overflow-wrap: anywhere;
  }
  ul {
    display: grid;
    gap: 4px;
    list-style: none;
  }
  li {
    min-width: 0;
  }
  a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 7px;
    font-size: 12px;
    color: var(--ink);
    transition: background 180ms ease;
  }
  a:hover,
  a:focus-visible {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .roster-player {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  a:hover .roster-player,
  a:focus-visible .roster-player {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .roster-substitute {
    font-size: 9px;
    color: var(--muted);
  }
  .roster-arrow {
    margin-left: auto;
    flex-shrink: 0;
    opacity: 0.55;
  }
  @media (max-width: 650px) {
    .roster-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .roster-team {
      padding: 16px;
    }
  }
</style>
