---
import ResponsiveImage from './ResponsiveImage.astro';
type AwardPosition = 'first' | 'second' | 'third' | 'mvp';
interface Props {
  position: AwardPosition;
  awards: string[];
}
const { position, awards } = Astro.props;
const tiers = {
  first: {
    label: 'Campeón',
    rank: '1ST',
    accent: '#ebc96b',
    badge: '/assets/competitions/medals/ulp-gold-badge.png',
  },
  second: {
    label: '2º Puesto',
    rank: '2ND',
    accent: '#c2d7e0',
    badge: '/assets/competitions/medals/ulp-silver-badge.png',
  },
  third: {
    label: '3º Puesto',
    rank: '3RD',
    accent: '#dfa276',
    badge: '/assets/competitions/medals/ulp-bronze-badge.png',
  },
  mvp: {
    label: 'MVP',
    rank: 'MVP',
    accent: '#c2a6f3',
    badge: '/assets/competitions/medals/ulp-mvp-badge.png',
  },
};
const tier = tiers[position];
---

<section
  class:list={['award-card', `award-card--${position}`]}
  style={`--award-accent:${tier.accent}`}
  aria-label={tier.label}
>
  <span class="award-corner top-left" aria-hidden="true"></span>
  <span class="award-corner top-right" aria-hidden="true"></span>
  <span class="award-corner bottom-left" aria-hidden="true"></span>
  <span class="award-corner bottom-right" aria-hidden="true"></span>
  <span class="award-rank" aria-hidden="true">{tier.rank}</span>
  <div class="award-emblem">
    <span class="award-spark spark-one" aria-hidden="true">✦</span>
    <span class="award-spark spark-two" aria-hidden="true">✦</span>
    <span class="award-spark spark-three" aria-hidden="true">✦</span>
    <ResponsiveImage
      class="award-medal"
      src={tier.badge}
      alt=""
      sizes="160px"
    />
  </div>
  <h3>{tier.label}</h3>
  <div class="award-divider" aria-hidden="true"></div>
  <ul class="awards-list">
    {awards.map((award) => <li>{award}</li>)}
  </ul>
</section>
<style>
  @font-face {
    font-family: 'ULP Arcade';
    src: url('/assets/fonts/press-start-2p/PressStart2P-Regular.ttf')
      format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  .award-card {
    position: relative;
    isolation: isolate;
    min-width: 0;
    padding: 26px 28px 32px;
    border: 1px solid color-mix(in srgb, var(--award-accent) 65%, transparent);
    border-radius: 6px;
    background:
      radial-gradient(
        ellipse at 50% 25%,
        color-mix(in srgb, var(--award-accent) 12%, transparent),
        transparent 65%
      ),
      #062d43;
    color: #f5f0e6;
    box-shadow:
      0 0 0 3px #062d43,
      0 0 0 4px color-mix(in srgb, var(--award-accent) 22%, transparent),
      0 16px 38px rgb(0 30 48 / 0.15);
    text-align: center;
    transition: box-shadow 250ms ease;
  }
  .award-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: repeating-linear-gradient(
      transparent 0 3px,
      rgb(0 8 20 / 0.12) 3px 4px
    );
    z-index: -1;
  }
  .award-card:hover {
    box-shadow:
      0 0 0 3px #062d43,
      0 0 0 4px var(--award-accent),
      0 12px 40px color-mix(in srgb, var(--award-accent) 18%, transparent);
  }
  .award-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: solid var(--award-accent);
    pointer-events: none;
  }
  .top-left {
    top: 7px;
    left: 7px;
    border-width: 2px 0 0 2px;
  }
  .top-right {
    top: 7px;
    right: 7px;
    border-width: 2px 2px 0 0;
  }
  .bottom-left {
    bottom: 7px;
    left: 7px;
    border-width: 0 0 2px 2px;
  }
  .bottom-right {
    bottom: 7px;
    right: 7px;
    border-width: 0 2px 2px 0;
  }
  .award-rank {
    display: inline-block;
    padding: 8px 12px;
    background: var(--award-accent);
    color: #062d43;
    font:
      10px/1.5 'ULP Arcade',
      monospace;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
  }
  .award-emblem {
    position: relative;
    width: 190px;
    max-width: 100%;
    margin: 12px auto 2px;
  }
  .award-medal {
    width: 160px;
    height: 160px;
    margin-inline: auto;
    object-fit: contain;
    filter: drop-shadow(
      0 0 16px color-mix(in srgb, var(--award-accent) 35%, transparent)
    );
    animation: medal-float 3.5s ease-in-out infinite;
  }
  .award-card--second .award-medal {
    animation-delay: -1s;
  }
  .award-card--third .award-medal {
    animation-delay: -2s;
  }
  h3 {
    font:
      12px/1.9 'ULP Arcade',
      monospace;
    color: var(--award-accent);
    overflow-wrap: anywhere;
    animation: title-glow 3s ease-in-out infinite;
  }
  .award-divider {
    height: 2px;
    margin: 22px 0;
    background: repeating-linear-gradient(
      to right,
      var(--award-accent) 0 5px,
      transparent 5px 10px
    );
    opacity: 0.45;
  }
  .awards-list {
    display: grid;
    gap: 12px;
    text-align: left;
  }
  .awards-list li {
    display: flex;
    gap: 10px;
    font-size: 13px;
    line-height: 1.7;
    color: rgb(245 240 230 / 0.9);
    overflow-wrap: anywhere;
  }
  .awards-list li::before {
    content: '▸';
    color: var(--award-accent);
    flex-shrink: 0;
  }
  .award-spark {
    position: absolute;
    color: var(--award-accent);
    font-size: 17px;
    animation: sparkle 3.2s ease-in-out infinite;
  }
  .spark-one {
    left: 6px;
    top: 24px;
  }
  .spark-two {
    right: 10px;
    top: 8px;
    animation-delay: -1.2s;
  }
  .spark-three {
    right: 0;
    bottom: 28px;
    animation-delay: -2.2s;
    font-size: 11px;
  }
  @keyframes medal-float {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-8px) rotate(2deg);
    }
  }
  @keyframes sparkle {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.7);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.15) rotate(15deg);
    }
  }
  @keyframes title-glow {
    0%,
    100% {
      text-shadow: 0 0 5px
        color-mix(in srgb, var(--award-accent) 15%, transparent);
    }
    50% {
      text-shadow: 0 0 16px
        color-mix(in srgb, var(--award-accent) 55%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .award-medal,
    .award-spark,
    h3 {
      animation: none;
    }
    .award-card {
      transition: none;
    }
  }
</style>
