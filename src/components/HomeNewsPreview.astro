---
import HomeSectionPattern from './HomeSectionPattern.astro';
import ArrowUpRight from './ArrowUpRight.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { getPublishedNews, formatNewsDate } from '../utils/news';

const stories = (await getPublishedNews()).slice(0, 2);
---

{
  stories.length > 0 && (
    <section
      class="home-news design-container"
      aria-labelledby="home-news-title"
    >
      <header class="home-news-heading">
        <HomeSectionPattern id="home-news-pattern" variant="arcs" />
        <div>
          <span class="design-eyebrow">El tablón de la ULP</span>
          <h2 id="home-news-title">
            Últimas <em>noticias.</em>
          </h2>
        </div>
        <a class="design-link" href="/blog">
          Todas las noticias{' '}
          <span aria-hidden="true">
            <ArrowUpRight />
          </span>
        </a>
      </header>
      <div class="home-news-list">
        {stories.map((entry) => (
          <article class="home-news-story">
            <a href={`/blog/${entry.id}`}>
              <div class="home-news-image">
                <ResponsiveImage
                  src={entry.data.image.src}
                  alt=""
                  sizes="(max-width: 500px) 76px, 104px"
                />
              </div>
              <div class="home-news-copy">
                <time datetime={entry.data.publishDate.toISOString()}>
                  {formatNewsDate(entry.data.publishDate)}
                </time>
                <h3>{entry.data.title}</h3>
                <span class="home-news-read">
                  Leer noticia{' '}
                  <span aria-hidden="true">
                    <ArrowUpRight />
                  </span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .home-news {
    padding-top: clamp(28px, 3.5vw, 44px);
    padding-bottom: clamp(20px, 2vw, 28px);
  }
  .home-news-heading,
  .home-news-list {
    max-width: 1240px;
    margin-inline: auto;
  }
  .home-news-heading {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 26px;
  }
  .design-eyebrow {
    font-size: 9px;
    margin-bottom: 13px;
  }
  h2 {
    font-size: clamp(29px, 3.5vw, 44px);
    font-weight: 750;
    line-height: 1.1;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .home-news-heading > a {
    font-size: 11px;
    white-space: nowrap;
  }
  .home-news-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .home-news-story {
    min-width: 0;
  }
  .home-news-story > a {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    align-items: center;
    gap: 20px;
    height: 100%;
    padding-block: 22px;
  }
  .home-news-image {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 12px;
    background: var(--surface);
  }
  .home-news-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .home-news-story a:hover .home-news-image :global(img),
  .home-news-story a:focus-visible .home-news-image :global(img) {
    transform: scale(1.06);
  }
  time {
    display: block;
    font-size: 10px;
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: 8px;
  }
  h3 {
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .home-news-read {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 10px;
    margin-top: 12px;
    color: var(--muted);
  }
  .home-news-read > span {
    transition: transform 200ms ease;
  }
  .home-news-story a:hover .home-news-read > span {
    transform: translate(2px, -2px);
  }
  @media (max-width: 700px) {
    .home-news-list {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .home-news-story + .home-news-story {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 500px) {
    .home-news-heading {
      align-items: start;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 20px;
    }
    .home-news-story > a {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 16px;
      padding-block: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-news-image :global(img),
    .home-news-read > span {
      transition: none;
      transform: none !important;
    }
  }
  @media (max-width: 700px) {
    .home-news {
      padding-block: 18px 32px;
    }
    .home-news-heading {
      flex-direction: row;
      align-items: end;
      gap: 12px;
      margin-bottom: 18px;
    }
    .home-news-heading > a {
      font-size: 10px;
      white-space: normal;
      max-width: 95px;
      text-align: right;
    }
    .home-news-heading h2 {
      font-size: 30px;
    }
    .home-news-list {
      border: 1px solid var(--line);
      border-radius: 16px;
      overflow: hidden;
      background: var(--surface);
    }
    .home-news-story > a {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
      padding: 16px;
    }
    .home-news-copy h3 {
      font-size: 15px;
      line-height: 1.35;
    }
    .home-news-copy time {
      font-size: 9px;
      margin-bottom: 5px;
    }
    .home-news-read {
      margin-top: 8px;
      font-size: 9px;
    }
  }
</style>
