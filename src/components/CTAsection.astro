---
import HomeSectionPattern from './HomeSectionPattern.astro';
import ArrowUpRight from './ArrowUpRight.astro';
import DiscordIcon from '../../public/assets/icons/DiscordIcon.astro';
---

<section class="community-cta design-container">
  <div class="community-panel">
    <div class="community-copy" data-reveal>
      <span class="design-eyebrow">Entre edición y edición</span>
      <h2>Seguimos jugando<br /><em>en el servidor de Discord</em></h2>
      <p>
        Busca equipo, comparte lo que juegas y sigue cerca de la comunidad hasta
        la próxima ULP.
      </p>
    </div>
    <div class="community-action">
      <HomeSectionPattern id="community-discord-pattern" variant="circuit" />
      <span class="discord-orbit" aria-hidden="true"><DiscordIcon /></span>
      <a
        href="https://discord.gg/FWW9wKZjav"
        class="discord-link"
        target="_blank"
        rel="noopener noreferrer"
        ><span>Entra al Discord de la ULP</span><span aria-hidden="true"
          ><ArrowUpRight /></span
        ></a
      >
      <span class="community-note">Tu comunidad, también entre partidas.</span>
    </div>
  </div>
</section>
<style>
  .community-cta {
    padding-block: 45px;
  }
  .community-panel {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
  }
  .community-copy {
    min-width: 0;
    container-type: inline-size;
    padding: clamp(30px, 4.5vw, 60px);
  }
  .community-copy .design-eyebrow {
    color: var(--muted);
    margin-bottom: 28px;
  }
  h2 {
    font-size: clamp(35px, 5.3vw, 72px);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }
  em {
    display: inline-block;
    white-space: nowrap;
    font-size: min(1em, 9cqi);
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .community-copy > p {
    max-width: 420px;
    font-size: 13px;
    line-height: 1.85;
    color: var(--muted);
    margin-top: 25px;
  }
  .community-action {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 25px;
    padding: 40px 28px;
    background: #062d43;
    color: #f5f0e6;
  }
  .discord-orbit {
    display: grid;
    place-items: center;
    width: 130px;
    height: 130px;
    border: 1px solid rgb(245 240 230 / 0.2);
    border-radius: 50%;
    box-shadow: 0 0 0 12px rgb(245 240 230 / 0.025);
  }
  .discord-orbit :global(svg) {
    width: 76px;
    height: 76px;
    transition: transform 250ms ease;
  }
  .community-action:hover .discord-orbit :global(svg) {
    transform: rotate(-7deg) scale(1.04);
  }
  .discord-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 48px;
    padding: 13px 18px;
    border-radius: 12px;
    background: #f5f0e6;
    color: #004465;
    font-size: 11px;
    font-weight: 650;
  }
  .discord-link:hover {
    background: #e8e1d5;
  }
  .community-note {
    font:
      8px/1.7 ui-monospace,
      monospace;
    opacity: 0.55;
    text-align: center;
  }
  @media (max-width: 1000px) {
    .community-panel {
      grid-template-columns: 1fr;
    }
    .community-action {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 25px;
      padding: 28px;
    }
    .discord-orbit {
      width: 66px;
      height: 66px;
      box-shadow: none;
    }
    .discord-orbit :global(svg) {
      width: 40px;
      height: 40px;
    }
    .community-note {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .community-cta {
      padding-block: 30px;
    }
    .community-action {
      padding: 24px;
      gap: 18px;
    }
    .discord-orbit {
      width: 48px;
      height: 48px;
      border: 0;
    }
    .discord-orbit :global(svg) {
      width: 38px;
      height: 38px;
    }
    .discord-link {
      font-size: 10px;
      gap: 14px;
      padding-inline: 12px;
    }
  }
</style>
