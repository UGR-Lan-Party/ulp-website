---
import ArrowUpRight from './ArrowUpRight.astro';
import TwitchIcon from '../../public/assets/icons/TwitchIcon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import latestStream from '../data/latest-stream.json';
const videoUrl = `https://www.twitch.tv/videos/${latestStream.videoId}`;
---

<section class="twitch-section design-section" aria-labelledby="twitch-title">
  <div class="design-container twitch-grid">
    <div class="twitch-copy" data-reveal>
      <span class="twitch-label"
        ><TwitchIcon width="23" height="23" aria-hidden="true" /> ULP en Twitch</span
      >
      <h2 id="twitch-title">Vive el evento<br /><em>en directo</em></h2>
      <p>
        Las finales, el ambiente y la entrega de premios. Vuelve al otro lado
        del directo con la última retransmisión disponible.
      </p>
      <a
        class="twitch-channel"
        title="Abre Twitch y pulsa Seguir para confirmar"
        href="https://www.twitch.tv/ugr_lan_party"
        target="_blank"
        rel="noopener noreferrer"
        >Sigue el canal <span aria-hidden="true"><ArrowUpRight /></span></a
      >
    </div>
    <div
      class="twitch-recording"
      data-twitch-recording
      data-video-id={latestStream.videoId}
    >
      <div class="twitch-player" data-twitch-player>
        <a
          class="twitch-preview"
          href={videoUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-twitch-play
        >
          <ResponsiveImage
            src={latestStream.thumbnail}
            alt="Vista previa de la retransmisión ULP 2026 en Twitch"
            sizes="(max-width: 900px) 90vw, 55vw"
          />
          <span class="twitch-play"
            ><svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"><path d="m9 5 11 7-11 7Z"></path></svg
            ></span
          >
          <span class="twitch-watch">Ver retransmisión</span>
          <span class="twitch-duration">{latestStream.duration}</span>
        </a>
      </div>
      <div class="twitch-caption">
        <span>Última retransmisión disponible</span><h3>
          {latestStream.title}
        </h3><a href={videoUrl} target="_blank" rel="noopener noreferrer"
          >Abrir en Twitch <ArrowUpRight /></a
        >
      </div>
    </div>
  </div>
</section>
<style>
  .twitch-section {
    padding-block: clamp(90px, 9vw, 120px);
    background:
      linear-gradient(
        to bottom,
        var(--paper),
        transparent 85px,
        transparent calc(100% - 85px),
        var(--paper)
      ),
      radial-gradient(ellipse at 15% 30%, #4a2575, transparent 65%), #291543;
    color: #f5f0e6;
  }
  .twitch-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.3fr;
    align-items: center;
    gap: clamp(35px, 5vw, 75px);
  }
  .twitch-label {
    display: flex;
    align-items: center;
    gap: 12px;
    font:
      10px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h2 {
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1.05;
    font-weight: 750;
    margin-block: 25px;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .twitch-copy p {
    font-size: 13px;
    line-height: 1.85;
    opacity: 0.75;
    max-width: 360px;
  }
  .twitch-channel {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    margin-top: 26px;
    padding: 13px 18px;
    border: 1px solid rgb(245 240 230 / 0.35);
    border-radius: 8px;
    font-size: 12px;
    transition: background 200ms ease;
  }
  .twitch-channel:hover {
    background: rgb(245 240 230 / 0.1);
  }
  .twitch-recording {
    overflow: hidden;
    border: 1px solid rgb(245 240 230 / 0.2);
    border-radius: 16px;
    background: rgb(0 0 0 / 0.18);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.12);
  }
  .twitch-player {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .twitch-preview {
    display: grid;
    place-items: center;
    position: absolute;
    inset: 0;
  }
  .twitch-preview::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgb(15 8 28 / 0.7),
      rgb(15 8 28 / 0.12) 65%
    );
  }
  .twitch-preview :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
  }
  .twitch-play {
    position: relative;
    z-index: 1;
    width: 65px;
    height: 65px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f5f0e6;
    color: #291543;
    transition: transform 200ms ease;
  }
  .twitch-preview:hover .twitch-play {
    transform: scale(1.1);
  }
  .twitch-watch,
  .twitch-duration {
    position: absolute;
    bottom: 17px;
    z-index: 1;
    font-size: 11px;
  }
  .twitch-watch {
    left: 20px;
    font-weight: 600;
  }
  .twitch-duration {
    right: 20px;
    padding: 4px 7px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.6);
    font-variant-numeric: tabular-nums;
  }
  .twitch-caption {
    padding: 20px 24px;
  }
  .twitch-caption > span {
    font:
      8px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }
  h3 {
    font-size: 15px;
    line-height: 1.5;
    font-weight: 650;
    margin-block: 9px 14px;
  }
  .twitch-caption a {
    font-size: 10px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .twitch-player:has(iframe) {
    min-height: 300px;
  }
  .twitch-player :global(iframe) {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    border: 0;
  }
  @media (max-width: 900px) {
    .twitch-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .twitch-copy p {
      max-width: 480px;
    }
  }
</style>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-twitch-recording]')
    .forEach((recording) => {
      const link =
        recording.querySelector<HTMLAnchorElement>('[data-twitch-play]')!;
      const player = recording.querySelector<HTMLElement>(
        '[data-twitch-player]',
      )!;
      link.addEventListener('click', (event) => {
        if (
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey ||
          player.clientWidth < 400
        )
          return;
        const videoId = recording.dataset.videoId;
        if (!videoId || !/^\d+$/.test(videoId)) return;
        event.preventDefault();
        const parameters = new URLSearchParams({
          video: `v${videoId}`,
          parent: location.hostname,
          autoplay: 'true',
          muted: 'false',
        });
        const iframe = document.createElement('iframe');
        iframe.title = 'Última retransmisión de UGR LAN Party en Twitch';
        iframe.src = `https://player.twitch.tv/?${parameters}`;
        iframe.allow = 'autoplay; fullscreen';
        iframe.allowFullscreen = true;
        player.replaceChildren(iframe);
        iframe.focus();
      });
    });
</script>
