---
import AwardCard from './AwardCard.astro';
import type { Awards } from '../data/competitions-data';
interface Props {
  competitionAwards: Awards;
}
const { competitionAwards } = Astro.props;
const mvpAwards = competitionAwards.mvp ?? [];
const positions = ['first', 'second', 'third'] as const;
const podium = positions.filter(
  (position) => competitionAwards[position].length > 0,
);
---

<div class="competition-awards" aria-label="Premios por puesto">
  <div
    class:list={['awards-grid', { 'full-podium': podium.length === 3 }]}
    style={`--award-columns:${podium.length};--award-max-width:${podium.length * 440}px`}
  >
    {
      podium.map((position) => (
        <AwardCard position={position} awards={competitionAwards[position]} />
      ))
    }
  </div>
  {
    mvpAwards.length > 0 && (
      <div class="mvp-award">
        <AwardCard position="mvp" awards={mvpAwards} />
      </div>
    )
  }
</div>
<style>
  .awards-grid {
    width: 100%;
    max-width: var(--award-max-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(var(--award-columns), minmax(0, 1fr));
    align-items: start;
    gap: 20px;
  }
  .mvp-award {
    max-width: 440px;
    margin: 24px auto 0;
  }
  @media (min-width: 901px) {
    .full-podium :global(.award-card--first) {
      grid-column: 2;
      grid-row: 1;
    }
    .full-podium :global(.award-card--second) {
      grid-column: 1;
      grid-row: 1;
      margin-top: 36px;
    }
    .full-podium :global(.award-card--third) {
      grid-column: 3;
      grid-row: 1;
      margin-top: 60px;
    }
  }
  @media (max-width: 900px) {
    .awards-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
