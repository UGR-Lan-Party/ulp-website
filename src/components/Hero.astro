---
import ResponsiveImage from './ResponsiveImage.astro';
import { edition } from '../data/edition';

const showCountdown =
  edition.startsAt &&
  ['announced', 'registration-open'].includes(edition.phase);
import { getFlickrPhotos } from '../utils/flickr.js';

const remoteImages = await getFlickrPhotos(
  '72177720316026867',
  '195749897@N03',
  {
    allowedIds: [
      '53635695855',
      '53635584524',
      '53635576249',
      '53635686025',
      '53635573539',
      '53635570934',
    ],
    landscape: true,
  },
);
const images = remoteImages.length
  ? remoteImages
  : ['/assets/about/sobre-nosotros.png'];
---

<style>
  .texto-centrado {
    text-align: center;
    padding: 0 20px;
  }

  .hero-bg {
    transition: opacity 1s ease-in-out;
  }
</style>

<section
  id="home"
  class="relative flex flex-col lg:flex-row items-center justify-center
         bg-gradient-to-bl from-[#01576C]/80 from-30% via-[#012C5F]/85 via-70% to-[#012C5F]/95
         min-h-[100svh]
         pt-28 md:pt-32 lg:pt-0
         pb-16 lg:pb-0
         -mt-12 lg:-mt-6
         overflow-hidden"
  data-images={JSON.stringify(images)}
>
  <div class="lg:w-1/2 flex flex-col items-center h-full max-w-[1000px]">
    <div
      class="absolute inset-0 min-h-full min-w-full -z-10"
      id="heroContainer"
    >
      <ResponsiveImage
        id="heroImage"
        loading="eager"
        fetchpriority="high"
        sizes="100vw"
        src={images[0]}
        alt=""
        class="w-full h-full object-cover hero-bg"
      />
    </div>
    <div
      class="relative z-10 w-full flex flex-col items-center justify-center text-center
            lg:min-h-[100svh] px-4 lg:mt-12"
    >
      <h1
        class="pt-3 mb-5 lg:mb-16 mt-8 text-3xl font-bold text-white sm:text-4xl lg:text-[3.5rem]"
      >
        UGR LAN PARTY
      </h1>

      <p
        class="texto-centrado mx-auto mb-6 max-w-[800px] font-medium text-white lg:text-2xl"
      >
        ¡El mayor evento universitario de eSports de Andalucía!
      </p>

      <div class="flex flex-col items-center gap-2">
        <p class="font-bold text-center text-white text-4xl">ULP 2027</p>

        <p class="mt-3 text-white/90">Próximamente ...</p>
      </div>

      {
        showCountdown && (
          <div
            id="countdown"
            data-starts-at={edition.startsAt}
            class="flex items-center justify-center px-5 py-5 my-6"
          >
            <div class="text-primary">
              <div class="text-5xl text-center flex w-full items-center justify-center gap-2">
                <div class="w-24 p-2 bg-white rounded-lg">
                  <div class="font-mono leading-none" id="days">
                    00
                  </div>
                  <div class="font-mono uppercase text-sm leading-none">
                    Días
                  </div>
                </div>
                <div class="w-20 p-2 bg-white rounded-lg">
                  <div class="font-mono leading-none" id="hours">
                    00
                  </div>
                  <div class="font-mono uppercase text-sm leading-none">
                    Horas
                  </div>
                </div>
                <div class="w-20 p-2 bg-white rounded-lg">
                  <div class="font-mono leading-none" id="minutes">
                    00
                  </div>
                  <div class="font-mono uppercase text-sm leading-none">
                    Minutos
                  </div>
                </div>
                <div class="w-20 p-2 bg-white rounded-lg">
                  <div class="font-mono leading-none" id="seconds">
                    00
                  </div>
                  <div class="font-mono uppercase text-sm leading-none">
                    Segundos
                  </div>
                </div>
              </div>
            </div>
          </div>
        )
      }

      <a
        href="/actividades"
        class="inline-flex w-40 items-center justify-center rounded-md bg-white py-[14px] px-7 text-dark shadow-md hover:bg-gray-2 mt-8"
      >
        Inscripciones
      </a>

      <div class="mt-0 flex justify-center items-center">
        <ResponsiveImage
          src="/assets/participan/organizan.png"
          loading="eager"
          alt="Organizaciones participantes"
          class="max-w-[100%] max-h-[200px] h-auto"
        />
      </div>
    </div>
  </div>
</section>

<script src="../scripts/countdown.js"></script>
<script>
  const section = document.getElementById('home');
  const image = document.getElementById('heroImage') as HTMLImageElement | null;
  const images: string[] = JSON.parse(section?.dataset.images ?? '[]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let index = 0;
  let rotationTimer: number | undefined;

  function updateRotation() {
    window.clearInterval(rotationTimer);
    if (reducedMotion.matches || images.length < 2 || !image) return;
    rotationTimer = window.setInterval(() => {
      if (document.hidden) return;
      index = (index + 1) % images.length;
      image.src = images[index];
    }, 5000);
  }
  reducedMotion.addEventListener('change', updateRotation);
  window.addEventListener('pagehide', () =>
    window.clearInterval(rotationTimer),
  );
  updateRotation();
</script>
