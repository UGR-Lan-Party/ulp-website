---
import type { SponsorData } from '../data/sponsors';
import PartnerLogo from './PartnerLogo.astro';
import SocialButton from './SocialButton.astro';
interface Props {
  partner: SponsorData;
  index: number;
}
const { partner, index } = Astro.props;
---

<section
  class="design-partner-card"
  data-partner-card
  data-reveal
  data-spotlight
>
  <div class="partner-card-top">
    <span>{String(index + 1).padStart(2, '0')}</span><span aria-hidden="true"
      >↗</span
    >
  </div>
  <div class="partner-card-logo">
    <PartnerLogo partner={partner} surface="light" width={230} height={100} />
  </div>
  <h3 data-name={partner.name.trim()}>{partner.name.trim()}</h3><p
    class="partner-card-type"
  >
    {partner.bussiness}
  </p><p class="partner-card-description">{partner.description}</p>
  <div class="partner-card-links">
    {
      partner.links.map((link) => (
        <SocialButton sponsorLink={link} monochrome compact />
      ))
    }
  </div>
</section>
<style>
  .design-partner-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 440px;
    padding: 25px;
    border: 1px solid rgb(245 240 230 / 0.16);
    border-radius: 16px;
    background:
      radial-gradient(
        220px circle at var(--pointer-x, 50%) var(--pointer-y, 0%),
        rgb(245 240 230 / 0.1),
        transparent
      ),
      #004465;
    color: #f5f0e6;
    overflow: hidden;
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }
  .design-partner-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 36px rgb(0 68 101 / 0.15);
  }
  .partner-card-top {
    display: flex;
    justify-content: space-between;
    font:
      10px ui-monospace,
      monospace;
    opacity: 0.55;
    margin-bottom: 20px;
  }
  .partner-card-logo {
    display: grid;
    place-items: center;
    height: 110px;
    background: #f5f0e6;
    border-radius: 10px;
    margin-bottom: 24px;
    padding: 20px;
  }
  .partner-card-logo :global(.partner-logo) {
    width: 100%;
    height: 70px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  h3 {
    font-size: 24px;
    line-height: 1.15;
    font-weight: 750;
    margin-bottom: 7px;
  }
  .partner-card-type {
    font-size: 10px;
    line-height: 1.5;
    opacity: 0.6;
    margin-bottom: 16px;
  }
  .partner-card-description {
    font-size: 12px;
    line-height: 1.75;
    opacity: 0.85;
    margin-bottom: 24px;
  }
  .partner-card-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 18px;
    border-top: 1px solid rgb(245 240 230 / 0.2);
    margin-top: auto;
  }
</style>
