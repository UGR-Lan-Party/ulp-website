---
import ArrowUpRight from './ArrowUpRight.astro';
import NewsCard from './NewsCard.astro';
import { getPublishedNews } from '../utils/news';
const stories = (await getPublishedNews()).slice(0, 3);
---

{
  stories.length > 0 && (
    <section class="design-section design-container">
      <div class="design-section-header">
        <div>
          <span class="design-eyebrow">Desde la ULP</span>
          <h2 class="design-heading">
            También tenemos
            <br />
            cosas que contar
          </h2>
        </div>
        <a href="/blog" class="design-link">
          Todas las noticias{' '}
          <span aria-hidden="true">
            <ArrowUpRight />
          </span>
        </a>
      </div>
      <div class="design-grid">
        {stories.map((entry) => (
          <NewsCard entry={entry} />
        ))}
      </div>
    </section>
  )
}
