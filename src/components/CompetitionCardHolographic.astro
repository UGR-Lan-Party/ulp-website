---
import ResponsiveImage from './ResponsiveImage.astro';
import type { CompetitionCardData } from '../data/competitions-data';
import artLayouts from '../data/activity-art-layout.json';
interface Props {
  competition: CompetitionCardData;
}
const { competition } = Astro.props;
const layout = artLayouts[competition.id as keyof typeof artLayouts];
const artStyle = `--art-aspect:${layout.aspect};--art-frame-width:${Math.min(84, 95 * layout.aspect)}%;--art-image-width:${layout.imageWidth}%;--art-image-height:${layout.imageHeight}%;--art-left:${layout.left}%;--art-top:${layout.top}%`;
const softenBottom = [
  'hacking',
  'league-of-legends',
  'futbolin',
  'f1',
].includes(competition.id);
---

<div
  id="holo-card"
  class="holographic-competition-card holo-animation"
  aria-hidden="true"
>
  <picture class="holographic-card">
    <ResponsiveImage
      src={competition.card}
      alt=""
      class="holographic-card-image"
      sizes="320px"
      loading="eager"
    />
  </picture>
  <div
    class:list={[
      'holographic-character',
      {
        'soft-bottom': softenBottom,
        'soft-sides': competition.id === 'futbolin',
      },
    ]}
    style={artStyle}
  >
    <ResponsiveImage
      src={competition.character}
      alt=""
      sizes="300px"
      loading="eager"
    />
  </div>
</div>
<script>
  import '../scripts/holoCardsInteraction.js';
</script>
<style>
  .holographic-competition-card {
    position: relative;
    width: min(100%, 320px);
    aspect-ratio: 4 / 5;
    transform-style: preserve-3d;
    transform: perspective(1500px);
    transition: transform 150ms ease-out;
  }
  .holographic-competition-card.holo-animation {
    animation: holo-card-drift 12s ease-in-out infinite;
  }
  .holographic-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid rgb(245 240 230 / 0.35);
    border-radius: 22px;
    background: #004465;
    transform: translateZ(-25px);
    box-shadow: 0 24px 48px -20px rgb(0 30 48 / 0.5);
  }
  .holographic-card::before,
  .holographic-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .holographic-card::before {
    z-index: 1;
    background: linear-gradient(
      115deg,
      transparent 15%,
      rgb(0 171 178 / 0.35) 35%,
      rgb(245 240 230 / 0.3) 45%,
      transparent 55%,
      rgb(111 175 202 / 0.25) 70%,
      transparent 85%
    );
    background-size: 250% 250%;
    background-position: var(--holo-x, 50%) var(--holo-y, 50%);
    mix-blend-mode: screen;
  }
  .holo-animation .holographic-card::before {
    animation: holo-sheen 12s ease-in-out infinite;
  }
  .holographic-card::after {
    z-index: 2;
    border-radius: inherit;
    box-shadow: inset 0 0 0 5px rgb(245 240 230 / 0.07);
    background: linear-gradient(
      180deg,
      rgb(0 68 101 / 0.08),
      transparent 40%,
      rgb(0 34 50 / 0.5)
    );
  }
  .holographic-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75) saturate(0.7);
  }
  .holographic-character {
    position: absolute;
    left: 50%;
    bottom: 10%;
    width: var(--art-frame-width);
    aspect-ratio: var(--art-aspect);
    transform: translateX(-50%) translateZ(40px);
    filter: drop-shadow(0 14px 18px rgb(0 22 36 / 0.3));
    pointer-events: none;
  }
  .holographic-character :global(img) {
    position: absolute;
    left: var(--art-left);
    top: var(--art-top);
    width: var(--art-image-width);
    height: var(--art-image-height);
    max-width: none;
    object-fit: contain;
  }
  .soft-bottom {
    --holo-bottom-mask: linear-gradient(
      to top,
      transparent,
      rgb(0 0 0 / 0.35) 8%,
      black 28%
    );
    mask-image: var(--holo-bottom-mask);
  }
  .soft-sides {
    mask-image:
      var(--holo-bottom-mask),
      linear-gradient(to right, transparent, black 9%, black 91%, transparent);
    mask-composite: intersect;
  }
  @keyframes holo-card-drift {
    0%,
    100% {
      transform: perspective(1500px) rotateX(2deg) rotateY(-5deg);
    }
    50% {
      transform: perspective(1500px) rotateX(-3deg) rotateY(6deg);
    }
  }
  @keyframes holo-sheen {
    0%,
    100% {
      background-position: 20% 30%;
    }
    50% {
      background-position: 80% 70%;
    }
  }
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .holographic-competition-card.holo-animation,
    .holo-animation .holographic-card::before {
      animation: none;
    }
    .holographic-competition-card {
      transform: none;
      transition: none;
    }
  }
</style>
