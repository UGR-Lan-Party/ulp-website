<dialog
  class="global-search"
  data-global-search
  aria-labelledby="global-search-title"
>
  <div class="search-topline">
    <span class="design-eyebrow">UGR LAN PARTY / EXPLORA</span><button
      type="button"
      data-search-close
      aria-label="Cerrar buscador">✕</button
    >
  </div>
  <h2 id="global-search-title">¿Necesitas <em>ayuda?</em></h2>
  <label class="search-field"
    ><svg viewBox="0 0 24 24" aria-hidden="true"
      ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"
      ></path></svg
    ><span class="sr-only">Buscar en la web</span><input
      type="search"
      data-search-input
      maxlength="160"
      placeholder="Horarios, ediciones, juegos, aulas…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="global-search-results"
    /><kbd>ESC</kbd></label
  >
  <p
    class="search-feedback"
    data-search-feedback
    role="status"
    aria-live="polite"
  >
    Escribe para encontrar tu sitio.
  </p>
  <ul
    id="global-search-results"
    data-search-results
    aria-label="Resultados de búsqueda"
  >
  </ul>
  <footer>
    <span>↑ ↓ para moverte · Enter para abrir</span><span>Ctrl / ⌘ K</span>
  </footer>
</dialog>
<script>
  import '../scripts/global-search';
</script>
<style>
  .global-search {
    width: min(680px, calc(100vw - 28px));
    max-height: min(760px, calc(100dvh - 36px));
    padding: 28px;
    margin: auto;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 100px #001b3660;
    overflow: auto;
  }
  .global-search::backdrop {
    background: #001c30a6;
    backdrop-filter: blur(7px);
  }
  .search-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }
  .design-eyebrow {
    font-size: 9px;
  }
  .search-topline button {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
  }
  h2 {
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 750;
    letter-spacing: -0.04em;
    margin: 12px 0 24px;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .search-field:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .search-field svg {
    width: 22px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  input {
    min-width: 0;
    width: 100%;
    background: transparent;
    border: 0;
    color: var(--ink);
    outline: none;
    font-size: 16px;
  }
  kbd {
    font-size: 9px;
    color: var(--muted);
  }
  .search-feedback {
    font-size: 12px;
    color: var(--muted);
    margin: 18px 0 10px;
  }
  ul {
    display: grid;
    gap: 6px;
  }
  ul :global(a) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 14px;
    padding: 13px 15px;
    border: 1px solid transparent;
    border-radius: 12px;
    transition: background 160ms;
  }
  ul :global(a:hover),
  ul :global(a:focus-visible) {
    background: var(--surface);
    border-color: var(--line);
    outline: none;
  }
  ul :global(strong) {
    font-size: 14px;
    font-weight: 650;
  }
  ul :global(p) {
    grid-column: 1/-1;
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  ul :global(small) {
    font-size: 10px;
    color: var(--muted);
    align-self: center;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 10px;
    color: var(--muted);
  }
  @media (max-width: 500px) {
    .global-search {
      padding: 20px;
    }
    footer span:last-child {
      display: none;
    }
  }
</style>
