---
import VenueAmenityMarker from './VenueAmenityMarker.astro';
import VenueDoor from './VenueDoor.astro';
import VenueSlidingDoor from './VenueSlidingDoor.astro';
import PrincipalAccessCore from './PrincipalAccessCore.astro';
import PrincipalWashrooms from './PrincipalWashrooms.astro';
import StudentRoom from './StudentRoom.astro';
import { isStudentRoomFurniture } from '../data/student-room';
import PrincipalRoom from './PrincipalRoom.astro';
import VenueFurniture from './VenueFurniture.astro';
import { isPrincipalRoomFurniture } from '../data/principal-rooms';
import { venueAmenities } from '../data/venue-amenities';
import aulaFixtures from '../data/venue-aula-fixtures.json';
import furniture from '../data/venue-furniture.json';
---

<defs>
  <linearGradient id="venue-desk-surface" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--paper)"></stop>
    <stop offset="1" stop-color="var(--ink)" stop-opacity=".16"></stop>
  </linearGradient>
  <linearGradient id="venue-seat-surface" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--ink)" stop-opacity=".22"></stop>
    <stop offset="1" stop-color="var(--ink)" stop-opacity=".06"></stop>
  </linearGradient>
</defs>

<g
  data-venue-floor-plan="principal-0"
  data-hidden
  transform="translate(185 110) scale(.55)"
>
  <path
    class="floor-outline"
    d="M124 85L247 14L317 132L421 68H884V850H124V435H156V326H197V208Z"></path>
  <path
    class="floor-wall"
    d="M156 435H276V850M124 549H276M124 629H276M455 130H559M421 68 492 202H559V308M559 68V202"
  ></path>
  <PrincipalWashrooms />
  <g data-principal-detail="ala-despachos" class="principal-context">
    <path
      class="floor-wall"
      d="M667 68V237M760 68V546M559 237H884M760 315H884M760 391H884M760 467H884M692 546H760V577L826 774H884M773.401 617H884M801.208 700H884M276 717H473V790H512V850M473 717H520L585 827V850"
    ></path>
    {
      [
        { x: 637, y: 237 },
        { x: 708, y: 237 },
        { x: 760, y: 274, angle: 90 },
        { x: 760, y: 350, angle: 90 },
        { x: 760, y: 426, angle: 90 },
        { x: 760, y: 501, angle: 90 },
        { x: 352, y: 717 },
      ].map((door) => <VenueDoor {...door} width={24} />)
    }
  </g>
  <g data-principal-detail="secretaria">
    <path class="floor-wall" d="M473 694L710 560L760 577M473 694V717"></path>
    <VenueDoor x={670} y={582.616} angle={150.52} width={32} />
  </g>
  <PrincipalRoom room="hall" />
  <path class="floor-wall" d="M274 326 345 285 292 199"></path>
  <PrincipalAccessCore />
  <VenueFurniture
    pieces={furniture['principal-0'].filter(
      (piece) => !isPrincipalRoomFurniture(piece, 'hall'),
    )}
  />
  <g class="principal-detail" data-principal-detail="planta-0">
    <VenueSlidingDoor x={345} y={115} angle={-31.6} width={40} />
    <VenueDoor x={156} y={342} angle={90} width={24} />
    <VenueDoor x={156} y={397} angle={90} width={24} />
    <VenueDoor x={276} y={529} angle={90} width={20} />
    <VenueDoor x={276} y={565} angle={90} width={26} />
    <VenueDoor x={276} y={679} angle={90} width={32} />
    <VenueDoor x={506} y={202} width={28} />
    <VenueDoor x={218} y={850} angle={180} width={36} />
  </g>
  {
    venueAmenities['principal-0']!.map((amenity) => (
      <VenueAmenityMarker
        {...amenity}
        size={amenity.kind === 'accessible' ? 16 : 22}
      />
    ))
  }
</g>
<g
  data-venue-floor-plan="principal-baja"
  data-hidden
  transform="translate(185 110) scale(.55)"
>
  <path class="floor-site" d="M274 327H124V850H770"></path>
  <path
    class="floor-outline"
    d="M124 85L247 14L317 132L421 68H884V850H770V691L692 546A186 186 0 1 1 336 440L274 327H197V208Z"
  ></path>
  <path
    class="floor-wall"
    d="M345 285 274 327M237 236H274L304 222 345 285M559 68V255M559 202H494L459 135M459 135 441 109M559 255V309"
  ></path>
  <PrincipalRoom room="salon-actos" />
  <PrincipalAccessCore />
  <StudentRoom />
  <VenueDoor x={559} y={255} angle={90} width={24} />
  <VenueDoor x={559} y={303} angle={-90} width={24} />
  <VenueFurniture
    pieces={furniture['principal-baja'].filter(
      (piece) =>
        !isPrincipalRoomFurniture(piece, 'salon-actos') &&
        !isStudentRoomFurniture(piece),
    )}
  />
  <g data-principal-access="aulas-inferiores">
    <title>Acceso a las aulas −1</title>
    <VenueDoor x={345} y={115} angle={-31.6} width={40} />
  </g>
  <g class="cafeteria-detail" data-principal-detail="cafeteria">
    <path class="floor-terrace" d="M904 105H995V600H904Z"></path>
    <path class="cafe-counter" d="M607 338V315H755V617H727V603H741V329H621V338Z"
    ></path>
    {
      [
        { x: 642, y: 133 },
        { x: 765, y: 133 },
        { x: 642, y: 231 },
        { x: 765, y: 231 },
      ].map((table) => (
        <g transform={`translate(${table.x} ${table.y})`} class="cafe-table">
          <rect
            class="floor-desk"
            x="-26"
            y="-17"
            width="52"
            height="34"
            rx="5"
          />
          <path class="table-seam" d="M0-17V17" />
          {[-1, 1].map((side) => (
            <rect
              class="floor-seat cafe-bench"
              x="-24"
              y={side === -1 ? -28 : 22}
              width="48"
              height="6"
              rx="3"
            />
          ))}
        </g>
      ))
    }
    {
      [350, 425, 500, 575, 650].map((y) => (
        <g transform={`translate(810 ${y})`} class="cafe-round-table">
          <circle class="floor-desk" r="17" />
          {[-1, 1].map((side) => (
            <>
              <rect
                class="floor-seat"
                x="-8"
                y={side === -1 ? -28 : 23}
                width="16"
                height="5"
                rx="2.5"
              />
              <rect
                class="floor-seat"
                x={side === -1 ? -28 : 23}
                y="-8"
                width="5"
                height="16"
                rx="2.5"
              />
            </>
          ))}
        </g>
      ))
    }
    {
      [165, 235, 305, 375, 445, 515].map((y) => (
        <g transform={`translate(950 ${y})`} class="terrace-table">
          <circle class="floor-desk" r="15" />
          <circle class="terrace-parasol" r="20" />
          <path class="table-seam" d="M-14-14 14 14M-14 14 14-14" />
          {[-1, 1].map((side) => (
            <>
              <rect
                class="floor-seat"
                x="-8"
                y={side === -1 ? -28 : 23}
                width="16"
                height="5"
                rx="2.5"
              />
              <rect
                class="floor-seat"
                x={side === -1 ? -28 : 23}
                y="-8"
                width="5"
                height="16"
                rx="2.5"
              />
            </>
          ))}
        </g>
      ))
    }
    <VenueDoor x={884} y={335} angle={90} width={36} />
    <VenueDoor x={884} y={613} angle={90} width={36} />
  </g>
  {
    venueAmenities['principal-baja']!.map((amenity) => (
      <VenueAmenityMarker {...amenity} size={22} />
    ))
  }
</g>
<g
  data-venue-floor-plan="aulas-inferiores"
  data-hidden
  transform="translate(185 178) scale(.55)"
>
  <path class="floor-wall" d="M500 0V194M500 264V458M489 527V625"></path>
  {
    aulaFixtures.inferiores.map(({ kind, ...fixture }) => (
      <rect
        class={`floor-${kind}`}
        data-venue-fixture={kind}
        {...fixture}
        rx={kind === 'column' ? 4 : Math.min(9, fixture.height / 2)}
      />
    ))
  }
  <g class="floor-fixed-label" transform="translate(250 -30)"
    ><g class="floor-upright"><text text-anchor="middle">Aula −1.1</text></g></g
  >
  <g class="floor-fixed-label" transform="translate(750 -30)"
    ><g class="floor-upright"><text text-anchor="middle">Aula −1.2</text></g></g
  >
</g>
{
  (['prefabricadas-a', 'prefabricadas-b'] as const).map((plan) => (
    <g
      data-venue-floor-plan={plan}
      data-hidden
      transform={
        plan === 'prefabricadas-b'
          ? 'translate(460 350) scale(.55) translate(-245 -312.5)'
          : 'translate(185 178) scale(.55)'
      }
    >
      {venueAmenities[plan]?.map((amenity) => (
        <VenueAmenityMarker {...amenity} size={22} />
      ))}
      {(plan === 'prefabricadas-a' ? [0, 1] : [0]).map((side) => (
        <g transform={`translate(${side * 510} 0) scale(.98 1)`}>
          <rect
            class="floor-room"
            x="0"
            y="0"
            width="500"
            height="625"
            rx="14"
          />
          <g class="floor-fixed-label" transform="translate(250 557)">
            <g class="floor-upright">
              <text text-anchor="middle">{`Aula ${plan === 'prefabricadas-a' ? 'A' : 'B'}${side + 1}`}</text>
            </g>
          </g>
          {(plan === 'prefabricadas-a' || side === 0) && (
            <>
              <path
                class="floor-projection"
                d={
                  plan === 'prefabricadas-a' && side === 0
                    ? 'M5 35 182 12M305 12 488 35'
                    : 'M5 35 182 12'
                }
              />
              {(plan === 'prefabricadas-a'
                ? aulaFixtures[side === 0 ? 'a1' : 'a2']
                : aulaFixtures.b1
              ).map(({ kind, ...fixture }) => (
                <rect
                  class={`floor-${kind}`}
                  data-venue-fixture={kind}
                  {...fixture}
                  rx={Math.min(9, fixture.height / 2)}
                />
              ))}
            </>
          )}
        </g>
      ))}
    </g>
  ))
}

<g
  data-venue-floor-plan="principal-hall"
  data-hidden
  transform="translate(460 350) scale(1.15) translate(-510 -490)"
>
  <PrincipalRoom room="hall" detailed />
</g>
<g
  data-venue-floor-plan="principal-actos"
  data-hidden
  transform="translate(460 350) scale(1.25) translate(-514 -493)"
>
  <PrincipalRoom room="salon-actos" detailed />
</g>
<style>
  [data-hidden] {
    display: none !important;
  }
  path,
  rect,
  circle {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cafe-counter {
    fill: url(#venue-desk-surface);
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.8;
  }
  .floor-terrace {
    fill: currentColor;
    fill-opacity: 0.025;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-dasharray: 4 5;
    opacity: 0.6;
  }
  .terrace-parasol {
    fill: currentColor;
    fill-opacity: 0.045;
    stroke: currentColor;
    stroke-width: 0.7;
    opacity: 0.5;
  }
  .table-seam {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.3;
  }
  .principal-context {
    opacity: 0.58;
  }
  .floor-room {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 4 7;
    opacity: 0.14;
  }
  .floor-site {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-dasharray: 4 7;
    opacity: 0.2;
    vector-effect: non-scaling-stroke;
  }
  .floor-fixed-label {
    fill: var(--ink);
    font:
      21px 'Inter Variable',
      sans-serif;
    font-weight: 600;
  }
  .floor-upright {
    transform: rotate(var(--venue-label-turn, 0deg));
  }
  .floor-subtitle {
    font-size: 15px;
    font-weight: 400;
    fill: var(--muted);
  }
  .floor-projection {
    fill: none;
    stroke: currentColor;
    stroke-width: 9;
    opacity: 0.25;
  }
  .floor-screen,
  .floor-door {
    fill: currentColor;
    fill-opacity: 0.1;
    stroke: currentColor;
    stroke-width: 0.7;
    vector-effect: non-scaling-stroke;
  }
  .floor-column {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .floor-outline {
    fill: color-mix(in srgb, var(--ink) 3%, var(--paper));
    stroke: currentColor;
    stroke-width: 1.8;
    vector-effect: non-scaling-stroke;
  }
  .floor-wall {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.05;
    vector-effect: non-scaling-stroke;
    opacity: 0.5;
  }
  .floor-desk {
    fill: url(#venue-desk-surface);
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.8;
  }
  .floor-seat {
    fill: url(#venue-seat-surface);
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.58;
  }
</style>
