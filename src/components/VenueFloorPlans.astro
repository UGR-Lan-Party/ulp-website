---
import VenueAmenityMarker from './VenueAmenityMarker.astro';
import { venueAmenities } from '../data/venue-amenities';
import aulaFixtures from '../data/venue-aula-fixtures.json';
import furniture from '../data/venue-furniture.json';
---

<defs>
  <linearGradient id="venue-desk-surface" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--paper)"></stop>
    <stop offset="1" stop-color="var(--ink)" stop-opacity=".16"></stop>
  </linearGradient>
  <linearGradient id="venue-seat-surface" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="var(--ink)" stop-opacity=".22"></stop>
    <stop offset="1" stop-color="var(--ink)" stop-opacity=".06"></stop>
  </linearGradient>
</defs>

<g
  data-venue-floor-plan="principal-0"
  transform="translate(185 110) scale(.55)"
>
  <path
    class="floor-site"
    d="M449 850H124V319H197V208L124 85 247 14 317 132 421 68 884 65V850H473"
  ></path>
  <path
    class="floor-outline"
    d="M124 85L247 14L317 132L421 68L492 202H559V308A186 186 0 1 1 473 670V717H276V850H124V435H156V326H197V208Z"
  ></path>
  <path
    class="floor-wall"
    d="M124 85 196 203 280 154M199 40 222 81 268 55M139 108 172 89M149 125 182 106M160 143 236 100M170 161 203 142M179 177 213 160M244 117 280 177M132 435H276V549H132M132 549H276V629H132M132 629H276V850M276 717H350M374 717H481L512 770M449 850V790H473V850M421 68 455 130H559M559 180V306M421 68 492 202H544"
  ></path>
  <path class="floor-wall" d="M559 308A186 186 0 1 1 350 416"></path>
  <path
    class="floor-wall"
    d="M274 326 345 285 292 199M237 326V236H197M489 202H542M557 177V309"></path>
  {
    furniture['principal-0'].map((piece) => (
      <rect
        class={piece.height < 12 ? 'floor-seat' : 'floor-desk'}
        x={-piece.width / 2}
        y={-piece.height / 2}
        width={piece.width}
        height={piece.height}
        rx={Math.min(8, piece.height / 2)}
        transform={`translate(${piece.x} ${piece.y}) rotate(${piece.angle})`}
      />
    ))
  }
  {
    venueAmenities['principal-0']!.map((amenity) => (
      <VenueAmenityMarker {...amenity} size={22} />
    ))
  }
</g>
<g
  data-venue-floor-plan="principal-baja"
  data-hidden
  transform="translate(185 110) scale(.55)"
>
  <path
    class="floor-site"
    d="M124 85 247 14 317 132 421 68H884V850H124V326H197V208Z"></path>
  <path
    class="floor-outline"
    d="M124 85L247 14L317 132L421 68H884V850H770V691L692 546A186 186 0 1 1 336 440L274 327H197V208Z"
  ></path>
  <path
    class="floor-wall"
    d="M197 208 286 153 345 285 274 327M197 238H237V326H131M237 276V236H274L304 222 345 285M559 68V255M559 202H494L459 135M459 135 441 109M559 255H579Q579 272 559 272Q579 272 579 291H559V309M274 327 336 440M276 770H559V850M613 645 654 723V850M692 546 770 691H884M770 691V850M770 770H884"
  ></path>
  <path class="floor-wall" d="M559 308A186 186 0 1 1 336 440"></path>
  <path class="floor-wall" d="M457 666 691 545"></path>
  {
    furniture['principal-baja'].map((piece) => (
      <rect
        class={piece.height < 12 ? 'floor-seat' : 'floor-desk'}
        x={-piece.width / 2}
        y={-piece.height / 2}
        width={piece.width}
        height={piece.height}
        rx={Math.min(8, piece.height / 2)}
        transform={`translate(${piece.x} ${piece.y}) rotate(${piece.angle})`}
      />
    ))
  }
  {
    venueAmenities['principal-baja']!.map((amenity) => (
      <VenueAmenityMarker {...amenity} size={22} />
    ))
  }
</g>
<g
  data-venue-floor-plan="aulas-inferiores"
  data-hidden
  transform="translate(185 178) scale(.55)"
>
  <path class="floor-wall" d="M500 0V194M500 264V458M489 527V625"></path>
  {
    aulaFixtures.inferiores.map(({ kind, ...fixture }) => (
      <rect
        class={`floor-${kind}`}
        data-venue-fixture={kind}
        {...fixture}
        rx={kind === 'column' ? 4 : Math.min(9, fixture.height / 2)}
      />
    ))
  }
  <g class="floor-fixed-label" transform="translate(250 -30)"
    ><g class="floor-upright"><text text-anchor="middle">Aula −1.1</text></g></g
  >
  <g class="floor-fixed-label" transform="translate(750 -30)"
    ><g class="floor-upright"><text text-anchor="middle">Aula −1.2</text></g></g
  >
</g>
{
  (['prefabricadas-a', 'prefabricadas-b'] as const).map((plan) => (
    <g
      data-venue-floor-plan={plan}
      data-hidden
      transform="translate(185 178) scale(.55)"
    >
      {venueAmenities[plan]?.map((amenity) => (
        <VenueAmenityMarker {...amenity} size={22} />
      ))}
      {[0, 1].map((side) => (
        <g transform={`translate(${side * 510} 0) scale(.98 1)`}>
          <rect
            class="floor-room"
            x="0"
            y="0"
            width="500"
            height="625"
            rx="14"
          />
          <g class="floor-fixed-label" transform="translate(250 557)">
            <g class="floor-upright">
              <text text-anchor="middle">{`Aula ${plan === 'prefabricadas-a' ? 'A' : 'B'}${side + 1}`}</text>
              {plan === 'prefabricadas-b' && side === 1 && (
                <text class="floor-subtitle" text-anchor="middle" y="25">
                  Interior sin confirmar
                </text>
              )}
            </g>
          </g>
          {(plan === 'prefabricadas-a' || side === 0) && (
            <>
              <path
                class="floor-projection"
                d={
                  plan === 'prefabricadas-a' && side === 0
                    ? 'M5 35 182 12M305 12 488 35'
                    : 'M5 35 182 12'
                }
              />
              {(plan === 'prefabricadas-a'
                ? aulaFixtures[side === 0 ? 'a1' : 'a2']
                : aulaFixtures.b1
              ).map(({ kind, ...fixture }) => (
                <rect
                  class={`floor-${kind}`}
                  data-venue-fixture={kind}
                  {...fixture}
                  rx={Math.min(9, fixture.height / 2)}
                />
              ))}
            </>
          )}
        </g>
      ))}
    </g>
  ))
}

<style>
  [data-hidden] {
    display: none !important;
  }
  path,
  rect,
  circle {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .floor-room {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 4 7;
    opacity: 0.14;
  }
  .floor-site {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-dasharray: 4 7;
    opacity: 0.2;
    vector-effect: non-scaling-stroke;
  }
  .floor-fixed-label {
    fill: var(--ink);
    font:
      21px 'Inter Variable',
      sans-serif;
    font-weight: 600;
  }
  .floor-upright {
    transform: rotate(var(--venue-label-turn, 0deg));
  }
  .floor-subtitle {
    font-size: 15px;
    font-weight: 400;
    fill: var(--muted);
  }
  .floor-projection {
    fill: none;
    stroke: currentColor;
    stroke-width: 9;
    opacity: 0.25;
  }
  .floor-screen,
  .floor-door {
    fill: currentColor;
    fill-opacity: 0.1;
    stroke: currentColor;
    stroke-width: 0.7;
    vector-effect: non-scaling-stroke;
  }
  .floor-column {
    fill: var(--paper);
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .floor-outline {
    fill: color-mix(in srgb, var(--ink) 3%, var(--paper));
    stroke: currentColor;
    stroke-width: 1.8;
    vector-effect: non-scaling-stroke;
  }
  .floor-wall {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.05;
    vector-effect: non-scaling-stroke;
    opacity: 0.5;
  }
  .floor-desk {
    fill: url(#venue-desk-surface);
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.8;
  }
  .floor-seat {
    fill: url(#venue-seat-surface);
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.58;
  }
</style>
