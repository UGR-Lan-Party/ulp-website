---
import ArrowUpRight from './ArrowUpRight.astro';
import { Competitions, CompetitionsCards } from '../data/competitions-data';
import PokemonCardFan from './PokemonCardFan.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import normalizedLogos from '../data/normalized-activity-logos.json';
import artLayouts from '../data/activity-art-layout.json';
interface Props {
  id: string;
  reveal?: boolean;
  sizes?: string;
}
const { id, reveal = true, sizes } = Astro.props;
const game = Competitions.find((game) => game.id === id)!;
const art = CompetitionsCards.find((game) => game.id === id)!;
const layout = artLayouts[id as keyof typeof artLayouts];
const photoPositions: Record<string, string> = {
  concierto: '50% 65%',
  'watch-party': '50% 43%',
  'juego-libre': '54% 65%',
  'indie-fest': '64% 56%',
};
const photoPosition = photoPositions[id];
const artStyle = `--art-aspect:${layout.aspect};--art-frame-width:${layout.frameWidth}%;--art-image-width:${layout.imageWidth}%;--art-image-height:${layout.imageHeight}%;--art-left:${layout.left}%;--art-top:${layout.top}%`;
const softenBottom = [
  'hacking',
  'league-of-legends',
  'futbolin',
  'f1',
].includes(id);
const labels: Record<string, string> = {
  competicion: 'Competición',
  reto: 'Reto',
  actividad: 'Actividad',
};
---

<a
  class:list={[
    'activity-tile',
    { 'activity-tile--photo': Boolean(photoPosition) },
  ]}
  style={photoPosition
    ? `--card-photo-position:${photoPosition};--card-background-scale:1.06`
    : undefined}
  href={`/actividades/${id}`}
  data-reveal={reveal || undefined}
>
  <div class="activity-tile-media">
    <ResponsiveImage
      src={art.card}
      alt=""
      sizes={sizes}
      class="activity-tile-background"
    />
    <div
      class:list={[
        'activity-tile-character',
        {
          'soft-bottom': softenBottom,
          'soft-sides': id === 'futbolin',
          'compact-art': id === 'cars',
          'racing-art': id === 'f1',
          'meal-art': id === 'paella',
          'concert-art': id === 'concierto',
        },
      ]}
      style={artStyle}
      aria-hidden="true"
    >
      {
        id === 'tcg' ? (
          <PokemonCardFan />
        ) : (
          <ResponsiveImage
            src={
              id === 'concierto'
                ? (normalizedLogos[
                    art.character as keyof typeof normalizedLogos
                  ] ?? art.character)
                : art.character
            }
            alt=""
            sizes={sizes}
          />
        )
      }
    </div>
    {
      id !== 'concierto' && (
        <ResponsiveImage
          src={
            normalizedLogos[art.logo as keyof typeof normalizedLogos] ??
            art.logo
          }
          alt=""
          class:list={[
            'activity-tile-logo',
            { 'activity-tile-emblem': art.logo.endsWith('.svg') },
          ]}
        />
      )
    }
    <span class="activity-tile-tag">{labels[game.tag] ?? game.tag}</span>
    <span class="activity-tile-arrow" aria-hidden="true"><ArrowUpRight /></span>
  </div>
  <div class="activity-tile-content">
    <h3>{game.name}</h3><p>{game.place || 'Descubre la actividad'}</p>
  </div>
</a>
<style>
  .concert-art :global(img) {
    filter: brightness(0) saturate(100%) invert(94%) sepia(7%) saturate(435%)
      hue-rotate(351deg) brightness(103%) contrast(93%);
  }
  .activity-tile {
    display: flex;
    width: 100%;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 16px;
    overflow: hidden;
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }
  .activity-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 32px rgb(0 68 101 / 0.12);
  }
  .activity-tile-media {
    perspective: 900px;
    position: relative;
    aspect-ratio: 1.35;
    overflow: hidden;
    background: #004465;
    isolation: isolate;
  }
  .activity-tile-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--card-photo-position, center 40%);
    opacity: 0.55;
    filter: saturate(0.55);
    transform-origin: center;
    transform: scale(var(--card-background-scale, 1.2));
    mask-image: linear-gradient(black 80%, transparent);
    transition:
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 600ms ease;
  }
  .activity-tile-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgb(0 68 101 / 0.15),
      transparent 50%,
      rgb(0 68 101 / 0.65)
    );
    pointer-events: none;
  }
  .activity-tile-media::before {
    content: '';
    position: absolute;
    inset: -100%;
    background: linear-gradient(
      110deg,
      transparent 45%,
      rgb(245 240 230 / 0.16),
      transparent 55%
    );
    transform: translateX(-40%);
    z-index: 3;
    transition: transform 800ms ease;
    pointer-events: none;
  }
  .activity-tile:hover .activity-tile-media::before {
    transform: translateX(40%);
  }
  .activity-tile-character {
    position: absolute;
    width: var(--art-frame-width);
    aspect-ratio: var(--art-aspect);
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%) translate3d(0, 5%, 0);
    z-index: 1;
    pointer-events: none;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 12px 16px rgb(0 0 0 / 0.25));
  }
  .activity-tile-character.soft-bottom {
    --art-bottom-mask: linear-gradient(
      to top,
      transparent,
      rgb(0 0 0 / 0.35) 8%,
      black 28%
    );
    mask-image: var(--art-bottom-mask);
  }
  .activity-tile-character.soft-sides {
    mask-image:
      var(--art-bottom-mask),
      linear-gradient(to right, transparent, black 9%, black 91%, transparent);
    mask-composite: intersect;
  }
  .activity-tile-character.compact-art {
    width: calc(var(--art-frame-width) * 0.8);
  }
  .activity-tile-character.meal-art {
    width: calc(var(--art-frame-width) * 0.94);
  }
  .activity-tile-character.racing-art {
    width: calc(var(--art-frame-width) * 1.1);
    bottom: 4%;
  }
  .activity-tile-character :global(img) {
    position: absolute;
    left: var(--art-left);
    top: var(--art-top);
    width: var(--art-image-width);
    height: var(--art-image-height);
    max-width: none;
    object-fit: contain;
  }
  .activity-tile:hover .activity-tile-character,
  .activity-tile:focus-visible .activity-tile-character {
    transform: translateX(-50%) translate3d(0, -2%, 24px) scale(1.02);
  }
  .activity-tile:hover .activity-tile-background,
  .activity-tile:focus-visible .activity-tile-background {
    transform: translateY(-2%) rotateX(5deg) scale(1.25);
    opacity: 0.4;
  }
  .activity-tile--photo:hover .activity-tile-background,
  .activity-tile--photo:focus-visible .activity-tile-background {
    transform: scale(1.1);
    opacity: 0.5;
  }
  .activity-tile-logo {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 100px;
    height: 50px;
    object-fit: contain;
    object-position: left top;
    z-index: 2;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .activity-tile-emblem {
    width: 36px;
    height: 36px;
  }
  .activity-tile-tag {
    position: absolute;
    bottom: 18px;
    left: 20px;
    font:
      9px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #f5f0e6;
    z-index: 2;
  }
  .activity-tile-arrow {
    position: absolute;
    bottom: 14px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #f5f0e6;
    border: 1px solid rgb(245 240 230 / 0.4);
    z-index: 2;
  }
  .activity-tile-media {
    flex-shrink: 0;
  }
  .activity-tile-logo {
    filter: drop-shadow(0 2px 3px rgb(0 20 35 / 0.85));
  }
  .activity-tile:focus-visible .activity-tile-arrow {
    background: #f5f0e6;
    color: #004465;
  }
  .activity-tile-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }
  h3 {
    font-size: 23px;
    font-weight: 750;
    line-height: 1.15;
    margin-bottom: 8px;
    min-height: 2.3em;
  }
  p {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.6;
    margin-top: auto;
  }
  .activity-tile:hover .activity-tile-logo,
  .activity-tile:focus-visible .activity-tile-logo {
    transform: translate3d(0, -5px, 35px);
  }
  @media (max-width: 600px) {
    .activity-tile-content {
      padding: 16px;
    }
    h3 {
      font-size: 21px;
      min-height: 0;
    }
    .activity-tile-logo {
      top: 16px;
      left: 16px;
      width: 96px;
      height: 46px;
    }
    .activity-tile:hover {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .activity-tile--photo .activity-tile-background,
    .activity-tile--photo:hover .activity-tile-background,
    .activity-tile--photo:focus-visible .activity-tile-background {
      transform: scale(1.06);
    }

    .activity-tile:hover .activity-tile-background,
    .activity-tile:focus-visible .activity-tile-background {
      transform: scale(1.2);
    }
    .activity-tile-character,
    .activity-tile:hover .activity-tile-character,
    .activity-tile:focus-visible .activity-tile-character {
      transform: translateX(-50%);
    }

    .activity-tile:hover .activity-tile-logo,
    .activity-tile:focus-visible .activity-tile-logo {
      transform: none;
    }
  }
</style>
