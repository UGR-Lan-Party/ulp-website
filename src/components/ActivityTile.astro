---
import { Competitions, CompetitionsCards } from '../data/competitions-data';
import ResponsiveImage from './ResponsiveImage.astro';
import artLayouts from '../data/activity-art-layout.json';
interface Props {
  id: string;
}
const { id } = Astro.props;
const game = Competitions.find((game) => game.id === id)!;
const art = CompetitionsCards.find((game) => game.id === id)!;
const layout = artLayouts[id as keyof typeof artLayouts];
const artStyle = `--art-aspect:${layout.aspect};--art-frame-width:${layout.frameWidth}%;--art-image-width:${layout.imageWidth}%;--art-image-height:${layout.imageHeight}%;--art-left:${layout.left}%;--art-top:${layout.top}%`;
const labels: Record<string, string> = {
  competicion: 'Competición',
  reto: 'Reto',
  actividad: 'Actividad',
};
---

<a class="activity-tile" href={`/actividades/${id}`} data-reveal>
  <div class="activity-tile-media">
    <ResponsiveImage src={art.card} alt="" class="activity-tile-background" />
    <div class="activity-tile-character" style={artStyle} aria-hidden="true">
      <ResponsiveImage src={art.character} alt="" />
    </div>
    <ResponsiveImage src={art.logo} alt="" class="activity-tile-logo" />
    <span class="activity-tile-tag">{labels[game.tag] ?? game.tag}</span>
    <span class="activity-tile-arrow" aria-hidden="true">↗</span>
  </div>
  <div class="activity-tile-content">
    <h3>{game.name}</h3><p>{game.place || 'Descubre la actividad'}</p>
  </div>
</a>
<style>
  .activity-tile {
    display: block;
    width: 100%;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 16px;
    overflow: hidden;
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }
  .activity-tile:hover {
    transform: translateY(-7px);
    box-shadow: 0 18px 32px rgb(0 68 101 / 0.12);
  }
  .activity-tile-media {
    perspective: 900px;
    position: relative;
    aspect-ratio: 1.35;
    overflow: hidden;
    background: #004465;
    isolation: isolate;
  }
  .activity-tile-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 0.55;
    filter: saturate(0.55);
    transform-origin: center;
    transform: scale(1.2);
    mask-image: linear-gradient(black 80%, transparent);
    transition:
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 600ms ease;
  }
  .activity-tile-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgb(0 68 101 / 0.15),
      transparent 50%,
      rgb(0 68 101 / 0.65)
    );
    pointer-events: none;
  }
  .activity-tile-media::before {
    content: '';
    position: absolute;
    inset: -100%;
    background: linear-gradient(
      110deg,
      transparent 45%,
      rgb(245 240 230 / 0.16),
      transparent 55%
    );
    transform: translateX(-40%);
    z-index: 3;
    transition: transform 800ms ease;
    pointer-events: none;
  }
  .activity-tile:hover .activity-tile-media::before {
    transform: translateX(40%);
  }
  .activity-tile-character {
    position: absolute;
    width: var(--art-frame-width);
    aspect-ratio: var(--art-aspect);
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%) translate3d(0, 5%, 0);
    z-index: 1;
    pointer-events: none;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 12px 16px rgb(0 0 0 / 0.25));
  }
  .activity-tile-character :global(img) {
    position: absolute;
    left: var(--art-left);
    top: var(--art-top);
    width: var(--art-image-width);
    height: var(--art-image-height);
    max-width: none;
    object-fit: contain;
  }
  .activity-tile:hover .activity-tile-character,
  .activity-tile:focus-visible .activity-tile-character {
    transform: translateX(-50%) translate3d(0, -5%, 60px) scale(1.03);
  }
  .activity-tile:hover .activity-tile-background,
  .activity-tile:focus-visible .activity-tile-background {
    transform: translateY(-2%) rotateX(18deg) scale(1.32);
    opacity: 0.4;
  }
  .activity-tile-logo {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 100px;
    height: 50px;
    object-fit: contain;
    object-position: left top;
    z-index: 2;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .activity-tile-tag {
    position: absolute;
    bottom: 18px;
    left: 20px;
    font:
      9px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #f5f0e6;
    z-index: 2;
  }
  .activity-tile-arrow {
    position: absolute;
    bottom: 14px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #f5f0e6;
    border: 1px solid rgb(245 240 230 / 0.4);
    z-index: 2;
  }
  .activity-tile-content {
    padding: 22px;
  }
  h3 {
    font-size: 23px;
    font-weight: 750;
    line-height: 1.15;
    margin-bottom: 10px;
  }
  p {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.6;
  }
  .activity-tile:hover .activity-tile-logo,
  .activity-tile:focus-visible .activity-tile-logo {
    transform: translate3d(0, -5px, 35px);
  }
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .activity-tile:hover .activity-tile-background,
    .activity-tile:focus-visible .activity-tile-background {
      transform: scale(1.2);
    }
    .activity-tile-character,
    .activity-tile:hover .activity-tile-character,
    .activity-tile:focus-visible .activity-tile-character {
      transform: translateX(-50%);
    }

    .activity-tile:hover .activity-tile-logo,
    .activity-tile:focus-visible .activity-tile-logo {
      transform: none;
    }
  }
</style>
