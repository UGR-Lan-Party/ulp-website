---
import CarouselSection from './CarouselSection.astro';
---

<section class="design-section design-container community-album">
  <header data-reveal>
    <div>
      <span class="design-eyebrow">Así se vive desde dentro</span><h2
        class="design-heading"
      >
        Una escuela.<br /><em>Muchas partidas.</em>
      </h2>
    </div><div class="album-intro">
      <p>
        Entre aulas, mandos y conversaciones nacen los mejores recuerdos de la
        ULP. Estas fotos nos devuelven a la edición de 2024.
      </p><a href="/info/ediciones_anteriores" class="design-link"
        >Todas nuestras ediciones <span aria-hidden="true">↗</span></a
      >
    </div>
  </header>
  <div class="album-frame">
    <div class="album-meta">
      <span>ULP 2024 / SEXTA EDICIÓN</span><span>ETSIIT · GRANADA</span>
    </div><CarouselSection
      albumId="72177720316026867"
      userId="195749897@N03"
      withBackground={false}
      height="380px"
    />
  </div>
</section>
<style>
  .community-album {
    padding-block: clamp(45px, 5vw, 70px);
  }
  header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: end;
    gap: 55px;
    margin-bottom: 38px;
  }
  .design-eyebrow {
    margin-bottom: 18px;
  }
  h2 {
    font-size: clamp(35px, 5vw, 65px);
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .album-intro {
    max-width: 370px;
    justify-self: end;
  }
  .album-intro p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.85;
    margin-bottom: 20px;
  }
  .album-intro .design-link {
    font-size: 11px;
  }
  .album-frame {
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 18px;
    background: var(--surface);
  }
  .album-meta {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .album-frame :global([data-photo-carousel]) {
    padding-block: 0;
  }
  .album-frame :global(.container) {
    padding-inline: 0;
  }
  @media (max-width: 700px) {
    header {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .album-intro {
      justify-self: start;
    }
    .album-frame {
      padding: 14px;
    }
    .album-meta {
      font-size: 7px;
    }
  }
</style>
