---
import VenueCampusModern from './VenueCampusModern.astro';
import {
  legacyAmphitheaterPath,
  campusPerimeterPath,
  legacyCampusPerimeterTransform,
  campusCourtyardWaterPath,
} from '../data/venue-campus-landscape';
import { modernPrincipalWing } from '../data/venue-campus-modern';
import VenueDoor from './VenueDoor.astro';
import VenueSlidingDoor from './VenueSlidingDoor.astro';
import VenuePingPongTable from './VenuePingPongTable.astro';
import VenueBenchesFurniture from './VenueBenchesFurniture.astro';
import VenueAmenityMarker from './VenueAmenityMarker.astro';
import trace from '../data/venue-campus-trace.json';
import {
  campusPrefabs,
  campusPrefabScale,
  campusParking as parking,
} from '../data/venue-map';

interface Props {
  modern?: boolean;
}
const { modern = false } = Astro.props;
const wingClipId = `campus-site-outside-wing-${modern ? 'modern' : 'legacy'}`;
const prefabWorldScale = 0.4 * campusPrefabScale;
const prefabColumns = [0, 90, 120, 210].flatMap((y) =>
  [0, 85].map((x) => ({ x, y })),
);

const retainedSiteClip =
  'M190 140H632V177H649L609 245H600V258H564Q558 282 529 283V289H528.3V406.14H530V443.5H485V550H190Z';
const parkingRows = Array.from({ length: 7 }, (_, index) => {
  const y = parking.y + 29 + index * 28;
  return {
    leftX:
      parking.leftTopX +
      ((y - parking.y) / parking.height) *
        (parking.leftBottomX - parking.leftTopX),
    rightX:
      parking.rightTopX +
      ((y - parking.y) / parking.height) *
        (parking.rightBottomX - parking.rightTopX),
    y,
  };
});
---

<g
  data-venue-floor-plan="recinto"
  data-campus-version={modern ? 'modern' : 'legacy'}
  class="campus-plan"
>
  <title>
    {
      modern
        ? 'Vista General de la ampliación de la ETSIIT'
        : 'Vista general de la ETSIIT y sus espacios exteriores'
    }
  </title>
  <path
    class="campus-perimeter"
    data-campus-perimeter
    transform={`rotate(180 460 350) ${modern ? '' : legacyCampusPerimeterTransform}`}
    d={campusPerimeterPath}></path>
  {
    modern ? (
      <VenueCampusModern />
    ) : (
      <path
        class="campus-garden"
        data-campus-amphitheater
        transform="rotate(180 460 350)"
        d={legacyAmphitheaterPath}
      />
    )
  }
  <path
    class="campus-courtyard-water"
    transform="rotate(180 460 350)"
    d={campusCourtyardWaterPath}
    data-campus-courtyard-fountain
    data-modern-patio-fountain={modern ? '' : undefined}></path>
  <g
    transform="rotate(180 460 350)"
    data-campus-principal-wing
    data-modern-principal-wing={modern ? '' : undefined}
  >
    <path class="campus-building-fill" d={modernPrincipalWing.fill}></path>
    <path class="campus-building-outline" d={modernPrincipalWing.outline}
    ></path>
    <path class="campus-building-partition" d={modernPrincipalWing.partition}
    ></path>
  </g>
  <defs>
    {
      modern && (
        <clipPath id="campus-retained-site">
          <path transform="rotate(180 460 350)" d={retainedSiteClip} />
        </clipPath>
      )
    }
    <clipPath id={wingClipId}>
      <path
        transform="rotate(180 460 350)"
        d={`M0 0H920V700H0Z${modernPrincipalWing.fill}`}
        clip-rule="evenodd"></path>
    </clipPath>
  </defs>
  <g data-campus-trace>
    <g clip-path={`url(#${wingClipId})`}>
      <path
        class="campus-site"
        data-campus-site-details
        d={trace.site}
        fill-rule="evenodd"
        clip-path={modern ? 'url(#campus-retained-site)' : undefined}></path>
    </g>
    <path
      class="campus-walls"
      data-campus-existing-buildings
      d={trace.walls}
      fill-rule="evenodd"></path>
  </g>
  <g transform="translate(106.4 60) scale(.4)">
    <path class="campus-walkway" d="M977 877H1195L1225 915H1360V980H977Z"
    ></path>
    <path
      class="campus-terrace"
      d="M1378 564.95H1381.30A586.74 586.74 0 0 1 1457.95 835.34H1378Z"></path>
    <VenuePingPongTable x={1120} y={905} scale={0.5} />
    <g data-campus-benches>
      <path class="campus-benches-floor" d="M912 405L984 363L1028 434L954 477Z"
      ></path>
      <g
        transform="translate(970 420) rotate(-30) scale(.16) translate(-460 -332.5)"
      >
        <VenueBenchesFurniture campus />
      </g>
    </g>
    {
      !modern && (
        <g>
          <g class="campus-parking" data-campus-parking>
            <path
              class="campus-parking-boundary"
              d={`M${parking.leftTopX} ${parking.y}H${parking.rightTopX}L${parking.rightBottomX} ${parking.y + parking.height}H${parking.leftBottomX}Z`}
            />
            {parkingRows.map(({ leftX, rightX, y }) => (
              <>
                <path
                  class="campus-parking-bay"
                  d={`M${leftX + 12} ${y}h50v-22`}
                />
                <path
                  class="campus-parking-bay"
                  d={`M${rightX - 12} ${y}h-50v-22`}
                />
              </>
            ))}
            <g data-campus-parking-entrance>
              <title>Acceso al parking</title>
              <VenueSlidingDoor
                x={217}
                y={parking.y + parking.height}
                width={48}
                label="Acceso al parking: puerta corredera"
              />
            </g>
          </g>
          {campusPrefabs.map((module) => (
            <g
              transform={`translate(${module.x} ${module.y}) rotate(28) translate(42.5 105) scale(${campusPrefabScale}) translate(-42.5 -105)`}
              data-campus-prefab={module.id}
              style={`--venue-label-offset: -28deg; --prefab-stroke-scale: ${1 / prefabWorldScale}`}
            >
              <rect class="campus-prefab" width="85" height="210" rx="0.4" />
              <path
                class="campus-partition"
                d="M0 90H85M0 120H85M35 90V120M0 105H35"
              />
              <g data-campus-door="entrance">
                <VenueDoor x={85} y={96} angle={90} width={18} />
              </g>
              <g data-campus-door="classroom-upper">
                <VenueDoor x={72} y={120} angle={180} width={18} />
              </g>
              <g data-campus-door="classroom-lower">
                <VenueDoor x={54} y={90} width={18} />
              </g>
              <g data-campus-door="women">
                <VenueDoor x={35} y={91.5} angle={90} width={12} />
              </g>
              <g data-campus-door="men">
                <VenueDoor x={35} y={106.5} angle={90} width={12} />
              </g>
              <g data-prefab-structural-columns>
                {prefabColumns.map(({ x, y }) => (
                  <rect
                    class="campus-structural-column"
                    x={x - 1.05 / prefabWorldScale}
                    y={y - 1.05 / prefabWorldScale}
                    width={2.1 / prefabWorldScale}
                    height={2.1 / prefabWorldScale}
                    rx={0.18 / prefabWorldScale}
                  />
                ))}
              </g>
              <VenueAmenityMarker
                kind="men"
                label="Aseo de hombres"
                x={17.5}
                y={112.5}
                size={9}
              />
              <VenueAmenityMarker
                kind="women"
                label="Aseo de mujeres"
                x={17.5}
                y={97.5}
                size={9}
              />
            </g>
          ))}
        </g>
      )
    }
  </g>
</g>
<style>
  [data-hidden] {
    display: none !important;
  }
  .campus-plan {
    --venue-door-opening-width: 2;
    color: var(--ink);
  }
  path,
  rect,
  circle {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .campus-perimeter {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.65;
    opacity: 0.35;
  }
  .campus-garden {
    fill: #dce9cf;
  }
  .campus-courtyard-water {
    fill: #d4e2e5;
    stroke: none;
  }
  .campus-site {
    fill: currentColor;
    opacity: 0.48;
  }
  .campus-walls {
    fill: currentColor;
    opacity: 0.9;
  }
  .campus-walkway {
    fill: currentColor;
    fill-opacity: 0.035;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
  }
  .campus-terrace {
    fill: currentColor;
    fill-opacity: 0.04;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
  }
  .campus-benches-floor {
    fill: var(--venue-plan-background, var(--paper));
    stroke: currentColor;
    stroke-width: 2;
  }
  .campus-prefab {
    fill: var(--venue-plan-background, var(--paper));
    stroke: currentColor;
    stroke-width: calc(0.8px * var(--prefab-stroke-scale));
    stroke-opacity: 0.9;
  }
  .campus-parking-boundary {
    fill: currentColor;
    fill-opacity: 0.025;
    stroke: currentColor;
    stroke-width: 2;
  }
  .campus-parking-bay {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    opacity: 0.5;
  }
  .campus-partition {
    fill: none;
    stroke: currentColor;
    stroke-width: calc(0.52px * var(--prefab-stroke-scale));
    opacity: 0.75;
  }
  .campus-building-fill {
    fill: var(--venue-plan-background, var(--paper));
    stroke: none;
  }
  .campus-building-outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-opacity: 0.9;
  }
  .campus-building-partition {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.52;
    opacity: 0.75;
  }
  .campus-structural-column {
    fill: currentColor;
    stroke: none;
    opacity: 0.9;
  }
</style>
