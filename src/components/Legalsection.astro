---
import { getEntry } from 'astro:content';
const legalContent = await getEntry('legal', 'legal');
const sections = legalContent?.data.sections ?? [];
---

<div class="design-container legal-layout">
  <aside class="legal-index">
    <span class="design-eyebrow">En esta página</span><nav
      aria-label="Apartados del aviso legal"
    >
      {
        sections.map((section, index) => (
          <a href={`#legal-${index + 1}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {section.title}
          </a>
        ))
      }
    </nav><a class="legal-contact" href="/contacto"
      >¿Necesitas contactar?<span aria-hidden="true">↗</span></a>
  </aside>
  <div class="legal-sections">
    {
      sections.length ? (
        sections.map((section, index) => (
          <section
            id={`legal-${index + 1}`}
            class="legal-card"
            aria-labelledby={`legal-title-${index + 1}`}
          >
            <>
              <span class="legal-number">
                {String(index + 1).padStart(2, '0')} / UGR LAN PARTY
              </span>
              <h2 id={`legal-title-${index + 1}`}>{section.title}</h2>
              <div>
                {section.content
                  .split(/\n+/)
                  .filter(Boolean)
                  .map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
              </div>
            </>
          </section>
        ))
      ) : (
        <p>No se encontraron secciones.</p>
      )
    }
  </div>
</div>
<style>
  .legal-layout {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: clamp(35px, 5vw, 70px);
    padding-block: 45px 85px;
    align-items: start;
  }
  .legal-index {
    position: sticky;
    top: 115px;
  }
  .legal-index .design-eyebrow {
    font-size: 9px;
    margin-bottom: 20px;
  }
  nav {
    display: grid;
    border-top: 1px solid var(--line);
  }
  nav a {
    display: flex;
    align-items: start;
    gap: 12px;
    padding-block: 15px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    line-height: 1.7;
  }
  nav a > span {
    font:
      9px/1.9 ui-monospace,
      monospace;
    opacity: 0.5;
    flex-shrink: 0;
  }
  nav a:hover {
    color: var(--muted);
  }
  .legal-contact {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 22px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    font-size: 11px;
    background: var(--surface);
  }
  .legal-sections {
    display: grid;
    gap: 22px;
  }
  .legal-card {
    padding: clamp(24px, 4vw, 45px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    scroll-margin-top: 24px;
  }
  .legal-number {
    display: block;
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 20px;
  }
  h2 {
    font-size: clamp(23px, 2.5vw, 32px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }
  .legal-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }
  .legal-card p + p {
    margin-top: 18px;
  }
  @media (max-width: 900px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .legal-index {
      position: static;
    }
    nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 20px;
    }
  }
  @media (max-width: 700px) {
    nav {
      grid-template-columns: 1fr;
    }
    .legal-layout {
      padding-top: 30px;
    }
  }
</style>
