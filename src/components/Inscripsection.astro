---
import ArrowUpRight from './ArrowUpRight.astro';
import { edition } from '../data/edition';
interface Props {
  registrationLink?: string;
  activityId?: string;
  activityYear?: number;
  participantsLink?: string;
  registrationPeriodOpen?: boolean;
}
const {
  registrationLink,
  activityId,
  activityYear = edition.year,
  participantsLink,
  registrationPeriodOpen = false,
} = Astro.props;
const isCurrentEdition = activityYear === edition.year;
const archiveUrl =
  activityYear === 2026
    ? '/horarios'
    : isCurrentEdition
      ? edition.archiveUrl
      : `/ediciones/${activityYear}`;
const isOpen = Boolean(
  isCurrentEdition &&
  edition.phase === 'registration-open' &&
  registrationPeriodOpen &&
  registrationLink,
);
const isFinished = !isCurrentEdition || edition.phase === 'finished';
const canJoinOnSite =
  isCurrentEdition &&
  !registrationLink &&
  ['registration-open', 'live'].includes(edition.phase);
const title = isFinished
  ? `Actividad de ULP ${activityYear}`
  : isOpen
    ? 'Inscripciones abiertas'
    : canJoinOnSite
      ? 'Participa durante el evento'
      : edition.phase === 'announced'
        ? 'Inscripciones aún no disponibles'
        : 'Inscripciones cerradas';
---

<aside class="registration-card" aria-label="Inscripción">
  <div class="registration-copy">
    <span class="registration-indicator" aria-hidden="true"></span>
    <div>
      <h2>{title}</h2>
      {
        isFinished && (
          <p>
            Esta edición ha finalizado y las inscripciones están cerradas. La
            información se conserva como archivo.
          </p>
        )
      }
      {
        canJoinOnSite && (
          <p>Pásate por la ubicación y participa el mismo día del evento.</p>
        )
      }
    </div>
  </div>
  {
    isOpen && (
      <a
        href={registrationLink}
        data-analytics-event="registration-click"
        data-analytics-edition={activityYear}
        data-analytics-activity={activityId}
        class="registration-action"
      >
        Inscribirme{' '}
        <span aria-hidden="true">
          <ArrowUpRight />
        </span>
      </a>
    )
  }
  {
    isFinished && (
      <a href={archiveUrl} class="registration-action">
        {activityYear === 2026
          ? 'Consultar horarios'
          : `Consultar edición ${activityYear}`}{' '}
        <span aria-hidden="true">
          <ArrowUpRight />
        </span>
      </a>
    )
  }
  {
    !isFinished && !isOpen && participantsLink && (
      <a href={participantsLink} class="registration-action">
        Consultar participantes{' '}
        <span aria-hidden="true">
          <ArrowUpRight />
        </span>
      </a>
    )
  }
</aside>
<style>
  .registration-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 26px;
    margin-bottom: 32px;
    border: 1px solid rgb(245 240 230 / 0.25);
    border-radius: 16px;
    background: #004465;
    color: #f5f0e6;
  }
  .registration-copy {
    display: flex;
    gap: 14px;
    align-items: baseline;
    min-width: 0;
  }
  .registration-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(245 240 230 / 0.75);
    flex-shrink: 0;
  }
  h2 {
    font-size: 15px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  p {
    margin-top: 5px;
    color: rgb(245 240 230 / 0.75);
    font-size: 12px;
    line-height: 1.7;
  }
  .registration-action {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid rgb(245 240 230 / 0.3);
    border-radius: 8px;
    color: inherit;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 200ms ease;
  }
  .registration-action:hover {
    background: rgb(245 240 230 / 0.1);
  }
  @media (max-width: 650px) {
    .registration-card {
      align-items: stretch;
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }
  }
</style>
