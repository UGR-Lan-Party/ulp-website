---
import { edition } from '../data/edition';

const {
  registrationLink,
  activityId,
  activityYear = edition.year,
  participantsLink,
  background_img,
  registrationPeriodOpen,
} = Astro.props;
const isCurrentEdition = activityYear === edition.year;
const archiveUrl = isCurrentEdition
  ? edition.archiveUrl
  : `/ediciones/${activityYear}`;
const isOpen =
  isCurrentEdition &&
  edition.phase === 'registration-open' &&
  registrationPeriodOpen &&
  registrationLink;
const isFinished = !isCurrentEdition || edition.phase === 'finished';
const canJoinOnSite =
  isCurrentEdition &&
  !registrationLink &&
  ['registration-open', 'live'].includes(edition.phase);
const title = isFinished
  ? `Actividad de ULP ${activityYear}`
  : isOpen
    ? 'Inscripciones abiertas'
    : canJoinOnSite
      ? 'Participa durante el evento'
      : edition.phase === 'announced'
        ? 'Inscripciones aún no disponibles'
        : 'Inscripciones cerradas';
---

<section
  class="relative w-full overflow-hidden bg-gradient-to-bl from-primary/80 via-secondary/85 to-tertiary/95 py-20 text-center text-white lg:py-28"
>
  {
    background_img && (
      <img
        src={background_img}
        alt=""
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
    )
  }
  <div class="container relative z-10 mx-auto px-6">
    <h2 class="mb-6 text-3xl font-bold">{title}</h2>
    {
      isFinished && (
        <p>
          Esta edición ha finalizado. La información se conserva como archivo.
        </p>
      )
    }
    {
      canJoinOnSite && (
        <p>Pásate por la ubicación y participa el mismo día del evento.</p>
      )
    }
    {
      isOpen && (
        <a
          href={registrationLink}
          data-analytics-event="registration-click"
          data-analytics-edition={activityYear}
          data-analytics-activity={activityId}
          class="mt-6 inline-block rounded-md bg-white px-7 py-3 text-dark"
        >
          Inscribirme
        </a>
      )
    }
    {
      isFinished && (
        <a
          href={archiveUrl}
          class="mt-6 inline-block rounded-md bg-white px-7 py-3 text-dark"
        >
          Consultar edición {activityYear}
        </a>
      )
    }
    {
      !isFinished && !isOpen && participantsLink && (
        <a
          href={participantsLink}
          class="mt-6 inline-block rounded-md bg-white px-7 py-3 text-dark"
        >
          Consultar participantes
        </a>
      )
    }
  </div>
</section>
