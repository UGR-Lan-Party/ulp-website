---
import ArrowUpRight from './ArrowUpRight.astro';
import LocationMapPreview from './LocationMapPreview.astro';
---

<section class="design-section design-container location-section">
  <div class="location-copy" data-reveal>
    <span class="design-eyebrow">El punto de encuentro</span>
    <h2>Nos vemos<br /><em>en la ETSIIT</em></h2>
    <p>
      Las actividades de la ULP se celebran en la Escuela Técnica Superior de
      Ingenierías Informática y de Telecomunicación de la Universidad de
      Granada.
    </p>
    <div class="location-address">
      <span>01 / DESTINO</span><strong>ETSIIT · Universidad de Granada</strong
      ><p>
        Calle Periodista Daniel Saucedo Aranda, s/n<br />La Chana · 18014
        Granada
      </p>
    </div>
    <div class="location-actions">
      <a
        class="design-button"
        href="https://maps.app.goo.gl/8c9WLkYAiw6cJRgu7"
        target="_blank"
        rel="noopener noreferrer"
        >Cómo llegar <span aria-hidden="true"><ArrowUpRight /></span></a
      ><a class="design-link" href="/info/horarios"
        >Consulta el programa <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
  <div class="location-map" data-reveal><LocationMapPreview /></div>
</section>
<style>
  .location-section {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 0.9fr 1.2fr;
    gap: clamp(35px, 5vw, 75px);
    align-items: center;
  }
  .design-eyebrow {
    margin-bottom: 25px;
  }
  h2 {
    font-size: clamp(38px, 5.5vw, 74px);
    font-weight: 750;
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin-bottom: 25px;
  }
  em {
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .location-copy > p {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 430px;
  }
  .location-address {
    border-left: 2px solid var(--accent);
    padding: 4px 0 4px 20px;
    margin-block: 28px;
  }
  .location-address > span {
    display: block;
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .location-address strong {
    font-size: 19px;
    font-weight: 650;
  }
  .location-address p {
    font-size: 12px;
    line-height: 1.9;
    margin-top: 9px;
    color: var(--muted);
  }
  .location-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
  }
  .location-actions .design-link {
    font-size: 11px;
  }
  .location-map {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .location-section {
      grid-template-columns: 1fr;
    }
  }
</style>
