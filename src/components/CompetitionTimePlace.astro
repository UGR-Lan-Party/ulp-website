---
interface ScheduleItem {
  time: string;
  round: string;
}
interface Props {
  place: string;
  time: ScheduleItem[];
}
const { place, time } = Astro.props;
const hasPlace = Boolean(place.trim());
const hasSchedule = time.length > 0;
---

<dl class="activity-facts">
  <div class="activity-fact">
    <dt>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
        ><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle
          cx="12"
          cy="10"
          r="2.5"></circle></svg
      >Ubicación
    </dt>
    <dd class="activity-place">{hasPlace ? place : 'Zona por determinar'}</dd>
  </div>
  <div class="activity-fact">
    <dt>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="9"></circle><path d="M12 6v6l4 2"
        ></path></svg
      >Horario
    </dt>
    <dd>
      {
        hasSchedule ? (
          <ul class="schedule-list">
            {time.map((item) => (
              <li>
                <span class="schedule-time">{item.time}</span>
                {item.round && <span class="schedule-round">{item.round}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="activity-place">Por determinar</p>
        )
      }
    </dd>
  </div>
</dl>
<style>
  .activity-facts {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 28px;
    min-width: 0;
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid rgb(245 240 230 / 0.18);
    border-radius: 20px;
    background: linear-gradient(135deg, #004465, #063349);
    color: #f5f0e6;
  }
  .activity-fact + .activity-fact {
    border-left: 1px solid rgb(245 240 230 / 0.2);
    padding-left: 28px;
  }
  dt {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: rgb(245 240 230 / 0.72);
    font:
      10px/1.5 ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  dt svg {
    flex-shrink: 0;
  }
  .activity-place {
    font-size: clamp(18px, 1.7vw, 23px);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .schedule-list {
    display: grid;
    gap: 16px;
  }
  .schedule-list li {
    display: grid;
    gap: 5px;
  }
  .schedule-list li + li {
    padding-top: 16px;
    border-top: 1px solid rgb(245 240 230 / 0.15);
  }
  .schedule-time {
    font-size: 14px;
    font-weight: 650;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .schedule-round {
    font-size: 12px;
    line-height: 1.6;
    color: rgb(245 240 230 / 0.72);
  }
  @media (max-width: 580px) {
    .activity-facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .activity-fact + .activity-fact {
      border-left: 0;
      border-top: 1px solid rgb(245 240 230 / 0.2);
      padding-left: 0;
      padding-top: 24px;
    }
  }
</style>
