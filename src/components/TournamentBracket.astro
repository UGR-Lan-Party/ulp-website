---
import '../styles/tournament-board.css';
import type { TournamentBracket } from '../data/tournaments';
interface Props {
  bracket: TournamentBracket;
  expanded?: boolean;
}
const { bracket, expanded = false } = Astro.props;
---

<details class="bracket" open={expanded} data-bracket>
  <summary>{bracket.name}<span aria-hidden="true">+</span></summary>
  <div
    class="bracket-scroll"
    tabindex="0"
    role="region"
    aria-label={`Cuadro ${bracket.name}. Desplázate para ver todas las rondas.`}
  >
    <div class="bracket-board" style={`--rounds: ${bracket.rounds.length}`}>
      <svg class="bracket-lines" aria-hidden="true" data-bracket-lines></svg>
      {
        bracket.rounds.map((round, roundIndex) => (
          <section class="bracket-round" aria-label={round.name}>
            <h3
              class:list={[
                'tournament-round-heading',
                { 'is-final': round.name === 'Final' },
              ]}
            >
              <span class="tournament-round-index" aria-hidden="true">
                {String(roundIndex + 1).padStart(2, '0')}
              </span>
              <span>
                {round.name}
                <small>
                  {round.matches.length}{' '}
                  {round.matches.length === 1 ? 'cruce' : 'cruces'} · Resultados
                </small>
              </span>
            </h3>
            <div class="bracket-round-matches">
              {round.matches.map((match, matchIndex) => (
                <article
                  class="bracket-match tournament-match"
                  data-match-id={match.id}
                  data-next-match={match.nextId}
                  aria-label={`${match.players[0]} contra ${match.players[1]}: ${match.scores[0]} a ${match.scores[1]}`}
                >
                  <header class="tournament-match-meta">
                    <span>
                      Encuentro {String(matchIndex + 1).padStart(2, '0')}
                    </span>
                    <span>{match.winner ? 'Finalizado' : 'Pendiente'}</span>
                  </header>
                  {match.players.map((player, index) => (
                    <div
                      class:list={[
                        'bracket-player tournament-team',
                        { 'is-winner': match.winner === player },
                      ]}
                    >
                      <span class="tournament-team-badge" aria-hidden="true">
                        {player === 'TBD'
                          ? '?'
                          : player.slice(0, 2).toUpperCase()}
                      </span>
                      <span class="tournament-team-name">
                        {player}
                        <span class="sr-only">
                          {match.winner === player ? ', gana' : ''}
                        </span>
                      </span>
                      <strong class="tournament-score">
                        {match.scores[index]}
                      </strong>
                    </div>
                  ))}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</details>
<script>
  import '../scripts/tournament-bracket';
</script>
<style>
  .bracket {
    margin-top: 18px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    font-size: 14px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary > span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 18px;
    font-weight: 400;
    transition: transform 0.2s;
  }
  [open] > summary > span {
    transform: rotate(45deg);
  }
  summary:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
  }
  @media (max-width: 500px) {
    summary {
      padding: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bracket-match,
    summary > span {
      transition: none;
      transform: none !important;
    }
  }
</style>
