---
import LinktreeIcon from '../../public/assets/icons/LinktreeIcon.astro';
---

<a
  class="linktree-card design-container"
  href="https://linktr.ee/ulpugr"
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="linktree-symbol" aria-hidden="true"><LinktreeIcon /></span>
  <span class="linktree-copy"
    ><strong>Un enlace. Toda la ULP.</strong><span
      >Redes, comunidad y novedades en nuestro Linktree.</span
    ></span
  >
  <span class="linktree-action"
    >Abre Linktree <span aria-hidden="true">↗</span></span
  >
</a>
<style>
  .linktree-card {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-block: 30px;
    color: var(--ink);
  }
  .linktree-symbol {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid var(--line);
    border-radius: 14px;
    flex-shrink: 0;
    transition:
      background 200ms ease,
      transform 200ms ease;
  }
  .linktree-symbol :global(svg) {
    width: 34px;
    height: 34px;
  }
  .linktree-copy {
    display: grid;
    gap: 6px;
  }
  .linktree-copy strong {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .linktree-copy > span {
    font-size: 11px;
    line-height: 1.6;
    color: var(--muted);
  }
  .linktree-action {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .linktree-card:hover .linktree-symbol {
    background: var(--surface);
    transform: rotate(-5deg);
  }
  @media (max-width: 700px) {
    .linktree-card {
      gap: 14px;
      flex-wrap: wrap;
    }
    .linktree-copy {
      flex: 1;
    }
    .linktree-copy strong {
      font-size: 18px;
    }
    .linktree-action {
      margin-left: 68px;
    }
  }
</style>
