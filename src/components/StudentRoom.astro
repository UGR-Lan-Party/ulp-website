---
import VenueFurniture from './VenueFurniture.astro';
import VenueDoor from './VenueDoor.astro';
import VenueChessBoard from './VenueChessBoard.astro';
import {
  studentRoomLocalFurniture,
  studentRoomBoards,
  studentRoomEntrance,
} from '../data/student-room';
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<g
  class="student-room"
  data-student-room
  transform={detailed ? undefined : 'translate(124 85) rotate(-30)'}
>
  <path
    class:list={['student-room-wall', { 'room-outline': detailed }]}
    d={detailed
      ? 'M0 0H142V142H0Z'
      : 'M1.719854 143.021125L143.642903 137.203194'}></path>
  <VenueFurniture pieces={studentRoomLocalFurniture} />
  {studentRoomBoards.map((board) => <VenueChessBoard {...board} />)}
  {
    detailed ? (
      <g data-student-room-entrance>
        <VenueDoor x={134} y={142} width={30} angle={180} />
      </g>
    ) : (
      <g transform="rotate(30) translate(-124 -85)" data-student-room-entrance>
        <VenueDoor {...studentRoomEntrance} />
      </g>
    )
  }
  {
    detailed && (
      <g transform="translate(125 128) scale(.65)">
        <a
          class="student-amat"
          data-venue-external
          href="https://x.com/AMATugr"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="AMAT en X (Twitter), se abre en una pestaña nueva"
        >
          <title>AMAT en X / Twitter</title>
          <rect
            class="amat-hit"
            x="-17"
            y="-11"
            width="34"
            height="25"
            rx="2"
          />
          <image
            href="/assets/participan/normalized/amat/logo-color.webp"
            x="-15"
            y="-9"
            width="30"
            height="23"
          />
          <g class="amat-tooltip" aria-hidden="true">
            <>
              <rect x="-39" y="-23" width="55" height="10" rx="2" />
              <text x="-35" y="-16.5">
                AMAT en X / Twitter ↗
              </text>
            </>
          </g>
        </a>
      </g>
    )
  }
</g>
<style>
  .student-room :global(.floor-desk) {
    stroke-width: 0.65;
    rx: 0.7;
  }
  .student-room :global(.floor-seat) {
    stroke-width: 0.5;
  }
  .student-room-wall {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.85;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.5;
  }
  .room-outline {
    fill: color-mix(in srgb, var(--ink) 3%, var(--paper));
    stroke-width: 1.1;
    opacity: 1;
  }
  .student-amat {
    cursor: pointer;
    transform: rotate(var(--venue-label-turn, 0deg));
  }
  .amat-hit {
    fill: transparent;
    stroke: transparent;
  }
  .student-amat image {
    opacity: 1;
    filter: none;
    mix-blend-mode: normal;
  }
  .student-amat:hover .amat-hit,
  .student-amat:focus-visible .amat-hit {
    fill: var(--paper);
    stroke: var(--line);
    stroke-width: 0.3;
  }
  .amat-tooltip {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms ease;
  }
  .amat-tooltip rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 0.3;
  }
  .amat-tooltip text {
    fill: var(--ink);
    font:
      3.4px 'Inter Variable',
      sans-serif;
  }
  .student-amat:hover .amat-tooltip,
  .student-amat:focus-visible .amat-tooltip {
    opacity: 1;
    visibility: visible;
  }
  .student-amat:focus-visible {
    outline: none;
  }
  .student-amat:focus-visible .amat-hit {
    stroke: var(--ink);
    stroke-width: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .amat-tooltip {
      transition: none;
    }
  }
</style>
