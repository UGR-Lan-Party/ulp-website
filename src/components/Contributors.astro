---
import PersonCard from './PersonCard.astro';

const contributors = [
  { git: 'https://github.com/mario-ca' },
  { git: 'https://github.com/chelunike' },
  { git: 'https://github.com/puchy22' },
  { git: 'https://github.com/HipyCas' },
  { git: 'https://github.com/VictorPB' },
  { git: 'https://github.com/Juanjomrtz19' },
  { git: 'https://github.com/danilo-ck' },
  { git: 'https://github.com/roberto3554' },
  { git: 'https://github.com/FernanDezlo92' },
  { git: 'https://github.com/carmenxufdz' },
];

const fallbackContributors = [
  {
    name: 'Mario Castro',
    description: 'Computer Engineer & Junior Cybersecurity Evaluator at jtsec',
    image: '/assets/contributors/contributor01.jpg',
    git: 'https://github.com/mario-ca',
  },
  {
    name: 'chelunike',
    description:
      'Fucm Logic | Team Potato | CTF everywhere :) if(you.needHelp()) me.help();',
    image: '/assets/contributors/contributor02.jpg',
    git: 'https://github.com/chelunike',
  },
  {
    name: 'Rubén De la Torre Vico',
    description:
      'Average hacking and linux enjoyer. // I use Arch btw. // Jr. Software & Security Engineer at @prowler-cloud',
    image: '/assets/contributors/contributor03.jpg',
    git: 'https://github.com/puchy22',
  },
  {
    name: 'Hipy Cas',
    description:
      '🇪🇸🇪🇺🇨🇦 Galician/Spanish/European and half-Canadian developer • 🆓 Open-source and free software advocate • 🦀🐍🌐 Crustacean, pythonist and web developer',
    image: '/assets/contributors/contributor04.jpg',
    git: 'https://github.com/HipyCas',
  },
  {
    name: 'Victor Perez Barranco',
    description:
      'Computer Engineering Student Mention in Software Engineering.',
    image: '/assets/contributors/contributor05.jpg',
    git: 'https://github.com/VictorPB',
  },
  {
    name: 'Juan Jose Martinez Aguila',
    description: '',
    image: '/assets/contributors/contributor06.jpg',
    git: 'https://github.com/Juanjomrtz19',
  },
  {
    name: 'Daniel Farré',
    description:
      'University student pursuing a Dual Degree in Computer Science and Business Management. Web developer on my free time.',
    image: '/assets/contributors/contributor07.jpg',
    git: 'https://github.com/danilo-ck',
  },
  {
    name: 'Roberto Retamero',
    description:
      'UGR student and creative programmer with experience in p5.js.',
    image: '/assets/contributors/contributor08.jpg',
    git: 'https://github.com/roberto3554',
  },
  {
    name: ' Fernando Fernández Aguiló',
    description:
      '💻 Full Stack Developer | 🔐 Cybersecurity Enthusiast | Always learning & breaking things (ethically) 😆',
    image: '/assets/contributors/contributor09.jpg',
    git: 'https://github.com/FernanDezlo92',
  },
  {
    name: 'Carmen Fernández',
    description: 'Computer Engineer specialized in Software Engineering',
    image: '/assets/contributors/contributor10.jpg',
    git: 'https://github.com/carmenxufdz',
  },
];

const usernames = contributors.map((c) => c.git?.split('/').pop());

let contributorsData;

try {
  const responses = await Promise.all(
    usernames.map(async (username) => {
      const res = await fetch(`https://api.github.com/users/${username}`, {
        signal: AbortSignal.timeout(3500),
      });

      if (!res.ok) throw new Error('GitHub API Limit Exceeded');

      const data = await res.json();
      return {
        name: data.name || data.login,
        description: data.bio || '',
        image: data.avatar_url,
        git: data.html_url,
      };
    }),
  );

  contributorsData = responses.filter(Boolean);
} catch (error) {
  console.warn('Usando datos locales por error en la API de GitHub');
  contributorsData = fallbackContributors;
}
---

<section
  id="contributors"
  class="design-section design-container people-section"
>
  <header data-reveal>
    <div>
      <span class="design-eyebrow">Código hecho en comunidad</span><h2
        class="design-heading"
      >
        La web también<br />se juega en equipo.
      </h2>
    </div><p>
      Estudiantes que han colaborado en el diseño y desarrollo de la web de ULP.
    </p>
  </header>
  <div class="people-grid">
    {
      contributorsData.map((person) => (
        <PersonCard
          name={person.name}
          description={person.description}
          image={person.image}
          href={person.git}
          network="GitHub"
        />
      ))
    }
  </div>
</section>
<style>
  .people-section {
    padding-top: 28px;
  }
  header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: end;
    gap: 40px;
    margin-bottom: 38px;
  }
  .design-eyebrow {
    margin-bottom: 22px;
  }
  h2 {
    font-size: clamp(34px, 4.5vw, 60px);
  }
  header > p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.85;
    max-width: 320px;
    justify-self: end;
  }
  .people-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }
  @media (max-width: 1050px) {
    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    header {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    header > p {
      justify-self: start;
    }
    .people-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
