---
interface Props {
  trophy: string;
}
const { trophy } = Astro.props;
---

<div
  class="trophy-viewer mx-auto mt-4 w-full max-w-[600px] px-4"
  data-trophy={trophy}
>
  <div
    data-trophy-canvas
    class="h-[400px] w-full overflow-hidden sm:h-[600px]"
    aria-label="Visor del trofeo"
    role="region"
  >
  </div>
  <p data-trophy-status role="status" class="mt-3 text-center dark:text-white">
    Cargando trofeo 3D…
  </p>
  <button
    type="button"
    data-trophy-retry
    hidden
    class="mx-auto mt-3 block rounded bg-primary px-5 py-3 text-white focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-primary"
    >Reintentar carga del trofeo</button
  >
  <noscript
    ><p class="mt-3 text-center dark:text-white">
      Activa JavaScript para explorar el trofeo en 3D.
    </p></noscript
  >
</div>
<style>
  [hidden] {
    display: none !important;
  }
</style>
<script>
  import '../scripts/trophy-viewer';
</script>
