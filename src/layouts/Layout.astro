---
import '../styles/proposal.css';
import '../styles/reduced-motion.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import BackToTop from '../components/layout/BackToTop.astro';
import PartnerStrip from '../components/PartnerStrip.astro';
import PartnerLogoFilters from '../components/PartnerLogoFilters.astro';
interface Props {
  description?: string;
  title?: string;
  image?: string;
  noindex?: boolean;
}
const { description, title, image, noindex = false } = Astro.props;
const siteName = 'UGR LAN Party';
const pageTitle =
  title && title !== 'Inicio' ? `${title} | ${siteName}` : siteName;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: 'ULP',
  url: new URL('/', Astro.site).href,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonicalUrl} />
      )
    }
    <meta name="application-name" content={siteName} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    {!noindex && <meta property="og:url" content={canonicalUrl.href} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content={pageTitle} />
    {
      Astro.url.pathname === '/' && (
        <script type="application/ld+json" set:html={JSON.stringify(website)} />
      )
    }
    <meta property="og:image" content={image} />
    <meta property="twitter:image" content={image} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        document.documentElement.classList.toggle(
          'dark',
          theme === 'dark' ||
            (theme !== 'light' &&
              matchMedia('(prefers-color-scheme: dark)').matches),
        );
      } catch {
        document.documentElement.classList.toggle(
          'dark',
          matchMedia('(prefers-color-scheme: dark)').matches,
        );
      }
    </script>
    <script
      defer
      src="https://analytics.wupp.dev/script.js"
      data-website-id="bf67b9c0-6b15-4d11-af7b-3c56661b8f2e"></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <PartnerLogoFilters />
    <a href="#contenido-principal" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido-principal" tabindex="-1"><slot /></main>
    {Astro.url.pathname !== '/' && <PartnerStrip />}
    <Footer />
    <BackToTop />
    <script>
      import '../scripts/dropdown.js';
      import '../scripts/darkMode.js';
      import '../scripts/analytics';
      import '../scripts/visual-motion';
    </script>
  </body>
</html>
