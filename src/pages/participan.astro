---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import PartnerMoments from '../components/PartnerMoments.astro';
import PartnerCard from '../components/PartnerCard.astro';
import { partners } from '../data/sponsors';
import { partnerTiers } from '../data/partner-tiers';
const groups = partnerTiers
  .map((tier) => ({
    ...tier,
    items: partners.filter((partner) => partner.tier === tier.id),
  }))
  .filter((group) => group.items.length);
---

<Layout
  title="Participan"
  description="Las entidades que forman parte de la comunidad de UGR LAN Party"
>
  <Breadcrumb current="Participan">
    <Fragment slot="title">
      El equipo detrás<br />de la partida.
    </Fragment><Fragment slot="texto">
      Tecnología, talento y comunidad. Conoce a las entidades que hicieron
      posible ULP 2026.
    </Fragment>
  </Breadcrumb>
  <div class="design-container partner-invitation">
    <span class="design-eyebrow">Tu entidad también puede formar parte</span><a
      class="design-button"
      href="mailto:ulp@ugr.es"
      >Contáctanos <span aria-hidden="true"><ArrowUpRight /></span></a
    >
  </div>
  <nav
    class="design-container tier-navigation"
    aria-label="Rangos de colaboración"
  >
    {
      groups.map((group) => (
        <a href={`#partners-${group.id}`}>
          <i style={`--tier-accent: ${group.accent}`} aria-hidden="true" />
          {group.name}
          <span>{group.items.length}</span>
        </a>
      ))
    }
  </nav>
  <div class="design-container partner-directory">
    {
      groups.map((group) => (
        <section
          id={`partners-${group.id}`}
          class="partner-group"
          data-tier={group.id}
          style={`--tier-accent: ${group.accent}`}
        >
          <details class="partner-disclosure" open>
            <summary>
              <div class="tier-heading">
                <span class="design-eyebrow">Partners ULP</span>
                <h2>{group.name}</h2>
                <p class="tier-summary">
                  {group.id === 'regular'
                    ? 'La comunidad que suma en cada edición.'
                    : `Patrocinio ${group.name.toLocaleLowerCase('es')} · ULP 2026`}
                </p>
              </div>
              <svg
                class="tier-toggle"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path
                  d="m6 9 6 6 6-6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="partner-tier-grid">
              {group.items.map((partner, partnerIndex) => (
                <PartnerCard partner={partner} index={partnerIndex} />
              ))}
            </div>
          </details>
        </section>
      ))
    }
  </div>
  <PartnerMoments />
</Layout>
<script>
  document
    .querySelectorAll<HTMLAnchorElement>('.tier-navigation a')
    .forEach((link) => {
      link.addEventListener('click', () => {
        const group = document.getElementById(link.hash.slice(1));
        const disclosure = group?.querySelector('details');
        if (disclosure) disclosure.open = true;
      });
    });
</script>
<style>
  .partner-invitation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .partner-invitation .design-eyebrow {
    font-size: 9px;
  }
  .partner-directory {
    padding-bottom: 80px;
  }
  .partner-group {
    padding-top: 48px;
    scroll-margin-top: 110px;
  }
  .partner-group:first-child {
    padding-top: 28px;
  }
  .partner-group:first-child summary {
    border-top: 0;
    padding-top: 0;
  }
  .partner-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    list-style: none;
    padding-bottom: 20px;
    border-top: 1px solid var(--line);
    padding-top: 30px;
  }
  .partner-group h2 {
    display: flex;
    align-items: start;
    gap: 18px;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.2;
    font-weight: 750;
    margin-top: 14px;
  }
  .partner-group summary::-webkit-details-marker {
    display: none;
  }
  .tier-toggle {
    flex-shrink: 0;
    transition: transform 240ms ease;
  }
  .partner-disclosure[open] .tier-toggle {
    transform: rotate(180deg);
  }
  .partner-disclosure[open] .partner-tier-grid {
    margin-top: 8px;
  }
  @media (prefers-reduced-motion: reduce) {
    .tier-toggle {
      transition: none;
    }
  }
  .partner-group h2::before {
    content: '';
    width: 24px;
    height: 24px;
    margin-top: 0.2em;
    flex-shrink: 0;
    clip-path: polygon(25% 0, 75% 0, 100% 35%, 50% 100%, 0 35%);
    background: var(--tier-accent);
  }
  .partner-tier-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  [data-tier='diamond'] h2 {
    font-size: clamp(42px, 5vw, 68px);
  }
  [data-tier='platinum'] h2 {
    font-size: clamp(38px, 4.5vw, 58px);
  }
  [data-tier='diamond'] .partner-tier-grid {
    gap: 30px;
  }
  [data-tier='platinum'] .partner-tier-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  [data-tier='regular'] .partner-tier-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .tier-navigation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 22px;
  }
  .tier-navigation a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    font-size: 10px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--surface);
    transition: transform 200ms ease;
  }
  .tier-navigation a:hover {
    transform: translateY(-2px);
  }
  .tier-navigation i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--tier-accent);
  }
  .tier-navigation a span {
    font:
      8px ui-monospace,
      monospace;
    color: var(--muted);
  }
  .tier-summary {
    margin-top: 10px;
    font-size: 11px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .partner-tier-grid,
    [data-tier='regular'] .partner-tier-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .partner-tier-grid,
    [data-tier='platinum'] .partner-tier-grid,
    [data-tier='regular'] .partner-tier-grid {
      grid-template-columns: 1fr;
    }

    .partner-invitation {
      flex-direction: column;
      align-items: start;
    }
    .partner-group {
      padding-top: 45px;
    }
  }
</style>
