---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import PartnerCard from '../components/PartnerCard.astro';
import {
  sponsorsDiamond,
  sponsorsPlatinum,
  sponsorsGold,
  sponsorsSilver,
  sponsorsBronze,
  sponsorsRegular,
} from '../data/sponsors';
const groups = [
  { name: 'Diamante', items: sponsorsDiamond },
  { name: 'Platino', items: sponsorsPlatinum },
  { name: 'Oro', items: sponsorsGold },
  { name: 'Plata', items: sponsorsSilver },
  { name: 'Bronce', items: sponsorsBronze },
  { name: 'Colaboradores', items: sponsorsRegular },
];
---

<Layout
  title="Participan"
  description="Las entidades que forman parte de la comunidad de UGR LAN Party"
>
  <Breadcrumb current="Participan">
    <Fragment slot="title">
      El equipo detrás<br />de la partida.
    </Fragment><Fragment slot="texto">
      Tecnología, talento y comunidad. Conoce a las entidades que hicieron
      posible ULP 2026.
    </Fragment>
  </Breadcrumb>
  <div class="design-container partner-invitation">
    <span class="design-eyebrow">Tu entidad también puede formar parte</span><a
      class="design-link"
      href="/contacto"
      >Hablemos de la próxima edición <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="design-container partner-directory">
    {
      groups
        .filter((group) => group.items.length)
        .map((group, index) => (
          <section class="partner-group">
            <>
              <header data-reveal>
                <>
                  <span class="design-eyebrow">
                    {String(index + 1).padStart(2, '0')} / Partners ULP
                  </span>
                  <h2>
                    {group.name}
                    <span>{String(group.items.length).padStart(2, '0')}</span>
                  </h2>
                </>
              </header>
              <div class="design-grid">
                {group.items.map((partner, partnerIndex) => (
                  <PartnerCard partner={partner} index={partnerIndex} />
                ))}
              </div>
            </>
          </section>
        ))
    }
  </div>
</Layout>
<style>
  .partner-invitation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .partner-invitation .design-eyebrow {
    font-size: 9px;
  }
  .partner-directory {
    padding-bottom: 80px;
  }
  .partner-group {
    padding-top: 70px;
  }
  .partner-group header {
    margin-bottom: 28px;
  }
  .partner-group h2 {
    display: flex;
    align-items: start;
    gap: 18px;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.2;
    font-weight: 750;
    margin-top: 14px;
  }
  .partner-group h2 span {
    font:
      11px ui-monospace,
      monospace;
    opacity: 0.6;
    padding-top: 5px;
  }
  @media (max-width: 700px) {
    .partner-invitation {
      flex-direction: column;
      align-items: start;
    }
    .partner-group {
      padding-top: 45px;
    }
  }
</style>
