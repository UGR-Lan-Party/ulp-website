---
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import { getActivityNeighbors } from '../../utils/activity-navigation';
import { programEdition } from '../../data/program';
import Layout from '../../layouts/Layout.astro';
import ActivitySummary from '../../components/ActivitySummary.astro';
import HolographicCard from '../../components/CompetitionCardHolographic.astro';
import ULPTrophyCanvas from '../../components/ULPTrophyCanvas.astro';
import CompetitionAwardsSection from '../../components/CompetitionAwardsSection.astro';
import { Competitions, CompetitionsCards } from '../../data/competitions-data';
import type { CompetitionData } from '../../data/competitions-data';
import CompetitionTimePlace from '../../components/CompetitionTimePlace.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Inscripsection from '../../components/Inscripsection.astro';
import TournamentMatchups from '../../components/TournamentMatchups.astro';
import { getTournament } from '../../data/tournaments';

export function getStaticPaths() {
  return Competitions.map((competition) => ({
    params: { id: competition.id },
    props: { competition },
  }));
}
interface Props {
  competition: CompetitionData;
}
const { competition } = Astro.props;
const tournament = getTournament(competition.id);
const neighbors = getActivityNeighbors(competition.id, competition.tag);
const artwork = CompetitionsCards.find((card) => card.id === competition.id);
const categories: Record<string, string> = {
  competicion: 'Competición',
  reto: 'Reto',
  actividad: 'Actividad',
};
const category = categories[competition.tag] ?? 'Actividad';
const catalogSections: Record<string, string> = {
  competicion: 'competiciones',
  reto: 'retos',
  actividad: 'actividades',
};
const catalogSection = catalogSections[competition.tag] ?? 'actividades';
const hasAwards = Object.values(competition.awards ?? {}).some(
  (awards) => awards.length > 0,
);
const hasRewards = Boolean(competition.trophy || hasAwards);
---

<Layout
  title={competition.name}
  description={competition.description ||
    `Horarios, ubicación, normas y premios de ${competition.name} en ULP ${programEdition.year}.`}
>
  <article class="activity-page">
    <header class="activity-header design-container">
      <nav class="activity-breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/actividades">Actividades</a><span aria-hidden="true">/</span>
        <span aria-current="page">{competition.name}</span>
      </nav>
      <div class="activity-hero">
        <div class="activity-introduction">
          <span class="design-eyebrow"
            >{category} · ULP {programEdition.year}</span
          >
          <h1>{competition.name}</h1>
          {
            competition.description && (
              <p class="activity-description">{competition.description}</p>
            )
          }
          <div class="activity-actions">
            {
              competition.rules && (
                <a
                  class="design-button"
                  href={competition.rules}
                  data-analytics-event="rules-click"
                  data-analytics-edition={programEdition.year}
                  data-analytics-activity={competition.id}
                >
                  Consultar Reglas y Formato{' '}
                  <span aria-hidden="true">
                    <ArrowUpRight />
                  </span>
                </a>
              )
            }
            {
              hasRewards && (
                <a class="design-link" href="#premios">
                  Trofeo y premios <span aria-hidden="true">↓</span>
                </a>
              )
            }
            {
              tournament && (
                <a class="design-link" href="#emparejamientos">
                  {tournament.brackets.length ||
                  tournament.groups.some((group) => group.matches.length)
                    ? 'Ver emparejamientos'
                    : tournament.tables.length
                      ? 'Ver resultados'
                      : 'Consultar torneo'}{' '}
                  <span aria-hidden="true">↓</span>
                </a>
              )
            }
            {
              !competition.rules && !hasRewards && (
                <a class="design-link" href="#informacion">
                  Dónde y cuándo <span aria-hidden="true">↓</span>
                </a>
              )
            }
          </div>
        </div>
        {
          artwork && (
            <div class="activity-art">
              {neighbors && (
                <a
                  class="activity-previous activity-step"
                  href={`/actividades/${neighbors.previous.id}`}
                  aria-label={`Anterior: ${neighbors.previous.name}`}
                  title={neighbors.previous.name}
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path d="m14 6-6 6 6 6" />
                  </svg>
                </a>
              )}
              <HolographicCard competition={artwork} />
              {neighbors && (
                <a
                  class="activity-next activity-step"
                  href={`/actividades/${neighbors.next.id}`}
                  aria-label={`Siguiente: ${neighbors.next.name}`}
                  title={neighbors.next.name}
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path d="m10 6 6 6-6 6" />
                  </svg>
                </a>
              )}
            </div>
          )
        }
      </div>
      <ActivitySummary competition={competition} />
    </header>
    <div class="design-container">
      <Inscripsection
        activityId={competition.id}
        activityYear={programEdition.year}
        registrationPeriodOpen={competition.registrationPeriodOpen}
        registrationLink={competition.registration}
        participantsLink={competition.participants}
      />
      <section
        id="informacion"
        class="activity-information"
        aria-labelledby="activity-information-title"
      >
        <div class="activity-section-copy">
          <span class="design-eyebrow">01 / Prepara tu visita</span>
          <h2 id="activity-information-title">Dónde y cuándo.</h2>
          <a class="design-link" href="/info/localizacion"
            >Cómo llegar a la ETSIIT <span aria-hidden="true"
              ><ArrowUpRight /></span
            ></a
          >
        </div>
        <CompetitionTimePlace
          place={competition.place}
          time={competition.schedule}
        />
      </section>
      {
        hasRewards && (
          <section
            id="premios"
            class="activity-rewards"
            aria-labelledby="activity-rewards-title"
          >
            <header class="activity-rewards-heading">
              <div>
                <span class="design-eyebrow">02 / El podio ULP</span>
                <h2 id="activity-rewards-title">Trofeo y premios.</h2>
              </div>
              <span class="activity-edition">
                Edición {programEdition.year}
              </span>
            </header>
            {competition.trophy && (
              <div class="trophy-showcase">
                {artwork && (
                  <ResponsiveImage
                    src={artwork.card}
                    alt=""
                    class="trophy-backdrop"
                    sizes="(max-width: 760px) 100vw, 1240px"
                  />
                )}
                <div class="trophy-heading">
                  <h3>Trofeo {competition.name}</h3>
                  <span>El recuerdo de la partida</span>
                </div>
                <ULPTrophyCanvas
                  trophy={competition.trophy}
                  label={`Trofeo ${competition.name}`}
                  background={artwork?.card}
                />
              </div>
            )}
            {hasAwards && competition.awards && (
              <CompetitionAwardsSection
                competitionAwards={competition.awards}
              />
            )}
          </section>
        )
      }
      <TournamentMatchups activityId={competition.id} />
      {
        neighbors && (
          <nav
            class="activity-bottom-navigation"
            aria-label={`Más ${catalogSection}`}
          >
            <a href={`/actividades/${neighbors.previous.id}`} rel="prev">
              <span class="activity-nav-caption">
                <span aria-hidden="true">←</span> Anterior
              </span>
              <strong>{neighbors.previous.name}</strong>
            </a>
            <a href={`/actividades/${neighbors.next.id}`} rel="next">
              <span class="activity-nav-caption">
                Siguiente <span aria-hidden="true">→</span>
              </span>
              <strong>{neighbors.next.name}</strong>
            </a>
          </nav>
        )
      }
      <div class="activity-ending">
        <span class="design-eyebrow">Siempre hay otra partida</span>
        <a class="design-link" href={`/actividades#${catalogSection}`}
          >Volver al catálogo <span aria-hidden="true"><ArrowUpRight /></span
          ></a
        >
      </div>
    </div>
  </article>
</Layout>
<style>
  .activity-header {
    padding-top: 122px;
    padding-bottom: 42px;
  }
  .activity-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font:
      10px/1.6 ui-monospace,
      monospace;
    color: var(--muted);
    margin-bottom: 34px;
  }
  .activity-breadcrumb a:hover {
    color: var(--ink);
  }
  .activity-breadcrumb [aria-current] {
    color: var(--ink);
  }
  .activity-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  .activity-introduction {
    min-width: 0;
  }
  .activity-introduction .design-eyebrow {
    margin-bottom: 22px;
  }
  h1 {
    font-size: clamp(42px, 5.8vw, 78px);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.05em;
    overflow-wrap: anywhere;
  }
  .activity-description {
    max-width: 48ch;
    margin-top: 24px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .activity-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
  }
  .activity-actions .design-button {
    min-height: 48px;
    padding: 13px 18px;
    gap: 16px;
  }
  .activity-art {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 12px 44px;
  }
  .activity-step {
    position: absolute;
    z-index: 3;
    top: calc(50% - 22px);
    display: grid;
    place-items: center;
    width: 36px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    opacity: 0.6;
    transition:
      opacity 180ms ease,
      background 180ms ease;
  }
  .activity-step:hover,
  .activity-step:focus-visible {
    opacity: 1;
    background: var(--surface);
  }
  .activity-step:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .activity-previous {
    left: 0;
  }
  .activity-next {
    right: 0;
  }
  .activity-information {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(28px, 4vw, 60px);
    align-items: center;
    padding-block: 56px;
    scroll-margin-top: 110px;
  }
  h2 {
    font-size: clamp(30px, 3.2vw, 42px);
    font-weight: 750;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  .activity-section-copy h2 {
    margin-top: 15px;
    margin-bottom: 24px;
  }
  .activity-rewards {
    padding-block: 36px 52px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 110px;
  }
  .activity-rewards-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
  }
  .activity-rewards-heading h2 {
    margin-top: 15px;
  }
  .activity-edition {
    font:
      10px/1.5 ui-monospace,
      monospace;
    color: var(--muted);
  }
  .trophy-showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 24px;
    border: 1px solid rgb(245 240 230 / 0.16);
    border-radius: 24px;
    background: #062d43;
    color: #f5f0e6;
    margin-bottom: 38px;
  }
  .trophy-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.09;
    filter: saturate(0.15);
    pointer-events: none;
  }
  .trophy-showcase :global([data-trophy-status]),
  .trophy-showcase :global(noscript p) {
    color: rgb(245 240 230 / 0.65);
  }
  .trophy-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
  }
  .trophy-heading h3 {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .trophy-heading > span {
    color: rgb(245 240 230 / 0.65);
    font:
      9px/1.6 ui-monospace,
      monospace;
  }
  .activity-ending {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-block: 28px 44px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .activity-header {
      padding-top: 104px;
      padding-bottom: 28px;
    }
    .activity-hero,
    .activity-information {
      grid-template-columns: minmax(0, 1fr);
    }
    .activity-hero {
      gap: 28px;
    }
    .activity-art {
      padding-inline: 42px;
    }
    .activity-information {
      padding-block: 36px;
    }
    .trophy-showcase {
      padding: 18px;
    }
  }
  .activity-bottom-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
  }
  .activity-bottom-navigation a {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color 180ms;
  }
  .activity-bottom-navigation a:hover {
    border-color: var(--ink);
  }
  .activity-bottom-navigation a:last-child {
    text-align: right;
  }
  .activity-nav-caption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .activity-bottom-navigation a:last-child .activity-nav-caption {
    justify-content: end;
  }
  .activity-bottom-navigation strong {
    font-size: clamp(14px, 2vw, 20px);
    font-weight: 650;
    overflow-wrap: anywhere;
  }
</style>
