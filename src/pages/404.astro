---
import Layout from '../layouts/Layout.astro';
import illustration from '../../public/assets/404.svg?raw';
---

<Layout
  noindex
  title="Página no encontrada"
  description="Este enlace de ULP ya no está disponible. Consulta el programa de actividades o vuelve al inicio."
>
  <section class="container mx-auto px-6 py-24 text-center dark:text-white">
    <div
      class="not-found-illustration mx-auto mb-8 max-w-full"
      aria-hidden="true"
      set:html={illustration}
    />
    <h1 class="mb-4 text-3xl font-bold">No encontramos esta página</h1>
    <p class="mx-auto mb-8 max-w-xl">
      El enlace puede corresponder a una actividad de una edición anterior o
      haber cambiado. Consulta el programa para encontrar las actividades
      disponibles.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/actividades" class="rounded-md bg-primary px-6 py-3 text-white"
        >Ver actividades</a
      >
      <a href="/" class="rounded-md border border-primary px-6 py-3"
        >Volver al inicio</a
      >
    </div>
  </section>
</Layout>

<style>
  .not-found-illustration {
    --illustration-accent: #006471;
    --illustration-ink: #004465;
    width: 260px;
  }
  .not-found-illustration :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  :global(.dark) .not-found-illustration {
    --illustration-accent: #8ed9ce;
    --illustration-ink: #f5f0e6;
  }
</style>
