---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada"
  description="Este enlace de ULP ya no está disponible. Consulta el programa de actividades o vuelve al inicio."
>
  <section class="container mx-auto px-6 py-24 text-center dark:text-white">
    <img
      src="/assets/404.svg"
      alt=""
      width="360"
      height="260"
      class="mx-auto mb-8 max-w-full"
    />
    <h1 class="mb-4 text-3xl font-bold">No encontramos esta página</h1>
    <p class="mx-auto mb-8 max-w-xl">
      El enlace puede corresponder a una actividad de una edición anterior o
      haber cambiado. Consulta el programa para encontrar las actividades
      disponibles.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/actividades" class="rounded-md bg-primary px-6 py-3 text-white"
        >Ver actividades</a
      >
      <a href="/" class="rounded-md border border-primary px-6 py-3"
        >Volver al inicio</a
      >
    </div>
  </section>
</Layout>
