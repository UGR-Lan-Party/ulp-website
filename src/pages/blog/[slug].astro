---
import { render } from 'astro:content';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import SocialButton from '../../components/SocialButton.astro';
import NewsCard from '../../components/NewsCard.astro';
import {
  getPublishedNews,
  formatNewsDate,
  getReadingMinutes,
} from '../../utils/news';
export async function getStaticPaths() {
  return (await getPublishedNews()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const details = entry.data.postDetails;
const initials = entry.data.author
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((name) => name[0])
  .join('');
const paragraphs = [
  details.paraThree,
  details.paraFour,
  details.paraFive,
  details.paraSix,
].filter(Boolean);
const related = (await getPublishedNews())
  .filter((story) => story.id !== entry.id)
  .slice(0, 2);
const networks = [
  ['web', 'Web'],
  ['twitter', 'X'],
  ['instagram', 'Instagram'],
  ['tiktok', 'TikTok'],
] as const;
const links = networks.flatMap(([key, rrss]) =>
  entry.data.socialLinks?.[key]
    ? [{ rrss, link: entry.data.socialLinks[key]! }]
    : [],
);
---

<Layout
  title={entry.data.title}
  description={entry.data.snippet}
  image={entry.data.bigImg.src}
>
  <article class="news-article design-container">
    <div class="article-topline">
      <a href="/blog" class="design-link">← Volver a noticias</a><span
        >ULP / HISTORIAS DE CAMPUS</span
      >
    </div>
    <div class="article-hero">
      <header class="article-header">
        <div class="article-meta">
          <span class="design-eyebrow"
            >{entry.data.tags[0] ?? 'Comunidad ULP'}</span
          ><time datetime={entry.data.publishDate.toISOString()}
            >{formatNewsDate(entry.data.publishDate)}</time
          >
        </div>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.snippet}</p>
        <div class="article-byline">
          <span class="author-avatar" aria-hidden="true">{initials}</span><span
            >Una historia de<strong>{entry.data.author}</strong></span
          >
          <span class="article-reading-label"
            >{getReadingMinutes(entry)} min de lectura</span>
        </div>
        <div class="article-tags">
          {entry.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </header>
      <figure class="article-figure">
        <ResponsiveImage
          src={entry.data.bigImg.src}
          alt={entry.data.bigImg.alt}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 850px) 90vw, 800px"
        />
        <figcaption>
          <span>{entry.data.bigImg.alt}</span><a
            href={entry.data.bigImg.src}
            download>Descargar imagen original <ArrowUpRight /></a
          >
        </figcaption>
      </figure>
    </div>
    <div class="article-reading-grid">
      <div id="historia" class="article-body">
        <p class="article-lead">{details.paraOne}</p>
        {details.paraTwo && <p>{details.paraTwo}</p>}
        {details.titleTwo && <h2 id="detalles">{details.titleTwo}</h2>}
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <Content />
        {
          entry.data.quotes.quote && (
            <blockquote>
              <p>{entry.data.quotes.quote}</p>
              {entry.data.quotes.author && (
                <cite>{entry.data.quotes.author}</cite>
              )}
            </blockquote>
          )
        }
        {
          links.length > 0 && (
            <aside class="article-socials">
              <>
                <span>Más sobre esta historia</span>
                <div>
                  {links.map((link) => (
                    <SocialButton sponsorLink={link} />
                  ))}
                </div>
              </>
            </aside>
          )
        }
        <a href="/blog" class="article-return design-link"
          >Más historias de la ULP <span aria-hidden="true"
            ><ArrowUpRight /></span
          ></a
        >
      </div>
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="design-container article-related">
        <div class="design-section-header">
          <h2 class="design-heading">Sigue leyendo</h2>
          <a href="/blog" class="design-link">
            Todas las noticias{' '}
            <span aria-hidden="true">
              <ArrowUpRight />
            </span>
          </a>
        </div>
        <div class="related-grid">
          {related.map((story) => (
            <NewsCard entry={story} />
          ))}
        </div>
      </section>
    )
  }
</Layout>
<style>
  .news-article {
    max-width: 848px;
    padding-top: 124px;
    font-family: 'Inter Variable', Inter, sans-serif;
  }
  .article-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 30px;
  }
  .article-topline .design-link {
    font-size: 11px;
  }
  .article-topline > span {
    font-size: 8px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 16px;
  }
  .article-meta .design-eyebrow {
    font-size: 9px;
  }
  time {
    font-size: 10px;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(32px, 4.2vw, 54px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.045em;
    text-wrap: pretty;
    margin-bottom: 18px;
  }
  .article-header > p {
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }
  .article-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    font-size: 9px;
    color: var(--muted);
  }
  .author-avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 11px;
    color: var(--ink);
  }
  .article-byline strong {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
  }
  .article-reading-label {
    margin-left: auto;
    font-size: 10px;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }
  .article-tags > span {
    padding: 4px 9px;
    border-radius: 99px;
    border: 1px solid var(--line);
    font-size: 9px;
  }
  .article-figure {
    margin-top: 28px;
  }
  .article-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: contain;
    border-radius: 14px;
    background: var(--surface);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.5;
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  figcaption :global(svg) {
    width: 12px;
    height: 12px;
  }
  .article-reading-grid {
    padding-block: 30px 44px;
  }
  .article-body {
    max-width: 68ch;
    margin-inline: auto;
    font-size: 16px;
    line-height: 1.8;
    scroll-margin-top: 100px;
  }
  .article-body :global(p) {
    margin-bottom: 20px;
    color: color-mix(in srgb, var(--ink) 90%, var(--paper));
    overflow-wrap: break-word;
    text-align: start;
  }
  .article-body :global(strong) {
    font-weight: 650;
    color: var(--ink);
  }
  .article-body :global(a) {
    text-underline-offset: 4px;
  }
  .article-body :global(p a) {
    text-decoration: underline;
  }
  .article-body > .article-lead {
    font-size: 17px;
    line-height: 1.8;
    font-weight: 500;
    color: var(--ink);
  }
  .article-body :global(h2) {
    font-size: clamp(23px, 3vw, 29px);
    line-height: 1.25;
    letter-spacing: -0.03em;
    font-weight: 650;
    margin-block: 30px 14px;
    scroll-margin-top: 100px;
  }
  blockquote {
    margin-block: 28px;
    padding: 22px 24px;
    border-left: 3px solid #008b98;
    border-radius: 0 12px 12px 0;
    background: var(--surface);
    font-size: 20px;
    line-height: 1.6;
  }
  .article-body blockquote :global(p) {
    color: var(--ink);
    margin-bottom: 12px;
  }
  blockquote cite {
    font-size: 11px;
    font-style: normal;
    color: var(--muted);
  }
  .article-socials {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 18px;
    border-block: 1px solid var(--line);
    margin-top: 28px;
    font-size: 11px;
  }
  .article-socials > div {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .article-socials :global(a) {
    color: var(--ink);
  }
  .article-socials :global(svg) {
    width: 20px;
    height: 20px;
  }
  .article-return {
    font-size: 11px;
    margin-top: 24px;
  }
  .article-related {
    max-width: 1000px;
    padding-bottom: 60px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  .article-related .design-heading {
    font-size: clamp(27px, 3.4vw, 38px);
  }
  .article-related .design-section-header {
    margin-bottom: 22px;
  }
  .article-related .design-link {
    font-size: 11px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 700px) {
    .news-article {
      padding-top: 106px;
    }
    .article-topline {
      margin-bottom: 20px;
    }
    .article-topline > span {
      display: none;
    }
    .article-meta {
      margin-bottom: 12px;
    }
    h1 {
      font-size: clamp(28px, 7.6vw, 39px);
      margin-bottom: 13px;
      letter-spacing: -0.035em;
    }
    .article-header > p {
      font-size: 13px;
      line-height: 1.65;
    }
    .article-byline {
      margin-top: 16px;
    }
    .article-tags {
      margin-top: 12px;
    }
    .article-tags > span {
      font-size: 8px;
      padding: 3px 7px;
    }
    .article-figure {
      margin-top: 20px;
    }
    .article-figure :global(img) {
      max-height: 390px;
      border-radius: 10px;
    }
    figcaption {
      font-size: 8px;
    }
    .article-reading-grid {
      padding-block: 22px 30px;
    }
    .article-body {
      font-size: 14px;
      line-height: 1.75;
    }
    .article-body :global(p) {
      margin-bottom: 16px;
    }
    .article-body > .article-lead {
      font-size: 15px;
      line-height: 1.75;
    }
    .article-body :global(h2) {
      margin-block: 24px 12px;
      font-size: 22px;
    }
    blockquote {
      font-size: 17px;
      padding: 16px 18px;
      margin-block: 22px;
    }
    .article-related {
      padding-block: 22px 36px;
    }
    .article-related .design-section-header {
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }
    .article-related .design-link {
      font-size: 10px;
    }
    .related-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
