---
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import SocialButton from '../../components/SocialButton.astro';
import NewsCard from '../../components/NewsCard.astro';
import {
  getPublishedNews,
  formatNewsDate,
  getReadingMinutes,
} from '../../utils/news';
export async function getStaticPaths() {
  return (await getPublishedNews()).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const details = entry.data.postDetails;
const paragraphs = [
  details.paraTwo,
  details.paraThree,
  details.paraFour,
  details.paraFive,
  details.paraSix,
].filter(Boolean);
const related = (await getPublishedNews())
  .filter((story) => story.id !== entry.id)
  .slice(0, 2);
const networks = [
  ['web', 'Web'],
  ['twitter', 'X'],
  ['instagram', 'Instagram'],
  ['tiktok', 'TikTok'],
] as const;
const links = networks.flatMap(([key, rrss]) =>
  entry.data.socialLinks?.[key]
    ? [{ rrss, link: entry.data.socialLinks[key]! }]
    : [],
);
---

<Layout
  title={entry.data.title}
  description={entry.data.snippet}
  image={entry.data.bigImg.src}
>
  <article class="news-article design-container">
    <header class="article-header">
      <a href="/blog" class="design-link">← Volver a noticias</a><div
        class="article-meta"
      >
        <time datetime={entry.data.publishDate.toISOString()}
          >{formatNewsDate(entry.data.publishDate)}</time
        ><span>{getReadingMinutes(entry)} min de lectura</span>
      </div><h1>{entry.data.title}</h1><p>{entry.data.snippet}</p><div
        class="article-byline"
      >
        <span>Por {entry.data.author}</span><div>
          {entry.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    </header>
    <figure class="article-figure">
      <ResponsiveImage
        src={entry.data.bigImg.src}
        alt={entry.data.bigImg.alt}
        loading="eager"
        fetchpriority="high"
        sizes="90vw"
      /><figcaption>
        {entry.data.bigImg.alt}<a href={entry.data.bigImg.src} download
          >Descargar imagen original ↗</a
        >
      </figcaption>
    </figure>
    <div class="article-body">
      <p class="article-lead">{details.paraOne}</p>{
        details.titleTwo && <h2>{details.titleTwo}</h2>
      }{paragraphs.map((paragraph) => <p>{paragraph}</p>)}<Content />{
        entry.data.quotes.quote && (
          <blockquote>
            <p>{entry.data.quotes.quote}</p>
            {entry.data.quotes.author && (
              <cite>{entry.data.quotes.author}</cite>
            )}
          </blockquote>
        )
      }{
        links.length > 0 && (
          <aside class="article-socials">
            <span>Más sobre esta historia</span>
            <div>
              {links.map((link) => (
                <SocialButton sponsorLink={link} />
              ))}
            </div>
          </aside>
        )
      }
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="design-container article-related">
        <div class="design-section-header">
          <h2 class="design-heading">Sigue leyendo.</h2>
          <a href="/blog" class="design-link">
            Todas las noticias <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="related-grid">
          {related.map((story) => (
            <NewsCard entry={story} />
          ))}
        </div>
      </section>
    )
  }
</Layout>
<style>
  .news-article {
    padding-top: 125px;
  }
  .article-header {
    max-width: 1000px;
    margin-inline: auto;
  }
  .article-header > .design-link {
    font-size: 11px;
    margin-bottom: 45px;
  }
  .article-meta {
    display: flex;
    gap: 22px;
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted);
    margin-bottom: 24px;
  }
  h1 {
    font-size: clamp(36px, 5.7vw, 78px);
    line-height: 1.04;
    font-weight: 800;
    max-width: 1000px;
    margin-bottom: 25px;
  }
  .article-header > p {
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.7;
    color: var(--muted);
    max-width: 760px;
  }
  .article-byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 30px;
    font-size: 11px;
  }
  .article-byline > div {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
  }
  .article-byline > div > span {
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 6px 10px;
    font-size: 9px;
  }
  .article-figure {
    margin-block: 45px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
  }
  .article-figure :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 720px;
    margin-inline: auto;
    border-radius: 10px;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 18px;
    font-size: 10px;
    line-height: 1.6;
    color: var(--muted);
  }
  figcaption a {
    white-space: nowrap;
    color: var(--ink);
  }
  .article-body {
    max-width: 720px;
    margin: 60px auto 80px;
    font-size: 16px;
    line-height: 1.95;
  }
  .article-body > p {
    margin-bottom: 26px;
    color: var(--muted);
  }
  .article-body > .article-lead {
    font-size: 19px;
    color: var(--ink);
  }
  .article-body h2 {
    font-size: 31px;
    font-weight: 700;
    line-height: 1.15;
    margin-block: 40px 24px;
  }
  blockquote {
    border-left: 3px solid var(--accent);
    padding: 8px 0 8px 28px;
    margin-block: 40px;
    font:
      italic 27px/1.5 Georgia,
      serif;
  }
  blockquote cite {
    display: block;
    margin-top: 15px;
    font:
      11px ui-monospace,
      monospace;
  }
  .article-socials {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    margin-top: 40px;
    font-size: 11px;
  }
  .article-socials > div {
    display: flex;
    gap: 6px;
  }
  .article-socials :global(a) {
    color: var(--ink);
  }
  .article-socials :global(svg) {
    width: 20px;
    height: 20px;
  }
  .article-related {
    padding-bottom: 90px;
  }
  .article-related .design-heading {
    font-size: clamp(30px, 4vw, 50px);
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 700px) {
    .news-article {
      padding-top: 100px;
    }
    .article-header > .design-link {
      margin-bottom: 30px;
    }
    .article-figure {
      padding: 12px;
      margin-block: 30px;
    }
    figcaption {
      flex-direction: column;
      gap: 10px;
    }
    .article-body {
      margin-top: 35px;
      font-size: 15px;
    }
    .article-socials {
      flex-direction: column;
      align-items: start;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
