---
import { render } from 'astro:content';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import SocialButton from '../../components/SocialButton.astro';
import NewsCard from '../../components/NewsCard.astro';
import {
  getPublishedNews,
  formatNewsDate,
  getReadingMinutes,
} from '../../utils/news';
export async function getStaticPaths() {
  return (await getPublishedNews()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const details = entry.data.postDetails;
const initials = entry.data.author
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((name) => name[0])
  .join('');
const paragraphs = [
  details.paraThree,
  details.paraFour,
  details.paraFive,
  details.paraSix,
].filter(Boolean);
const related = (await getPublishedNews())
  .filter((story) => story.id !== entry.id)
  .slice(0, 2);
const networks = [
  ['web', 'Web'],
  ['twitter', 'X'],
  ['instagram', 'Instagram'],
  ['tiktok', 'TikTok'],
] as const;
const links = networks.flatMap(([key, rrss]) =>
  entry.data.socialLinks?.[key]
    ? [{ rrss, link: entry.data.socialLinks[key]! }]
    : [],
);
---

<Layout
  title={entry.data.title}
  description={entry.data.snippet}
  image={entry.data.bigImg.src}
>
  <article class="news-article design-container">
    <div class="article-topline">
      <a href="/blog" class="design-link">← Volver a noticias</a><span
        >ULP / HISTORIAS DE CAMPUS</span
      >
    </div>
    <div class="article-hero">
      <header class="article-header">
        <div class="article-meta">
          <span class="design-eyebrow"
            >{entry.data.tags[0] ?? 'Comunidad ULP'}</span
          ><time datetime={entry.data.publishDate.toISOString()}
            >{formatNewsDate(entry.data.publishDate)}</time
          >
        </div>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.snippet}</p>
        <div class="article-byline">
          <span class="author-avatar" aria-hidden="true">{initials}</span><span
            >Una historia de<strong>{entry.data.author}</strong></span
          >
        </div>
        <div class="article-tags">
          {entry.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </header>
      <figure class="article-figure">
        <ResponsiveImage
          src={entry.data.bigImg.src}
          alt={entry.data.bigImg.alt}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 900px) 90vw, 45vw"
        />
        <figcaption>
          <span>{entry.data.bigImg.alt}</span><a
            href={entry.data.bigImg.src}
            download>Descargar imagen original <ArrowUpRight /></a
          >
        </figcaption>
      </figure>
    </div>
    <div class="article-reading-grid">
      <aside class="article-sidebar">
        <span class="design-eyebrow">Pausa entre partidas</span>
        <p class="reading-time">
          <strong>{String(getReadingMinutes(entry)).padStart(2, '0')}</strong> min
          de lectura
        </p>
        <nav aria-label="En esta entrada">
          <a href="#historia">La historia <span aria-hidden="true">↓</span></a>{
            details.titleTwo && (
              <a href="#detalles">
                Más detalles <span aria-hidden="true">↓</span>
              </a>
            )
          }
        </nav>
        <p>Desde la ETSIIT.<br />Para nuestra comunidad.</p>
      </aside>
      <div id="historia" class="article-body">
        <p class="article-lead">{details.paraOne}</p>
        {details.paraTwo && <p>{details.paraTwo}</p>}
        {details.titleTwo && <h2 id="detalles">{details.titleTwo}</h2>}
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <Content />
        {
          entry.data.quotes.quote && (
            <blockquote>
              <p>{entry.data.quotes.quote}</p>
              {entry.data.quotes.author && (
                <cite>{entry.data.quotes.author}</cite>
              )}
            </blockquote>
          )
        }
        {
          links.length > 0 && (
            <aside class="article-socials">
              <>
                <span>Más sobre esta historia</span>
                <div>
                  {links.map((link) => (
                    <SocialButton sponsorLink={link} />
                  ))}
                </div>
              </>
            </aside>
          )
        }
        <a href="/blog" class="article-return design-link"
          >Más historias de la ULP <span aria-hidden="true"
            ><ArrowUpRight /></span
          ></a
        >
      </div>
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="design-container article-related">
        <div class="design-section-header">
          <h2 class="design-heading">Sigue leyendo.</h2>
          <a href="/blog" class="design-link">
            Todas las noticias{' '}
            <span aria-hidden="true">
              <ArrowUpRight />
            </span>
          </a>
        </div>
        <div class="related-grid">
          {related.map((story) => (
            <NewsCard entry={story} />
          ))}
        </div>
      </section>
    )
  }
</Layout>
<style>
  .news-article {
    font-family: 'Inter Variable', Inter, sans-serif;
    padding-top: 125px;
  }
  .article-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 45px;
  }
  .article-topline .design-link {
    font-size: 11px;
  }
  .article-topline > span {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .article-hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(35px, 5vw, 75px);
    padding-bottom: 60px;
    border-bottom: 1px solid var(--line);
  }
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 24px;
  }
  .article-meta .design-eyebrow {
    font-size: 9px;
  }
  time {
    font:
      9px ui-monospace,
      monospace;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(36px, 4.4vw, 64px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.055em;
    margin-bottom: 25px;
  }
  .article-header > p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--muted);
  }
  .article-byline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    font-size: 10px;
    color: var(--muted);
  }
  .author-avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 12px;
    color: var(--ink);
    background: var(--surface);
  }
  .article-byline strong {
    display: block;
    color: var(--ink);
    font-size: 12px;
    margin-top: 5px;
    font-weight: 600;
  }
  .article-tags {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .article-tags > span {
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 6px 10px;
    font-size: 9px;
  }
  .article-figure {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    transform: rotate(-2deg);
    box-shadow: 12px 16px 0 rgb(0 68 101 / 0.06);
  }
  .article-figure :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 520px;
    margin-inline: auto;
    border-radius: 10px;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 18px;
    font-size: 9px;
    line-height: 1.6;
    color: var(--muted);
  }
  figcaption a {
    color: var(--ink);
    align-self: start;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .article-reading-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    padding-block: 32px 65px;
    margin-inline: auto;
  }
  .article-sidebar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .article-sidebar .design-eyebrow,
  .article-sidebar > p:last-child {
    display: none;
  }
  .reading-time {
    color: var(--muted);
    font-size: 10px;
    margin: 0;
  }
  .reading-time strong {
    font-size: 30px;
    font-weight: 750;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-right: 8px;
  }
  .article-sidebar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .article-sidebar nav a {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 11px;
    padding-block: 12px;
  }
  .article-sidebar > p:last-child {
    font-size: 11px;
    line-height: 1.9;
    color: var(--muted);
  }
  .article-body {
    padding: clamp(20px, 2.5vw, 32px);
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    width: 100%;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.8;
    scroll-margin-top: 110px;
  }
  .article-body :global(p) {
    margin-bottom: 18px;
    color: color-mix(in srgb, var(--ink) 86%, var(--surface));
    text-align: justify;
    text-align-last: start;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .article-body :global(strong) {
    font-weight: 650;
    color: var(--ink);
  }
  .article-body :global(p a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .news-article :global(.design-eyebrow) {
    font-family: inherit;
    font-weight: 600;
  }
  .article-body > .article-lead {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.85;
    color: var(--ink);
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }
  .article-body :global(h2) {
    font-size: clamp(23px, 2.5vw, 29px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin-block: 28px 18px;
    scroll-margin-top: 110px;
  }
  blockquote {
    padding: 30px;
    border-radius: 14px;
    background: #004465;
    color: #f5f0e6;
    margin-block: 35px;
    border-left: 3px solid #9cbfce;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.8;
  }
  .article-body blockquote :global(p) {
    color: inherit;
    text-align: start;
    margin-bottom: 15px;
  }
  blockquote cite {
    display: block;
    font-size: 11px;
    font-style: normal;
    font-weight: 400;
    opacity: 0.7;
  }
  .article-socials {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 20px;
    border-block: 1px solid var(--line);
    margin-top: 35px;
    font-size: 11px;
  }
  .article-socials > div {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .article-socials :global(a) {
    color: var(--ink);
  }
  .article-socials :global(svg) {
    width: 20px;
    height: 20px;
  }
  .article-return {
    margin-top: 30px;
    font-size: 11px;
  }
  .article-related {
    padding-bottom: 90px;
  }
  .article-related .design-heading {
    font-size: clamp(30px, 4vw, 50px);
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 900px) {
    .article-hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .article-figure {
      max-width: 600px;
      width: 100%;
      margin-inline: auto;
    }
    .article-reading-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .article-sidebar {
      position: static;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px 25px;
    }
    .article-sidebar > .design-eyebrow,
    .article-sidebar > p:last-child {
      display: none;
    }
    .reading-time {
      margin: 0;
    }
    .reading-time strong {
      font-size: 30px;
    }
    .article-sidebar nav {
      display: flex;
      gap: 24px;
      border: 0;
      padding: 0;
      margin: 0;
    }
    .article-sidebar nav a {
      gap: 14px;
    }
  }
  @media (max-width: 700px) {
    .news-article {
      padding-top: 100px;
    }
    .article-topline {
      margin-bottom: 35px;
    }
    .article-topline > span {
      display: none;
    }
    .article-hero {
      padding-bottom: 40px;
    }
    .article-figure {
      padding: 12px;
      transform: none;
    }
    .article-header > p {
      font-size: 15px;
    }
    .article-reading-grid {
      padding-block: 35px 60px;
    }
    .article-body {
      font-size: 15px;
      padding: 24px 22px;
    }
    .article-body > .article-lead {
      font-size: 16px;
    }
    blockquote {
      padding: 22px;
      font-size: 17px;
    }
    .article-socials {
      flex-direction: column;
      align-items: start;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 700px) {
    .news-article {
      padding-top: 112px;
    }
    .article-topline {
      margin-bottom: 24px;
    }
    .article-hero {
      gap: 28px;
      padding-bottom: 32px;
    }
    .article-meta {
      margin-bottom: 16px;
      gap: 10px;
    }
    h1 {
      font-size: clamp(30px, 8vw, 42px);
      letter-spacing: -0.035em;
      margin-bottom: 18px;
    }
    .article-header > p {
      font-size: 14px;
      line-height: 1.7;
    }
    .article-byline,
    .article-tags {
      margin-top: 18px;
    }
    .article-figure {
      padding: 10px;
      transform: none;
      box-shadow: none;
    }
    .article-reading-grid {
      padding-block: 32px 44px;
      gap: 24px;
    }
  }
</style>
