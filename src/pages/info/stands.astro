---
import Layout from '../../layouts/Layout.astro';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import GranadaAccent from '../../components/GranadaAccent.astro';
import PartnerLogo from '../../components/PartnerLogo.astro';
import { partners } from '../../data/sponsors';
import { partnerAnchor } from '../../utils/partner-activities';
import { stands, standCategories } from '../../data/stands';
---

<Layout
  title="Stands"
  description="Descubre los stands de UGR LAN Party: videojuegos, esports y comunidad en la ETSIIT."
>
  <article class="stands-page design-container" data-stands>
    <header class="stands-heading">
      <GranadaAccent id="stands-mosaic" />
      <div>
        <span class="design-eyebrow">La comunidad, de cerca · ULP 2026</span><h1
        >
          Entre partida<br />y <em>partida.</em>
        </h1><p>
          También nos encontramos en los stands. Conoce a quienes formaron parte
          de la última edición.
        </p>
      </div>
      <a class="design-button" href="/info/mapa/"
        >Explorar el mapa <ArrowUpRight /></a
      >
    </header>
    <section aria-labelledby="stands-title">
      <div class="stands-toolbar">
        <h2 id="stands-title">Los stands de la ULP <span>07</span></h2><p>
          Archivo de la edición de 2026
        </p>
      </div>
      <div
        class="stand-filters"
        aria-label="Filtrar stands"
        hidden
        data-stand-filters
      >
        {
          standCategories.map((category) => (
            <button
              type="button"
              data-stand-filter={category}
              aria-pressed={category === 'Todos'}
            >
              {category}
            </button>
          ))
        }
      </div>
      <p class="sr-only" role="status" data-stand-status></p>
      <div class="stands-grid">
        {
          stands.map((stand, index) => {
            const partner = partners.find(
              (partner) => partner.name.trim() === stand.partner,
            );
            return (
              <article
                class="stand-card"
                data-stand-card
                data-category={stand.category}
                id={stand.id}
              >
                <div class="stand-art">
                  <span class="stand-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {partner ? (
                    <PartnerLogo
                      partner={partner}
                      surface="light"
                      width={220}
                      height={90}
                    />
                  ) : (
                    <span class="stand-wordmark">{stand.name}</span>
                  )}
                  <span class="stand-edition">ULP / 2026</span>
                </div>
                <div class="stand-copy">
                  <span class="design-eyebrow">{stand.category}</span>
                  <h3>{stand.name}</h3>
                  <p>{stand.description}</p>
                  {partner && (
                    <a href={`/participan/#${partnerAnchor(partner.name)}`}>
                      Ficha y redes <ArrowUpRight />
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
    <aside class="stands-contact">
      <div>
        <h2>¿Tu proyecto en la próxima ULP?</h2><p>
          Cuéntanos qué haces y cómo te gustaría participar.
        </p>
      </div><a
        class="design-button"
        href="mailto:ulp@ugr.es?subject=Stand%20ULP%202027"
        >Hablemos <ArrowUpRight /></a
      >
    </aside>
  </article>
</Layout>
<script>
  import { stands } from '../../data/stands';
  document.querySelectorAll<HTMLElement>('[data-stands]').forEach((root) => {
    root.querySelector<HTMLElement>('[data-stand-filters]')!.hidden = false;
    const cards = Array.from(
      root.querySelectorAll<HTMLElement>('[data-stand-card]'),
    );
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-stand-filter]'),
    );
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const category = button.dataset.standFilter!;
        if (
          category !== 'Todos' &&
          !stands.some((stand) => stand.category === category)
        )
          return;
        let count = 0;
        cards.forEach((card) => {
          card.hidden =
            category !== 'Todos' && card.dataset.category !== category;
          if (!card.hidden) count++;
        });
        buttons.forEach((item) =>
          item.setAttribute('aria-pressed', String(item === button)),
        );
        root.querySelector('[data-stand-status]')!.textContent =
          `${count} stands · ${category}`;
      }),
    );
  });
</script>
<style>
  [hidden] {
    display: none !important;
  }
  .stands-page {
    padding-block: 133px 60px;
  }
  .stands-heading {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    padding-block: 22px 46px;
    border-bottom: 1px solid var(--line);
  }
  .stands-heading > div,
  .stands-heading > a {
    position: relative;
  }
  h1 {
    font-size: clamp(42px, 7vw, 82px);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.065em;
    margin: 20px 0;
  }
  h1 em {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.05em;
  }
  .stands-heading p {
    max-width: 510px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.8;
  }
  .stands-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-block: 30px 18px;
  }
  .stands-toolbar h2 {
    font-size: 23px;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .stands-toolbar h2 span {
    margin-left: 10px;
    font:
      11px ui-monospace,
      monospace;
    color: var(--muted);
  }
  .stands-toolbar p {
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted);
  }
  .stand-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 22px;
  }
  .stand-filters button {
    padding: 9px 15px;
    border-radius: 14px;
    border: 1px solid var(--line);
    min-height: 44px;
    font-size: 11px;
    color: var(--ink);
  }
  .stand-filters button[aria-pressed='true'] {
    color: var(--paper);
    background: var(--ink);
  }
  .stands-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .stand-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 17px;
    overflow: hidden;
    background: var(--surface);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
    scroll-margin-top: 110px;
  }
  .stand-card:hover,
  .stand-card:focus-within {
    border-color: var(--muted);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .stand-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 166px;
    padding: 30px;
    background: #f5f0e6;
    color: #004465;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .stand-art :global(.partner-logo-frame) {
    width: 100%;
    max-width: 220px;
    height: 76px;
  }
  .stand-number {
    position: absolute;
    left: 13px;
    top: 11px;
    font:
      10px ui-monospace,
      monospace;
    opacity: 0.7;
  }
  .stand-edition {
    position: absolute;
    bottom: 11px;
    right: 13px;
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }
  .stand-wordmark {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.05em;
    text-align: center;
  }
  .stand-copy {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .stand-copy .design-eyebrow {
    font-size: 9px;
  }
  .stand-copy h3 {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin: 9px 0;
  }
  .stand-copy p {
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .stand-copy a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    margin-top: auto;
    font-size: 11px;
    font-weight: 600;
  }
  .stands-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 36px;
    padding-block: 30px;
    border-block: 1px solid var(--line);
  }
  .stands-contact h2 {
    font-size: 23px;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .stands-contact p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.8;
  }
  @media (max-width: 900px) {
    .stands-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .stands-page {
      padding-block: 113px 36px;
    }
    .stands-heading {
      display: block;
      padding-block: 12px 28px;
    }
    .stands-heading > a {
      margin-top: 20px;
    }
    .stands-heading p {
      font-size: 12px;
    }
    .stands-toolbar {
      align-items: start;
      flex-direction: column;
      gap: 7px;
    }
    .stands-toolbar h2 {
      font-size: 22px;
    }
    .stands-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .stand-art {
      height: 142px;
    }
    .stand-copy {
      padding: 19px;
    }
    .stands-contact {
      align-items: start;
      flex-direction: column;
      margin-top: 26px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stand-card {
      transition: none;
    }
  }
</style>
