---
import FaqPage from '../../../components/FaqPage.astro';
import { faqs } from '../../../data/faqs';
export function getStaticPaths() {
  return Array.from(
    { length: Math.max(0, Math.ceil(faqs.length / 6) - 1) },
    (_, index) => ({
      params: { page: String(index + 2) },
      props: { page: index + 2 },
    }),
  );
}
const { page } = Astro.props;
---

<FaqPage page={page} />
