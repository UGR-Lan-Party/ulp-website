---
import ProgramTable from '../../components/ProgramTable.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import Layout from '../../layouts/Layout.astro';
import OfficialProgram from '../../components/OfficialProgram.astro';
---

<Layout
  description="Consulta la agenda de ULP 2026 y descubre el programa oficial."
  title="Horarios"
>
  <Breadcrumb>
    <Fragment slot="title">Horarios</Fragment>
  </Breadcrumb>
  <ProgramTable />
  <OfficialProgram />
</Layout>

<script>
  // Keep previously shared map links working after moving the explorer.
  if (
    new URLSearchParams(location.search).has('plano') ||
    location.hash === '#plano'
  ) {
    const target = new URL('/info/mapa/', location.origin);
    target.search = location.search;
    target.hash = '#plano';
    location.replace(target.href);
  }
</script>
