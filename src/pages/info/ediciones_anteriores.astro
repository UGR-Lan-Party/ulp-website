---
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import InitialSurveyComparison from '../../components/InitialSurveyComparison.astro';
import EditionTimeline from '../../components/EditionTimeline.astro';
import EditionArchive from '../../components/EditionArchive.astro';
import EditionShirts from '../../components/EditionShirts.astro';
import EditionPosters from '../../components/EditionPosters.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { pastEditions } from '../../data/past-editions';
---

<Layout
  title="Ediciones anteriores"
  description="De la primera LAN en 2016 a ULP 2026: fotografías e historias de cada edición."
>
  <Breadcrumb current="Ediciones anteriores">
    <Fragment slot="title">Nuestra historia</Fragment>
    <Fragment slot="texto">
      De un proyecto de clase a llenar la ETSIIT. Recorre las ediciones,
      encuentra tu foto y revive todo lo que nos trajo hasta aquí.
    </Fragment>
  </Breadcrumb>
  <div class="design-container archive-shell">
    <EditionTimeline />
    <nav class="archive-collection-links" aria-label="Colecciones del archivo">
      <a href="#camisetas">Camisetas 3D ↗</a><a href="#carteles">Carteles ↗</a>
    </nav>
    <section
      id="edicion-2026"
      class="archive-latest"
      aria-labelledby="latest-edition-title"
    >
      <div class="archive-latest-poster">
        <ResponsiveImage
          src="/assets/blog/Cartel ULP 2026.png"
          alt="Cartel de ULP 2026"
          sizes="(max-width: 700px) 80vw, 30vw"
        />
      </div>
      <div class="archive-latest-copy">
        <span class="design-eyebrow">08 / Última edición celebrada</span>
        <h2 id="latest-edition-title">ULP <span>2026</span></h2>
        <p class="archive-date">20 y 21 de marzo · ETSIIT, Granada</p>
        <details class="latest-description" data-edition-description>
          <summary
            ><span class="description-closed">Leer descripción</span><span
              class="description-open">Ocultar descripción</span
            ><span aria-hidden="true">⌄</span></summary
          >
          <div>
            <p>
              Dos días para encontrarnos alrededor de los videojuegos y la
              tecnología. El programa de la octava edición queda aquí para
              volver a consultarlo.
            </p>
          </div>
        </details>
        <a href="/horarios" class="design-button"
          >Ver programa de 2026 <span aria-hidden="true"><ArrowUpRight /></span
          ></a
        >
      </div>
    </section>
    {
      pastEditions.map((edition, index) => (
        <EditionArchive edition={edition} reversed={index % 2 === 1} />
      ))
    }
    <div id="camisetas" class="archive-collection"><EditionShirts /></div>
    <InitialSurveyComparison />
    <div id="carteles" class="archive-collection"><EditionPosters /></div>
    <div class="archive-ending">
      <a href="/" class="design-link"
        >Volver a ULP 2027 <span aria-hidden="true"><ArrowUpRight /></span></a
      >
    </div>
  </div>
</Layout>
<script>
  import '../../scripts/edition-descriptions';
</script>
<style>
  .archive-collection {
    scroll-margin-top: 100px;
    min-width: 0;
  }
  .archive-collection-links {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 10px;
    color: var(--muted);
    margin-block: 14px 4px;
  }
  .archive-collection-links a {
    text-underline-offset: 4px;
  }
  .archive-collection-links a:hover {
    text-decoration: underline;
  }
  .latest-description p {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 430px;
  }
  .latest-description summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    padding-block: 8px;
    font-size: 12px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .description-open,
  [open] .description-closed {
    display: none;
  }
  [open] .description-open {
    display: inline;
  }
  @media (min-width: 801px) {
    .latest-description summary {
      display: none;
    }
  }
  @media (max-width: 800px) {
    .latest-description p {
      font-size: 13px;
      line-height: 1.65;
    }
  }

  .archive-shell {
    padding-block: 32px 70px;
  }
  .archive-latest {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(30px, 6vw, 90px);
    padding-block: 16px 42px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 110px;
  }
  .archive-latest-poster {
    padding: 20px;
    border-radius: 14px;
    background: #004465;
    transform: rotate(-3deg);
  }
  .archive-latest-poster :global(img) {
    width: auto;
    max-width: 100%;
    height: 330px;
    object-fit: contain;
    margin-inline: auto;
    border-radius: 4px;
  }
  .archive-latest h2 {
    font-size: clamp(50px, 6.7vw, 90px);
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 1;
    margin-block: 24px;
  }
  .archive-latest h2 span {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    color: transparent;
    -webkit-text-stroke: 1px var(--ink);
  }
  .archive-latest-copy > p {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 430px;
  }
  .archive-latest-copy > .archive-date {
    font:
      11px/1.8 ui-monospace,
      monospace;
    margin-bottom: 18px;
    color: var(--ink);
  }
  .archive-latest .design-button {
    margin-top: 28px;
  }
  .archive-ending {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 40px;
  }
  .archive-ending .design-eyebrow {
    font-size: 9px;
  }
  @media (max-width: 700px) {
    .archive-latest {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .archive-latest-poster {
      max-width: 270px;
      margin-inline: auto;
    }
    .archive-latest-poster :global(img) {
      height: 280px;
    }
    .archive-latest h2 span {
      display: inline;
    }
    .archive-ending {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
