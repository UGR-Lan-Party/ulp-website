---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import EditionArchive from '../../components/EditionArchive.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { pastEditions } from '../../data/past-editions';
---

<Layout
  title="Ediciones anteriores"
  description="De la primera LAN en 2016 a ULP 2026: fotografías e historias de cada edición."
>
  <Breadcrumb current="Ediciones anteriores">
    <Fragment slot="title">
      Ocho ediciones.<br />Mil partidas pendientes.
    </Fragment>
    <Fragment slot="texto">
      De un proyecto de clase a llenar la ETSIIT. Recorre las ediciones,
      encuentra tu foto y revive las partidas que nos trajeron hasta aquí.
    </Fragment>
  </Breadcrumb>
  <div class="design-container archive-shell">
    <nav class="archive-years" aria-label="Ir a una edición">
      {
        [2026, ...pastEditions.map((edition) => edition.year)].map((year) => (
          <a href={`#edicion-${year}`}>{year}</a>
        ))
      }
    </nav>
    <section
      id="edicion-2026"
      class="archive-latest"
      aria-labelledby="latest-edition-title"
    >
      <div class="archive-latest-poster">
        <ResponsiveImage
          src="/assets/blog/Cartel ULP 2026.png"
          alt="Cartel de ULP 2026"
          sizes="(max-width: 700px) 80vw, 30vw"
        />
      </div>
      <div class="archive-latest-copy">
        <span class="design-eyebrow">08 / Última edición celebrada</span>
        <h2 id="latest-edition-title">ULP <span>2026.</span></h2>
        <p class="archive-date">20 y 21 de marzo · ETSIIT, Granada</p>
        <p>
          Dos días para encontrarnos alrededor de los videojuegos y la
          tecnología. El programa de la octava edición queda aquí para volver a
          consultarlo.
        </p>
        <a href="/horarios" class="design-button"
          >Ver programa de 2026 <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    {
      pastEditions.map((edition, index) => (
        <EditionArchive edition={edition} reversed={index % 2 === 1} />
      ))
    }
    <div class="archive-ending">
      <span class="design-eyebrow"
        >La siguiente página la escribimos juntos</span
      >
      <a href="/" class="design-link"
        >Volver a ULP 2027 <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</Layout>
<style>
  .archive-shell {
    padding-block: 32px 70px;
  }
  .archive-years {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .archive-years a {
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 10px 18px;
    font:
      11px ui-monospace,
      monospace;
    transition:
      background 200ms ease,
      color 200ms ease;
  }
  .archive-years a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .archive-latest {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(30px, 6vw, 90px);
    padding-block: 16px 42px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 110px;
  }
  .archive-latest-poster {
    padding: 20px;
    border-radius: 14px;
    background: #004465;
    transform: rotate(-3deg);
  }
  .archive-latest-poster :global(img) {
    width: auto;
    max-width: 100%;
    height: 330px;
    object-fit: contain;
    margin-inline: auto;
    border-radius: 4px;
  }
  .archive-latest h2 {
    font-size: clamp(50px, 6.7vw, 90px);
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 1;
    margin-block: 24px;
  }
  .archive-latest h2 span {
    display: block;
  }
  .archive-latest-copy > p {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 430px;
  }
  .archive-latest-copy > .archive-date {
    font:
      11px/1.8 ui-monospace,
      monospace;
    margin-bottom: 18px;
    color: var(--ink);
  }
  .archive-latest .design-button {
    margin-top: 28px;
  }
  .archive-ending {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 40px;
  }
  .archive-ending .design-eyebrow {
    font-size: 9px;
  }
  @media (max-width: 700px) {
    .archive-latest {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .archive-latest-poster {
      max-width: 270px;
      margin-inline: auto;
    }
    .archive-latest-poster :global(img) {
      height: 280px;
    }
    .archive-latest h2 span {
      display: inline;
    }
    .archive-ending {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
