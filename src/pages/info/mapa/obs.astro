---
import '../../../styles/tailwind.css';
import '../../../styles/proposal.css';
import '../../../styles/reduced-motion.css';
import VenueMap from '../../../components/VenueMap.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Plano ETSIIT · ULP</title>
  </head>
  <body>
    <main
      data-map-page
      data-obs-map
      aria-label="Plano de la ETSIIT a pantalla completa"
    >
      <VenueMap standalone />
    </main>
    <div class="obs-map-tools" hidden data-obs-tools>
      <button type="button" data-obs-controls aria-expanded="false"
        >Mostrar controles</button
      >
      <button type="button" data-obs-fullscreen>Pantalla completa</button>
      <a href="/info/mapa/">Volver al mapa</a>
    </div>
    <script>
      import { createVenueMap } from '../../../scripts/venue-map';
      const root = document.querySelector<HTMLElement>('[data-obs-map]')!;
      createVenueMap(root, () => {});
      const config = document.createElement('aside');
      config.className = 'obs-map-config';
      config.setAttribute('aria-label', 'Controles del plano');
      for (const selector of [
        '.venue-routes',
        '.venue-selectors',
        '.campus-version-switch',
      ])
        config.append(root.querySelector(selector)!);
      root.querySelector('.venue-map-column')!.append(config);
      const tools = document.querySelector<HTMLElement>('[data-obs-tools]')!;
      tools.hidden =
        new URLSearchParams(location.search).get('controles') !== '1';
      if (!tools.hidden) {
        tools.prepend(root.querySelector('[data-venue-parent-back]')!);
        const syncToolbar = () =>
          root.style.setProperty(
            '--obs-tools-offset',
            `${Math.ceil(tools.getBoundingClientRect().bottom) + 16}px`,
          );
        new ResizeObserver(syncToolbar).observe(tools);
        syncToolbar();
      }
      const toggle = document.querySelector<HTMLButtonElement>(
        '[data-obs-controls]',
      )!;
      toggle.addEventListener('click', () => {
        const open = root.classList.toggle('show-controls');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Ocultar controles' : 'Mostrar controles';
      });
      document
        .querySelector('[data-obs-fullscreen]')!
        .addEventListener('click', async () => {
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await document.documentElement.requestFullscreen();
          } catch {
            /* The standalone page already fills the browser viewport. */
          }
        });
    </script>
    <style is:global>
      html:has([data-obs-map][data-map-page]),
      body:has([data-obs-map][data-map-page]) {
        width: 100%;
        height: 100%;
        overflow: hidden;
        margin: 0;
      }
      [data-obs-map][data-map-page] {
        position: fixed;
        inset: 0;
        background: var(--paper);
      }
      [data-obs-map][data-map-page] .venue-explorer,
      [data-obs-map][data-map-page] .venue-map-column,
      [data-obs-map][data-map-page] .venue-canvas {
        height: 100%;
        padding: 0;
        margin: 0;
      }
      [data-obs-map][data-map-page] .venue-map-column > :not(.venue-canvas),
      [data-obs-map][data-map-page] .venue-explorer > :not(.venue-map-column) {
        display: none !important;
      }
      [data-obs-map][data-map-page] .venue-drawing {
        width: 100%;
        height: 100%;
        max-height: none;
        touch-action: none;
      }
      [data-obs-map][data-map-page] .venue-controls,
      [data-obs-map][data-map-page] .venue-zoom,
      [data-obs-map][data-map-page] .venue-room-capacity {
        visibility: hidden;
      }
      .obs-map-tools {
        position: fixed;
        right: 16px;
        top: 16px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        max-width: calc(100% - 32px);
      }
      .obs-map-tools[hidden] {
        display: none;
      }
      .obs-map-tools button,
      .obs-map-tools a {
        font:
          600 11px 'Inter Variable',
          sans-serif;
        padding: 10px 13px;
        min-height: 40px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--paper);
        color: var(--ink);
        cursor: pointer;
        text-decoration: none;
      }

      [data-obs-map][data-map-page].show-controls
        .venue-map-column
        > .obs-map-config {
        display: grid !important;
        position: fixed;
        top: var(--obs-tools-offset, 72px);
        left: 16px;
        z-index: 8;
        width: min(480px, calc(100% - 32px));
        max-height: calc(100dvh - var(--obs-tools-offset, 72px) - 80px);
        overflow: auto;
        gap: 16px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: var(--paper);
        box-shadow: 0 12px 40px #00446512;
      }
      [data-obs-map][data-map-page] .obs-map-config > :not([hidden]) {
        margin: 0;
      }
      [data-obs-map][data-map-page].show-controls .venue-controls,
      [data-obs-map][data-map-page].show-controls .venue-zoom {
        visibility: visible;
        top: auto;
        bottom: 20px;
      }
      [data-obs-map][data-map-page].show-controls
        .venue-top-actions
        .venue-zoom {
        position: fixed;
        right: 16px;
      }
      [data-obs-map][data-map-page].show-controls .venue-controls {
        position: fixed;
        right: 140px;
        margin: 0;
        z-index: 7;
      }
      [data-obs-map][data-map-page].show-controls .venue-controls button {
        min-height: 44px;
      }
      @media (max-width: 600px) {
        [data-obs-map][data-map-page].show-controls
          .venue-map-column
          > .obs-map-config {
          top: var(--obs-tools-offset, 112px);
          max-height: calc(100dvh - var(--obs-tools-offset, 112px) - 80px);
        }
      }
    </style>
  </body>
</html>
