---
import HomeContourBackground from '../../components/HomeContourBackground.astro';
import Team from '../../components/Team.astro';
import Aboutsection from '../../components/Aboutsection.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import Layout from '../../layouts/Layout.astro';
import CTAsection from '../../components/CTAsection.astro';
import CommunityAlbum from '../../components/CommunityAlbum.astro';
import Contributors from '../../components/Contributors.astro';
import Twitch from '../../components/Twitch.astro';
---

<Layout
  description="La UGR LAN Party es un evento de eSports organizado por profesores y estudiantes de la Escuela Técnica Superior de Ingenierías Informática y de Telecomunicación."
  title="Sobre Nosotros"
>
  <div class="about-intro-pattern">
    <HomeContourBackground />
    <Breadcrumb>
      <Fragment slot="title">¿Quiénes somos?</Fragment>
    </Breadcrumb>
  </div>
  <Aboutsection />
  <CTAsection />
  <CommunityAlbum />
  <Twitch />
  <Team />
  <Contributors />
</Layout>

<style>
  .about-intro-pattern {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
</style>
