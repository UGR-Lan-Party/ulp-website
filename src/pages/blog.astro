---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPublishedNews } from '../utils/news';
const [featured, ...stories] = await getPublishedNews();
---

<Layout
  title="Noticias"
  description="Noticias, colaboraciones e historias de la comunidad UGR LAN Party"
>
  <section class="design-container news-index" aria-labelledby="news-title">
    <header class="news-board-heading">
      <nav aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span><span
          aria-current="page">Noticias</span>
      </nav>
      <div class="news-board-intro">
        <div>
          <span class="design-eyebrow">Historias de nuestra comunidad</span><h1
            id="news-title"
          >
            El tablón de la ULP
          </h1>
        </div><p>
          Lo que pasa antes, durante y después de encender las pantallas.
        </p>
      </div>
    </header>
    {
      featured ? (
        <div class="news-editorial-grid">
          <div class="news-cover">
            <>
              <div class="news-section-label">
                <>
                  <span>La última historia</span>
                  <span>01 / EN PORTADA</span>
                </>
              </div>
              <NewsCard entry={featured} featured />
            </>
          </div>
          {stories.length > 0 && (
            <section class="news-archive" aria-labelledby="news-archive-title">
              <div class="news-section-label">
                <h2 id="news-archive-title">Más historias</h2>
                <span>EL ARCHIVO</span>
              </div>
              <div class="news-archive-list">
                {stories.map((entry) => (
                  <NewsCard entry={entry} compact />
                ))}
              </div>
            </section>
          )}
        </div>
      ) : (
        <p>Todavía no hay noticias publicadas.</p>
      )
    }
  </section>
</Layout>
<style>
  .news-index {
    padding-block: 125px 64px;
  }
  .news-board-heading {
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .news-board-heading nav {
    display: flex;
    gap: 10px;
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 26px;
  }
  .news-board-heading nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .news-board-intro {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
  }
  .design-eyebrow {
    font-size: 9px;
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(28px, 5vw, 68px);
    font-weight: 750;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }
  .news-board-intro p {
    max-width: 240px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }
  .news-editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .news-section-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    min-height: 20px;
    font-size: 12px;
    font-weight: 600;
  }
  .news-section-label > span:last-child {
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .news-archive-list {
    display: grid;
    gap: 16px;
  }
  @media (max-width: 950px) {
    .news-editorial-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 22px;
    }
    .news-board-intro p {
      max-width: 200px;
    }
  }
  @media (max-width: 700px) {
    .news-index {
      padding-block: 106px 36px;
    }
    .news-board-heading {
      padding-bottom: 18px;
      margin-bottom: 20px;
    }
    .news-board-heading nav {
      margin-bottom: 18px;
    }
    .news-board-intro {
      display: block;
    }
    .design-eyebrow {
      font-size: 8px;
      margin-bottom: 10px;
    }
    h1 {
      font-size: clamp(25px, 7.1vw, 46px);
      white-space: nowrap;
    }
    .news-board-intro p {
      max-width: 320px;
      font-size: 12px;
      margin-top: 12px;
    }
    .news-editorial-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .news-section-label {
      margin-bottom: 12px;
      font-size: 11px;
    }
    .news-archive-list {
      gap: 12px;
    }
  }
</style>
