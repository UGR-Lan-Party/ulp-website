---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPublishedNews } from '../utils/news';
const [featured, ...stories] = await getPublishedNews();
---

<Layout
  title="Noticias"
  description="Noticias, colaboraciones e historias de la comunidad UGR LAN Party"
>
  <Breadcrumb current="Noticias">
    <Fragment slot="title">
      <span class="news-board-title">El tablón de la ULP</span>
    </Fragment><Fragment slot="texto">
      Lo que pasa antes, durante y después de encender las pantallas. Noticias y
      recuerdos de nuestra comunidad.
    </Fragment>
  </Breadcrumb>
  <section class="design-container news-index">
    {
      featured ? (
        <>
          <div class="news-section-label">
            <span class="design-eyebrow">La última historia</span>
            <span>UGR LAN PARTY / NOTICIAS</span>
          </div>
          <NewsCard entry={featured} featured />
        </>
      ) : (
        <p>Todavía no hay noticias publicadas.</p>
      )
    }
    {
      stories.length > 0 && (
        <div class="news-more">
          <div class="design-section-header">
            <div>
              <span class="design-eyebrow">Del archivo al campus</span>
              <h2 class="design-heading">Más historias.</h2>
            </div>
            <p>Cada edición deja algo que contar.</p>
          </div>
          <div class="design-grid">
            {stories.map((entry) => (
              <NewsCard entry={entry} />
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>
<style>
  :global(.page-intro:has(.news-board-title) h1) {
    max-width: 100%;
    font-size: clamp(28px, 7.7vw, 88px);
  }
  .news-board-title {
    white-space: nowrap;
    letter-spacing: -0.045em;
  }
  .news-index {
    padding-block: 45px 90px;
  }
  .news-section-label {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }
  .news-section-label > span:last-child {
    font:
      8px ui-monospace,
      monospace;
    opacity: 0.5;
  }
  .news-more {
    padding-top: 85px;
  }
  .news-more .design-heading {
    font-size: clamp(32px, 4.5vw, 58px);
    margin-top: 18px;
  }
  .news-more .design-section-header > p {
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .news-section-label > span:last-child {
      display: none;
    }
    .news-more {
      padding-top: 55px;
    }
  }
  @media (max-width: 700px) {
    .news-more {
      padding-top: 40px;
    }
    .news-index {
      padding-block: 28px 50px;
    }
  }
</style>
