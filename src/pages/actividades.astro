---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import ActivityTile from '../components/ActivityTile.astro';
import { Competitions } from '../data/competitions-data';
const sections = [
  {
    key: 'competiciones',
    tag: 'competicion',
    title: 'Competiciones',
    description: 'Tu equipo, tu estrategia y una partida que recordar.',
  },
  {
    key: 'retos',
    tag: 'reto',
    title: 'Retos',
    description: 'Supera tu marca. Prueba algo nuevo. Vuelve a intentarlo.',
  },
  {
    key: 'actividades',
    tag: 'actividad',
    title: 'Actividades',
    description: 'Descubre, comparte y juega a tu ritmo.',
  },
];
---

<Layout
  description="Competiciones, retos y actividades de UGR LAN Party"
  title="Actividades"
>
  <Breadcrumb current="Actividades">
    <Fragment slot="title">Encuentra<br />tu partida.</Fragment><Fragment
      slot="texto"
    >
      Competiciones, retos y actividades para todas las formas de jugar. Explora
      el catálogo de 2026 mientras preparamos la próxima edición.
    </Fragment>
  </Breadcrumb>
  <div class="design-container catalog-navigation">
    <nav aria-label="Tipos de actividad">
      {
        sections.map((section) => (
          <a href={`#${section.key}`}>
            {section.title}
            <span>
              {String(
                Competitions.filter((game) => game.tag === section.tag).length,
              ).padStart(2, '0')}
            </span>
          </a>
        ))
      }
    </nav><a class="design-link" href="/info/horarios"
      >Ver agenda <span aria-hidden="true">↗</span></a
    >
  </div>
  {
    sections.map((section, index) => (
      <section
        id={section.key}
        class="design-section design-container catalog-section"
      >
        <>
          <div class="design-section-header" data-reveal>
            <>
              <div>
                <>
                  <span class="design-eyebrow">
                    {String(index + 1).padStart(2, '0')} / Elige cómo jugar
                  </span>
                  <h2 class="design-heading">{section.title}</h2>
                </>
              </div>
              <p>{section.description}</p>
            </>
          </div>
          <div class="design-grid">
            {Competitions.filter((game) => game.tag === section.tag).map(
              (game) => (
                <ActivityTile id={game.id} />
              ),
            )}
          </div>
        </>
      </section>
    ))
  }
  <div class="design-container team-callout" data-reveal>
    <div>
      <span class="design-eyebrow">El siguiente compañero está aquí</span><h2>
        ¿Te falta equipo?
      </h2><p>Encuentra gente con la que compartir la partida.</p>
    </div><a
      class="design-button"
      href="https://docs.google.com/spreadsheets/d/1oL8jkQn1oGXnT-qkjcIapFpGi3SI0G0JrvIFm6hghkk/edit?usp=sharing"
      >Buscar equipo <span aria-hidden="true">↗</span></a
    >
  </div>
</Layout>
<style>
  .catalog-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 25px;
    border-bottom: 1px solid var(--line);
  }
  .catalog-navigation nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .catalog-navigation nav a {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 15px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 12px;
    transition:
      background 200ms ease,
      color 200ms ease;
  }
  .catalog-navigation nav a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .catalog-navigation nav span {
    font:
      9px ui-monospace,
      monospace;
    opacity: 0.6;
  }
  .catalog-section {
    padding-block: 65px;
  }
  .catalog-section .design-section-header > p {
    max-width: 280px;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
  }
  .team-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 45px;
    margin-block: 20px 80px;
    border-block: 1px solid var(--line);
  }
  .team-callout h2 {
    font-size: 38px;
    font-weight: 750;
    margin: 14px 0 10px;
  }
  .team-callout p {
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 700px) {
    .catalog-navigation {
      align-items: start;
      flex-direction: column;
    }
    .catalog-navigation nav {
      gap: 6px;
    }
    .catalog-navigation nav a {
      padding: 9px 11px;
      font-size: 10px;
    }
    .team-callout {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
