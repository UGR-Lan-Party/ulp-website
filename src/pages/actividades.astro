---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import ActivityTile from '../components/ActivityTile.astro';
import { getActivitiesByTag } from '../utils/activity-navigation';
const teamFinderUrl =
  'https://docs.google.com/spreadsheets/d/1oL8jkQn1oGXnT-qkjcIapFpGi3SI0G0JrvIFm6hghkk/edit?usp=sharing';
const sections = [
  {
    key: 'competiciones',
    tag: 'competicion',
    title: 'Competiciones',
    description: 'Tu equipo, tu estrategia y una partida que recordar.',
  },
  {
    key: 'retos',
    tag: 'reto',
    title: 'Retos',
    description: 'Supera tu marca. Prueba algo nuevo. Vuelve a intentarlo.',
  },
  {
    key: 'actividades',
    tag: 'actividad',
    title: 'Actividades',
    description: 'Descubre, comparte y juega a tu ritmo.',
  },
].map((section) => ({ ...section, games: getActivitiesByTag(section.tag) }));
---

<Layout
  description="Competiciones, retos y actividades de UGR LAN Party"
  title="Actividades"
>
  <Breadcrumb current="Actividades">
    <Fragment slot="title">
      <span class="catalog-title">Encuentra tu partida</span>
    </Fragment><Fragment slot="texto">
      Competiciones, retos y actividades para todas las formas de jugar. Explora
      el catálogo de 2026 mientras preparamos la próxima edición.
    </Fragment>
  </Breadcrumb>
  <div class="design-container catalog-navigation">
    <nav aria-label="Tipos de actividad">
      {
        sections.map((section) => (
          <a href={`#${section.key}`}>
            {section.title}
            <span>{String(section.games.length).padStart(2, '0')}</span>
          </a>
        ))
      }
    </nav><a class="design-link" href="/info/horarios"
      >Ver agenda <span aria-hidden="true"><ArrowUpRight /></span></a
    >
  </div>
  <div class="design-container">
    <div class="team-callout" data-reveal data-spotlight>
      <svg class="team-mosaic" aria-hidden="true"
        ><defs
          ><pattern
            id="team-hexagons"
            width="56"
            height="96"
            patternUnits="userSpaceOnUse"
            ><path
              d="M28 4 52.25 18V46L28 60 3.75 46V18ZM0 52 24.25 66V94L0 108 -24.25 94V66ZM56 52 80.25 66V94L56 108 31.75 94V66ZM0 -44 24.25 -30V-2L0 12 -24.25 -2V-30ZM56 -44 80.25 -30V-2L56 12 31.75 -2V-30Z"
              fill="currentColor"></path></pattern
          ></defs
        ><rect width="100%" height="100%" fill="url(#team-hexagons)"
        ></rect></svg
      >
      <div>
        <span class="design-eyebrow"
          >Encuentra gente con la que compartir la partida</span
        ><h2>¿Te falta equipo?</h2><p>
          Tenemos un Excel compartido para que encuentres equipo.
        </p>
      </div><a
        class="design-button"
        href={teamFinderUrl}
        target="_blank"
        rel="noopener noreferrer"
        >Buscar equipo <span aria-hidden="true"><ArrowUpRight /></span></a
      >
    </div>
  </div>
  {
    sections.map((section, index) => (
      <section
        id={section.key}
        class="design-section design-container catalog-section"
      >
        <div class="design-section-header" data-reveal>
          <div>
            <span class="design-eyebrow">
              {String(index + 1).padStart(2, '0')} / Elige cómo jugar
            </span>
            <h2 class="design-heading">{section.title}</h2>
          </div>
          <p>{section.description}</p>
        </div>
        <div class="design-grid">
          {section.games.map((game) => (
            <ActivityTile id={game.id} />
          ))}
        </div>
      </section>
    ))
  }
  <div class="design-container team-intro">
    <span>¿Te falta equipo?</span><a
      href={teamFinderUrl}
      target="_blank"
      rel="noopener noreferrer"
      >Encuentra compañeros de partida <span aria-hidden="true"
        ><ArrowUpRight /></span
      ></a
    >
  </div>
</Layout>
<style>
  .catalog-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 25px;
    border-bottom: 1px solid var(--line);
  }
  .catalog-navigation nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .catalog-navigation nav a {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 15px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 12px;
    transition:
      background 200ms ease,
      color 200ms ease;
  }
  .catalog-navigation nav a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .catalog-navigation nav span {
    font:
      9px ui-monospace,
      monospace;
    opacity: 0.6;
  }
  .catalog-section {
    scroll-margin-top: 90px;
    padding-block: 65px;
  }
  .catalog-section .design-section-header > p {
    max-width: 280px;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
  }
  .team-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 32px;
    margin-block: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .team-callout h2 {
    font-size: 38px;
    font-weight: 750;
    margin: 14px 0 10px;
  }
  .team-callout p {
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 700px) {
    .catalog-navigation {
      align-items: start;
      flex-direction: column;
    }
    .catalog-navigation nav {
      gap: 6px;
    }
    .catalog-navigation nav a {
      padding: 9px 11px;
      font-size: 10px;
    }
    .team-callout {
      align-items: start;
      flex-direction: column;
    }
  }
  .team-intro {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding-top: 18px;
    margin-bottom: 48px;
    font-size: 11px;
    color: var(--muted);
  }
  .team-intro a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    padding-block: 10px;
  }
  :global(.page-intro:has(.catalog-title) h1) {
    max-width: 100%;
    font-size: clamp(27px, 6.8vw, 88px);
  }
  :global(.page-intro:has(.catalog-title) > .design-container > p) {
    max-width: 820px;
  }
  .catalog-title {
    white-space: nowrap;
    letter-spacing: -0.045em;
  }
  .team-callout {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgb(245 240 230 / 0.2);
    border-radius: 22px;
    padding: clamp(24px, 4vw, 40px);
    margin-block: 24px 0;
    background:
      radial-gradient(
        400px circle at var(--pointer-x, 20%) var(--pointer-y, 50%),
        rgb(0 100 113 / 0.6),
        transparent
      ),
      #062d43;
    color: #f5f0e6;
  }
  .team-callout .design-eyebrow,
  .team-callout p {
    color: rgb(245 240 230 / 0.75);
  }
  .team-callout .design-button {
    background: #f5f0e6;
    color: #004465;
    flex-shrink: 0;
  }
  .team-mosaic {
    position: absolute;
    z-index: -1;
    inset: 0 0 0 auto;
    width: 60%;
    height: 100%;
    opacity: 0.055;
    mask-image: linear-gradient(to right, transparent, black);
    pointer-events: none;
  }
  .team-callout h2 {
    font-size: clamp(28px, 4vw, 42px);
  }
</style>
