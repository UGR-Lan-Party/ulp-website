---
import PartnerStrip from '../components/PartnerStrip.astro';
import ExperienceGrid from '../components/ExperienceGrid.astro';
import About from '../components/Aboutsection.astro';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import CTAsection from '../components/CTAsection.astro';
import Carousel from '../components/CarouselSection.astro';
import TrailerSection from '../components/TrailerSection.astro';
---

<Layout
  description="La UGR LAN Party es un evento de eSports organizado por profesores y estudiantes de la Escuela Técnica Superior de Ingenierías Informática y de Telecomunicación de la Universidad de Granada."
  title="Inicio"
>
  <Hero />
  <PartnerStrip />
  <ExperienceGrid />
  <About />
  <TrailerSection />
  <div class="design-container gallery-heading" data-reveal>
    <span class="design-eyebrow">04 / Nuestra memoria compartida</span><h2
      class="design-heading"
    >
      Granada, vista desde la ULP.
    </h2>
  </div>
  <Carousel albumId="72177720328590176" userId="195749897@N03" />
  <Faq />
  <CTAsection />
</Layout>
<style>
  .gallery-heading {
    padding-top: 40px;
  }
  .gallery-heading .design-eyebrow {
    margin-bottom: 20px;
  }
</style>
