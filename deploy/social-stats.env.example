# Instagram, Facebook and YouTube can read public profile counters without keys.
# Twitch falls back to the public DecAPI counter; Discord uses its public invite.
# X falls back to FxTwitter and TikTok to TikWM (public third-party services).
# All credentials below are optional alternatives.
# Server-only credentials. Never use PUBLIC_ variables for these values.
# Copy to /home/ballenita/ulp-prod/.env.social-stats; keep it out of Git.
# Discord uses the public invite's approximate member count, without a token.

# X: bearer token with read access to the ULP account's public metrics.
SOCIAL_X_BEARER_TOKEN=

# Instagram: professional ULP account with Instagram Login.
SOCIAL_INSTAGRAM_USER_ID=
SOCIAL_INSTAGRAM_ACCESS_TOKEN=

# Meta: an API version supported by your Meta application (e.g. vNN.0).
SOCIAL_META_GRAPH_VERSION=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_FACEBOOK_ACCESS_TOKEN=

# Twitch: user access token for ULP; use moderator:read:followers scope.
SOCIAL_TWITCH_CLIENT_ID=
SOCIAL_TWITCH_ACCESS_TOKEN=

# TikTok: ULP user token with user.info.stats permission.
SOCIAL_TIKTOK_ACCESS_TOKEN=

# Google: key with YouTube Data API v3 enabled; restricted on the server.
SOCIAL_YOUTUBE_API_KEY=
